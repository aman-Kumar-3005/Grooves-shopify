# Prevent execution of any scripts in the uploads directory
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|cgi|sh|bash)$">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
