NODE_ENV=production
PORT=4000

# Never expose these values in Liquid, JavaScript, or Git.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_SECRET=replace_with_app_client_secret
SHOPIFY_API_VERSION=2026-10

# Store-wide warranty term. Change only if this matches the published policy.
WARRANTY_DAYS=365
