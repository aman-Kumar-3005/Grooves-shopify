NODE_ENV=production
PORT=4000

# Never expose these values in Liquid, JavaScript, or Git.
# Initial fallback only; admin can later change this from the private staff console.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_SECRET=replace_with_app_client_secret
SHOPIFY_API_VERSION=2026-10

# Initial policy defaults; admin can change both later from the staff console.
WARRANTY_DAYS=365
RETURN_WINDOW_DAYS=7
RETURN_WINDOW_BASIS=delivery

# Required for the private staff API. Generate a long random value on the host.
SUPPORT_ADMIN_KEY=replace_with_a_long_random_secret

# Use persistent paths on the production host. Do not use temporary/serverless storage.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Abuse protection for public lookup and request endpoints.
MAX_LOOKUPS_PER_WINDOW=20
RATE_WINDOW_MINUTES=15
