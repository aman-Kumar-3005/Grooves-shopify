{% include 'shogun-content-handler' %}
<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0WJ5V0FW4H"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-0WJ5V0FW4H');
    </script>

  {% comment %}Loads Shogun Analytics. Removing this will disrupt analytics data collection.{% endcomment %}
  <script type="text/javascript" async src="https://na.shgcdn3.com/pixel-collector.js"></script>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {% if template.name == 'index' %}
      <link rel="stylesheet" href="{{ 'grooves.css' | asset_url }}" media="print" onload="this.media='all'">
      <link rel="stylesheet" href="{{ 'theme-grooves-style.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript>
        {{ 'grooves.css' | asset_url | stylesheet_tag }}
        {{ 'theme-grooves-style.css' | asset_url | stylesheet_tag }}
      </noscript>
    {% else %}
      {{ 'grooves.css' | asset_url | stylesheet_tag }}
      {{ 'theme-grooves-style.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {{ 'tr-custom.css' | asset_url | stylesheet_tag }}
    {% if template.name == 'index' %}
      <link rel="stylesheet" href="{{ 'premium-enhancements.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript>{{ 'premium-enhancements.css' | asset_url | stylesheet_tag }}</noscript>
    {% else %}
      {{ 'premium-enhancements.css' | asset_url | stylesheet_tag }}
    {% endif %}
    <style>:root{--g-bg:{{ settings.page_background_color | default:settings.color_palette.background }};--g-text:{{ settings.page_text_color | default:settings.color_palette.foreground }};--g-border:{{ settings.palette_input_border | default:settings.color_palette.color3 }};--g-theme-accent:{{ settings.palette_primary_button_background | default:settings.color_palette.color1 }};--g-theme-button-text:{{ settings.palette_primary_button_text | default:settings.color_palette.background }};--g-accent:var(--g-theme-accent);--grooves-bg:var(--g-bg);--grooves-text:var(--g-text);--grooves-border:var(--g-border);--grooves-accent:var(--g-theme-accent);--g-radius:{{ settings.grooves_radius | default:16 }}px;--tr-accent:var(--g-theme-accent);} html,body,.page-wrapper,.content-for-layout,footer{background-color:var(--g-bg);color:var(--g-text)} .grooves-theme{background:var(--g-bg);color:var(--g-text);--g-button-text:var(--g-theme-button-text)} .grooves-theme .g-header{--g-header-bg:var(--g-bg)!important;--g-header-text:var(--g-text)!important} .grooves-theme .g-hero{--g-accent:var(--g-theme-accent)!important;--g-button-text:var(--g-theme-button-text)!important} .grooves-theme .g-product-card{color:var(--g-text);border-color:var(--g-border)}</style>
    <script src="{{ 'grooves.js' | asset_url }}" type="module"></script>
    <script src="{{ 'premium-enhancements.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  
  {% render 'shogun-head' %}
</head>

  <body data-grooves-confetti="{{ settings.grooves_confetti }}" class="tr-theme grooves-theme page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        /**
         * Sets `--header-height` and `--header-group-height` to measured values before first paint.
         *
         * A few CSS rules position content relative to the header at first paint — a hero sized to
         * the remaining viewport, a transparent header's negative margin. Without a measured value
         * those rules use the `60px` fallback from `sections/header.liquid`, and the content visibly
         * jumps once `header.js` corrects the values after load.
         *
         * Measuring forces layout mid-parse, so it only runs where a consuming rule exists.
         * Callers opt in: the transparent-header branch below, or `snippets/measure-header-heights.liquid`,
         * which any new first-paint consumer must render too.
         *
         * Measures once per page; after load, header.js's ResizeObservers keep the values fresh.
         * The group-height walk mimics calculateHeaderGroupHeight() in utilities.js — keep them
         * in sync.
         */
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            /**
             * A transparent header is absolutely positioned, so the loop above counts its section
             * wrapper as 0px. When a section follows it in the group, header.liquid pushes that
             * section down by the header's height using a margin, which offsetHeight also
             * excludes — so the header's height has to be added back manually.
             */
            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        /**
         * Transparent-header rules consume the measured heights at first paint on every
         * template, so the transparent case opts in globally here instead of per-section.
         */
        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        /**
         * Sets `--top-row-height`, consumed by the header underlays and submenus. Deferred to a
         * rAF so the height read doesn't force layout mid-parse, and scoped to the
         * header, where all consumers live, so the write only invalidates the header subtree.
         * Mimics the `--top-row-height` write in updateHeaderHeights() in utilities.js
         */
        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        /**
         * Sets `--transparent-header-offset-boolean` when the first section must offset itself
         * under a transparent header. The non-offset case relies on the `0` default declared in
         * sections/header.liquid — unlike updateTransparentHeaderOffset() in utilities.js, which
         * re-runs on editor changes and must write '0' to reset a previously written '1'.
         */
        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        /**
         * Sets the initial menu style (inline menu vs. drawer) on the header component.
         * Mimics setHeaderMenuStyle() in utilities.js
         */
        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {% if request.page_type == 'blog' or request.page_type == 'article' %}{% render 'grooves-breadcrumbs' %}{% endif %}
        {{ content_for_layout }}
{% if request.page_type == 'index' %}
{% capture grooves_home_questions %}What products does Grooves Lifestyle offer?|What are TWS earbuds?|How do you choose wireless earbuds?|What is the difference between earbuds and neckbands?|How do you choose a power bank?{% endcapture %}
{% capture grooves_home_answers %}Grooves Lifestyle offers wireless audio products and mobile charging accessories in India. The range includes TWS earbuds, headphones, neckband earphones, charging adapters and selected combos. Browse the relevant collection and check each product page for the exact model, available options, package contents and specifications before ordering.|TWS means True Wireless Stereo. TWS earbuds use separate left and right earpieces without a cable joining them, and typically come with a charging case. They connect wirelessly to a compatible device. Battery runtime, microphone features, charging connection and water resistance vary by model and should be checked individually.|Choose wireless earbuds by comparing fit, device compatibility, calling needs and playback time per charge. Check whether the stated battery figure includes extra charges from the case. Confirm the charging port and any model-specific water-resistance or noise-cancellation claim. If a required specification is missing, ask support before choosing.|True wireless earbuds have separate earpieces that are usually stored and recharged in a case. Neckband earphones connect the earpieces to a band worn around the neck. The choice depends on comfort, storage and how you prefer to handle the earpieces; neither format guarantees better sound or longer battery life.|Choose a power bank by checking its stated capacity, output power, supported charging protocols and ports against your device requirements. Confirm how the power bank itself is recharged and which cable is needed. Capacity and wattage describe different things, so a larger capacity alone does not establish faster charging.{% endcapture %}
{% assign grooves_home_questions = grooves_home_questions | split: '|' %}
{% assign grooves_home_answers = grooves_home_answers | split: '|' %}
<section class="grooves-answer-guide" aria-label="Audio and charging buying help">
<p>Find wireless audio products and mobile charging accessories for your everyday setup. Use the guidance below to compare formats, then check the exact model on its product page.</p>
{% for question in grooves_home_questions %}
<h2 id="{{ question | handleize }}">{{ question | escape }}</h2>
<p>{{ grooves_home_answers[forloop.index0] | strip | escape }}</p>
{% endfor %}
<h2 id="compare-audio-formats">Compare audio formats</h2>
<div class="grooves-comparison-scroll"><table><caption>Physical differences between common listening formats</caption><thead><tr><th scope="col">Format</th><th scope="col">How it is worn</th><th scope="col">What to check</th></tr></thead><tbody><tr><th scope="row">TWS earbuds</th><td>Two separate in-ear earpieces, usually with a case</td><td>Earpiece fit, case charging and runtime per charge</td></tr><tr><th scope="row">Neckband earphones</th><td>Earpieces joined to a band around the neck</td><td>Band comfort, controls and charging input</td></tr><tr><th scope="row">Headphones</th><td>A headband with on-ear or over-ear cups</td><td>Wearing style, comfort and supported connections</td></tr></tbody></table></div>
<h2 id="check-accessory-compatibility">How to check accessory compatibility</h2>
<ol><li>Identify the exact phone, tablet or other device model.</li><li>Check its supported audio connection or charging protocol in the device documentation.</li><li>Compare the selected accessory and cable specifications with those requirements.</li><li>Ask support about any missing detail before ordering.</li></ol>
<p>Explore <a href="/collections/earbuds">TWS earbuds</a>, <a href="/collections/neck-band">neckband earphones</a>, <a href="/collections/headphones">headphones</a> and <a href="/collections/adaptor">charging adapters</a>. Read <a href="/pages/about-grooves">about the brand and its operator</a> or <a href="/pages/contact">contact customer support</a>.</p>
</section>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":{{ canonical_url | append: '#faqs' | json }},"mainEntity":[{% for question in grooves_home_questions %}{% unless forloop.first %},{% endunless %}{"@type":"Question","name":{{ question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ grooves_home_answers[forloop.index0] | strip | json }}}}{% endfor %}]}</script>
<style>.grooves-answer-guide{max-width:1280px;margin:0 auto;padding:32px 24px;line-height:1.65}.grooves-answer-guide h2{font-size:clamp(20px,3vw,28px);margin:24px 0 12px;scroll-margin-top:100px}.grooves-answer-guide p{margin:0 0 16px}.grooves-comparison-scroll{overflow-x:auto}.grooves-answer-guide table{width:100%;border-collapse:collapse;text-align:left}.grooves-answer-guide th,.grooves-answer-guide td{padding:12px;border:1px solid var(--g-border,#ddd);vertical-align:top}.grooves-answer-guide caption{text-align:left;margin-bottom:10px}.grooves-answer-guide ol{padding-left:24px}@media(max-width:749px){.grooves-answer-guide{padding:24px 16px}.grooves-answer-guide th,.grooves-answer-guide td{padding:8px}}</style>
{% endif %}

      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
