<section class="brand-marquee-section upgrade-brand"><div class="tr-container"><div class="upgrade-section-head"><div><span class="upgrade-eyebrow">BRAND SHOWCASE</span><h2>{{ section.settings.title | escape }}</h2></div><button type="button" class="upgrade-logo-pause" aria-label="Pause brand logo animation" aria-pressed="false">Pause motion</button></div><div class="upgrade-logo-viewport"><div class="upgrade-logo-track" style="--logo-speed:{{ section.settings.marquee_speed }}s">{% for repeat in (1..2) %}<div class="upgrade-logo-group" {% if repeat == 2 %}aria-hidden="true"{% endif %}>{% for block in section.blocks %}{% if block.settings.logo_image != blank %}<div class="upgrade-logo-card" {% if repeat == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.logo_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.logo_image.alt }}</div>{% endif %}{% endfor %}</div>{% endfor %}</div></div></div></section>
{% schema %}
{
  "name": "Brand Marquee Logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best selling brand on..."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 22
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Logo Dimensions & Spacing"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo Image Width",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Logo Image Height",
      "default": 60
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Space Between Logos",
      "default": 50
    },
    {
      "type": "header",
      "content": "Animation Settings"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed (Lower = Faster)",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo_item",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Brand Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Marquee Logos",
      "blocks": [
        { "type": "logo_item" },
        { "type": "logo_item" },
        { "type": "logo_item" }
      ]
    }
  ]
}
{% endschema %}