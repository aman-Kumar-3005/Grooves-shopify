<section class="g-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};--g-spacing:{{ section.settings.padding }}px"><div class="g-container"><div class="g-banner{% if section.settings.image_first %} g-banner-reverse{% endif %}" style="background:{{ section.settings.card_background }};--g-radius:{{ section.settings.radius }}px"><div class="g-banner-copy"><span class="g-eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><div>{{ section.settings.copy }}</div>{% if section.settings.link != blank %}<a class="g-button" href="{{ section.settings.link }}">{{ section.settings.button | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}</div><div class="g-banner-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url:width:1400 | image_tag: loading:'lazy', widths:'400,600,900,1400', sizes:'(min-width:750px) 50vw, 100vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div></div></div></section>

{% schema %}
{
  "name": "Grooves lifestyle banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MADE FOR YOUR EVERYDAY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn up your world."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Description",
      "default": "<p>Your music. Your space. Your sound.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product or lifestyle image"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "image_first",
      "label": "Image first on desktop",
      "default": false
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Banner background",
      "default": "#f1f2ee"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Grooves lifestyle banner"
    }
  ]
}
{% endschema %}
