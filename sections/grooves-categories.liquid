<section class="g-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};--g-spacing:{{ section.settings.padding }}px"><div class="g-container"><h2 class="g-section-title"><span>{{ section.settings.heading | escape }}</span></h2><div class="g-categories">{% for block in section.blocks %}{% assign collection = block.settings.collection %}{% assign category_image = block.settings.image | default:collection.featured_image %}{% assign category_url = block.settings.link | default:collection.url %}{% if category_url != blank %}<a href="{{ category_url }}" {{ block.shopify_attributes }}>{% if category_image != blank %}{{ category_image | image_url:width:240 | image_tag: loading:'lazy', widths:'120,180,240', sizes:'100px' }}{% else %}<span class="g-category-icon">{% render 'grooves-icon',name:block.settings.icon %}</span>{% endif %}<strong>{{ block.settings.title | default:collection.title | escape }}</strong></a>{% elsif request.design_mode %}<p {{ block.shopify_attributes }}>Select a collection or link.</p>{% endif %}{% endfor %}</div></div></section>

{% schema %}
{
  "name": "Grooves categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Categories"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "options": [
            {
              "value": "audio",
              "label": "Audio"
            },
            {
              "value": "watch",
              "label": "Watch"
            },
            {
              "value": "power",
              "label": "Power"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "shield",
              "label": "Shield"
            }
          ],
          "default": "audio"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Grooves categories"
    }
  ]
}
{% endschema %}
