<script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
{% assign collection = section.settings.collection %}
{% if collection.products_count > 0 or request.design_mode %}<section class="g-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};--g-spacing:{{ section.settings.padding }}px"><div class="g-container"><div class="g-section-top"><div><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.copy != blank %}<p>{{ section.settings.copy | escape }}</p>{% endif %}</div>{% if collection != blank %}<a href="{{ collection.url }}">View all &rarr;</a>{% endif %}</div><grooves-rail><div class="g-products g-products--{{ section.settings.layout }}" data-rail>{% for product in collection.products limit:section.settings.limit %}{% render 'grooves-product-card',product:product,section:section %}{% else %}<p>Select a collection with products in the theme editor.</p>{% endfor %}</div>{% if section.settings.layout == 'carousel' %}<div class="g-rail-controls"><button type="button" class="g-icon-button" data-prev aria-label="Previous products">&larr;</button><button type="button" class="g-icon-button" data-next aria-label="Next products">&rarr;</button></div>{% endif %}</grooves-rail></div></section>{% endif %}

{% schema %}
{
  "name": "Grooves product slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next favourite"
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Grooves product slider"
    }
  ]
}
{% endschema %}
