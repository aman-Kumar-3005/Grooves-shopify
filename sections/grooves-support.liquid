<section class="g-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};--g-spacing:{{ section.settings.padding }}px"><div class="g-container"><h2 class="g-section-title"><span>{{ section.settings.heading | escape }}</span></h2><div class="g-support-grid">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% render 'grooves-icon',name:block.settings.icon %}<h3>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</h3><p>{{ block.settings.copy | escape }}</p></div>{% endfor %}</div></div></section>

{% schema %}
{
  "name": "Grooves trust and support",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grooves Support"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Support feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "support",
              "label": "Support"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "faq",
              "label": "Faq"
            },
            {
              "value": "box",
              "label": "Box"
            }
          ],
          "default": "support"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Customer support"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Policy or support link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Grooves trust and support",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Customer Support",
            "icon": "support"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Warranty",
            "icon": "shield"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "FAQs",
            "icon": "faq"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Replacement",
            "icon": "box"
          }
        }
      ]
    }
  ]
}
{% endschema %}
