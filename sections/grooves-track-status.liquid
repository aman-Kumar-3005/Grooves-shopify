{{ 'grooves-track-status.css' | asset_url | stylesheet_tag }}
<section
  class="g-track g-container"
  data-g-track
  data-endpoint="{{ section.settings.lookup_endpoint | default: '/apps/grooves-support/status' | escape }}"
  data-register-endpoint="{{ section.settings.register_warranty_endpoint | default: '/apps/grooves-support/register-warranty' | escape }}"
  data-create-endpoint="{{ section.settings.create_ticket_endpoint | default: '/apps/grooves-support/create-ticket' | escape }}"
>
  <div class="g-track__intro">
    <span class="g-eyebrow">GROOVES CARE PORTAL</span>
    <h1>{{ section.settings.heading | default: 'WARRANTY, RETURNS & SUPPORT' | upcase }}</h1>
    <p>{{ section.settings.intro | default: 'Real Shopify order verify karke warranty register karein, claim/return request raise karein aur live ticket status track karein.' }}</p>
    <div class="g-track__steps" aria-label="Support process">
      <span><b>1</b> Verify order</span>
      <span><b>2</b> Register or raise request</span>
      <span><b>3</b> Track resolution</span>
    </div>
  </div>

  <div class="g-track__grid">
    <form class="g-track__card" data-lookup="warranty" novalidate>
      <span class="g-badge-pill">ORDER + WARRANTY</span>
      <h2>VERIFY YOUR COVERAGE</h2>
      <p>Order number ya warranty ID aur checkout email se purchase, remaining warranty aur return eligibility dekhein.</p>
      <label for="WarrantyInvoice-{{ section.id }}">Order Number / Warranty ID</label>
      <input id="WarrantyInvoice-{{ section.id }}" name="reference" type="text" maxlength="80" autocomplete="off" required placeholder="Example: #1001 or GRV-WTY-2026-000001">
      <label for="WarrantyEmail-{{ section.id }}">Checkout Email</label>
      <input id="WarrantyEmail-{{ section.id }}" name="email" type="email" maxlength="160" autocomplete="email" required placeholder="Email used at checkout">
      <button class="g-button" type="submit">Verify Order & Warranty</button>
      <div class="g-track__result" role="status" aria-live="polite" data-result hidden></div>
    </form>

    <form class="g-track__card" data-lookup="ticket" novalidate>
      <span class="g-badge-pill">SERVICE REQUEST</span>
      <h2>TRACK TICKET STATUS</h2>
      <p>Ticket number aur registered email se claim, return, repair ya replacement ka latest update dekhein.</p>
      <label for="SupportTicket-{{ section.id }}">Ticket Number</label>
      <input id="SupportTicket-{{ section.id }}" name="reference" type="text" maxlength="80" autocomplete="off" required placeholder="GRV-TKT-2026-000001">
      <label for="TicketLookupEmail-{{ section.id }}">Registered Email</label>
      <input id="TicketLookupEmail-{{ section.id }}" name="email" type="email" maxlength="160" autocomplete="email" required placeholder="Email used while creating ticket">
      <button class="g-button" type="submit">Track My Request</button>
      <div class="g-track__result" role="status" aria-live="polite" data-result hidden></div>
    </form>
  </div>

  <div class="g-track__privacy-note">
    <span aria-hidden="true">◆</span>
    <p><strong>Secure order verification</strong> — Details tabhi show honge jab order/ticket aur registered email match karein. Payment details aur full address kabhi display nahi hote.</p>
  </div>

  <div class="g-track__create-section" id="register-warranty-section">
    <form class="g-track__card g-track__card--full" data-register-warranty novalidate>
      <div class="g-track__create-header">
        <span class="g-badge-pill">PRODUCT REGISTRATION</span>
        <h2>REGISTER PRODUCT WARRANTY</h2>
        <p>Pehle upar order verify karein. Sirf usi verified Shopify order ke purchased products yahan select honge.</p>
      </div>
      <div class="g-track__form-grid">
        <div class="g-track__field">
          <label for="WarrantyName-{{ section.id }}">Customer Name <span class="g-req">*</span></label>
          <input id="WarrantyName-{{ section.id }}" name="customer_name" type="text" maxlength="100" required autocomplete="name" placeholder="Full name">
        </div>
        <div class="g-track__field">
          <label for="WarrantyRegisterEmail-{{ section.id }}">Checkout Email <span class="g-req">*</span></label>
          <input id="WarrantyRegisterEmail-{{ section.id }}" name="customer_email" type="email" maxlength="160" required autocomplete="email" placeholder="name@example.com">
        </div>
        <div class="g-track__field">
          <label for="WarrantyPhone-{{ section.id }}">Phone Number</label>
          <input id="WarrantyPhone-{{ section.id }}" name="customer_phone" type="tel" maxlength="30" autocomplete="tel" placeholder="+91">
        </div>
        <div class="g-track__field">
          <label for="WarrantyOrder-{{ section.id }}">Verified Order Number <span class="g-req">*</span></label>
          <input id="WarrantyOrder-{{ section.id }}" name="invoice_number" type="text" maxlength="80" required readonly placeholder="Verify order above">
        </div>
        <div class="g-track__field">
          <label for="WarrantyProduct-{{ section.id }}">Purchased Product <span class="g-req">*</span></label>
          <select id="WarrantyProduct-{{ section.id }}" name="line_item_id" required data-order-product-select disabled>
            <option value="">Verify an order to load products</option>
          </select>
        </div>
        <div class="g-track__field">
          <label for="WarrantySerial-{{ section.id }}">Serial / Batch Number</label>
          <input id="WarrantySerial-{{ section.id }}" name="serial_number" type="text" maxlength="120" placeholder="Printed on product or box">
        </div>
        <label class="g-track__consent g-track__field--full">
          <input type="checkbox" name="declaration" required>
          <span>Main confirm karta/karti hoon ki order aur product details sahi hain.</span>
        </label>
      </div>
      <button class="g-button g-button--submit" type="submit" disabled data-register-submit>Register Warranty</button>
      <div class="g-track__result g-track__result--create" role="status" aria-live="polite" data-register-result hidden></div>
    </form>
  </div>

  <div class="g-track__create-section" id="create-ticket-section">
    <form class="g-track__card g-track__card--full" data-create-ticket novalidate>
      <div class="g-track__create-header">
        <span class="g-badge-pill">CLAIM / RETURN / REPAIR</span>
        <h2>CREATE SERVICE REQUEST</h2>
        <p>Verified purchase ke against warranty claim, return, replacement, repair ya technical support ticket raise karein.</p>
      </div>

      <div class="g-track__form-grid">
        <div class="g-track__field">
          <label for="TicketName-{{ section.id }}">Customer Name <span class="g-req">*</span></label>
          <input id="TicketName-{{ section.id }}" name="customer_name" type="text" maxlength="100" required autocomplete="name" placeholder="Full name">
        </div>
        <div class="g-track__field">
          <label for="TicketEmail-{{ section.id }}">Checkout Email <span class="g-req">*</span></label>
          <input id="TicketEmail-{{ section.id }}" name="customer_email" type="email" maxlength="160" required autocomplete="email" placeholder="name@example.com">
        </div>
        <div class="g-track__field">
          <label for="TicketPhone-{{ section.id }}">Phone Number</label>
          <input id="TicketPhone-{{ section.id }}" name="customer_phone" type="tel" maxlength="30" autocomplete="tel" placeholder="+91">
        </div>
        <div class="g-track__field">
          <label for="TicketInvoice-{{ section.id }}">Verified Order Number <span class="g-req">*</span></label>
          <input id="TicketInvoice-{{ section.id }}" name="invoice_number" type="text" maxlength="80" required readonly placeholder="Verify order above">
        </div>
        <div class="g-track__field">
          <label for="TicketProduct-{{ section.id }}">Purchased Product <span class="g-req">*</span></label>
          <select id="TicketProduct-{{ section.id }}" name="line_item_id" required data-order-product-select disabled>
            <option value="">Verify an order to load products</option>
          </select>
        </div>
        <div class="g-track__field">
          <label for="TicketType-{{ section.id }}">Request Type <span class="g-req">*</span></label>
          <select id="TicketType-{{ section.id }}" name="request_type" required>
            <option value="warranty_claim">Warranty Claim</option>
            <option value="return">Return Request</option>
            <option value="replacement">Replacement Request</option>
            <option value="repair">Repair Request</option>
            <option value="technical_support">Technical Support</option>
            <option value="order_issue">Order / Delivery Issue</option>
            <option value="other">Other Support</option>
          </select>
        </div>
        <div class="g-track__field">
          <label for="TicketSerial-{{ section.id }}">Serial / Batch Number</label>
          <input id="TicketSerial-{{ section.id }}" name="serial_number" type="text" maxlength="120" placeholder="Printed on product or box">
        </div>
        <div class="g-track__field">
          <label for="TicketCategory-{{ section.id }}">Issue Category <span class="g-req">*</span></label>
          <select id="TicketCategory-{{ section.id }}" name="issue_category" required>
            <option value="Audio / Sound Distortion">Audio / Sound Distortion / Low Volume</option>
            <option value="Battery / Charging Issue">Battery Draining / Not Charging</option>
            <option value="Bluetooth / Pairing Problem">Bluetooth / Pairing Problem</option>
            <option value="Physical Defect / Damage">Physical Defect / Cable / Button Issue</option>
            <option value="Wrong / Missing Product">Wrong or Missing Product</option>
            <option value="Return / Refund">Return / Refund</option>
            <option value="Other">Other Inquiry</option>
          </select>
        </div>
        <div class="g-track__field g-track__field--full">
          <label for="TicketDesc-{{ section.id }}">Issue Description <span class="g-req">*</span></label>
          <textarea id="TicketDesc-{{ section.id }}" name="issue_description" minlength="10" maxlength="3000" rows="5" required placeholder="Issue kab start hua, exact problem aur already tried steps detail mein likhein..."></textarea>
        </div>
        <div class="g-track__field g-track__field--full">
          <label>Invoice / Defect Photos / Video Screenshot</label>
          <div class="g-track__dropzone" data-dropzone>
            <input type="file" id="TicketFiles-{{ section.id }}" name="attachments" multiple accept="image/jpeg,image/png,image/webp,application/pdf" class="g-track__file-input">
            <div class="g-track__dropzone-content">
              <span class="g-track__dropzone-icon">📎</span>
              <p><strong>Click to browse</strong> or drag & drop files</p>
              <small>JPG, PNG, WEBP, PDF — maximum 5 files, 10MB each</small>
            </div>
            <div class="g-track__file-list" data-file-list></div>
          </div>
        </div>
      </div>

      <button class="g-button g-button--submit" type="submit" disabled data-ticket-submit>Submit Service Request</button>
      <div class="g-track__result g-track__result--create" role="status" aria-live="polite" data-create-result hidden></div>
    </form>
  </div>

  {% if section.settings.support_email != blank %}
    <p class="g-track__help">Help chahiye? <a href="mailto:{{ section.settings.support_email | escape }}">{{ section.settings.support_email | escape }}</a> par contact karein.</p>
  {% endif %}
</section>
<script src="{{ 'grooves-track-status.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Grooves care portal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Warranty, returns & support"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Real Shopify order verify karke warranty register karein, claim/return request raise karein aur live ticket status track karein."
    },
    {
      "type": "text",
      "id": "lookup_endpoint",
      "label": "Status app proxy endpoint",
      "default": "/apps/grooves-support/status"
    },
    {
      "type": "text",
      "id": "register_warranty_endpoint",
      "label": "Warranty registration endpoint",
      "default": "/apps/grooves-support/register-warranty"
    },
    {
      "type": "text",
      "id": "create_ticket_endpoint",
      "label": "Service request endpoint",
      "default": "/apps/grooves-support/create-ticket"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@grooveslifestyle.com"
    }
  ],
  "presets": [{ "name": "Grooves care portal" }]
}
{% endschema %}