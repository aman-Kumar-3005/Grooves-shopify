{% schema %}
{
  "name": "Premium Hero Slider",
  "settings": [
    {
      "type": "header",
      "content": "Carousel Functionality"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Enable Auto Play",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_play_time",
      "label": "Auto Play Duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Slide transition speed",
      "min": 300,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Width (if not full width)",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full Screen Height (100vh)",
      "info": "UNCHECK this if you want to use the height sliders below.",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Height (if not full screen)",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile Height (if not full screen)",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Typography & Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop)",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading Size (Desktop)",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading Size (Mobile)",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#b3ff00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Corner Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video",
          "info": "Optional. Video is used instead of the desktop image."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Optional portrait video. Falls back to the desktop video."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Desktop media position",
          "default": "center center",
          "options": [
            { "value": "left center", "label": "Left" },
            { "value": "center center", "label": "Center" },
            { "value": "right center", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "mobile_image_position",
          "label": "Mobile media position",
          "default": "center center",
          "options": [
            { "value": "left center", "label": "Left" },
            { "value": "center center", "label": "Center" },
            { "value": "right center", "label": "Right" }
          ]
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 20
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Adymize Carousel"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Responsive Banner"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide Link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "default": "middle-left",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "middle-center", "label": "Middle center" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-right", "label": "Bottom right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Hero Slider"
    }
  ],
  "max_blocks": 10
}
{% endschema %}

<style>
  {% if section.settings.full_width %}
    #shopify-section-{{ section.id }} {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .page-width,
    #shopify-section-{{ section.id }} .page-width--narrow,
    #shopify-section-{{ section.id }} .container,
    #shopify-section-{{ section.id }} .content-container {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  {% endif %}

  #adymize-carousel-{{ section.id }} {
    position: relative;
    {% if section.settings.full_width %}
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    {% else %}
      width: 100%;
      max-width: {{ section.settings.max_width }}px;
      margin-left: auto;
      margin-right: auto;
    {% endif %}
    
    {% if section.settings.full_height %}
      height: 100vh !important;
      height: 100svh !important;
    {% else %}
      height: {{ section.settings.desktop_height }}px !important;
    {% endif %}
    
    overflow: hidden;
    background: transparent;
    margin-top: {{ section.settings.margin_top }}px !important;
    margin-bottom: {{ section.settings.margin_bottom }}px !important;
  }

  #adymize-carousel-{{ section.id }} * {
    box-sizing: border-box;
  }

  #adymize-carousel-{{ section.id }} .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform {{ section.settings.transition_speed }}ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  #adymize-carousel-{{ section.id }} .carousel-slide {
    position: relative;
    min-width: 100%;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  #adymize-carousel-{{ section.id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #adymize-carousel-{{ section.id }} .carousel-image,
  #adymize-carousel-{{ section.id }} .carousel-video,
  #adymize-carousel-{{ section.id }} .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-position, center center);
  }

  #adymize-carousel-{{ section.id }} .carousel-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  #adymize-carousel-{{ section.id }} .carousel-slide::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.24) 48%, rgba(0, 0, 0, 0.04) 100%);
    content: '';
    pointer-events: none;
  }

  #adymize-carousel-{{ section.id }} .carousel-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  #adymize-carousel-{{ section.id }} .carousel-content {
    position: absolute;
    z-index: 3;
    top: var(--content-y, 50%);
    left: var(--content-x, 50%);
    width: 90%;
    max-width: 900px;
    transform: translate(var(--content-shift-x, -50%), var(--content-shift-y, -50%));
    text-align: {{ section.settings.text_alignment }};
    padding: 24px;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.28);
  }

  #adymize-carousel-{{ section.id }} .carousel-content[data-position$='left'] {
    --content-x: max(var(--page-margin), calc((100% - 1440px) / 2 + var(--page-margin)));
    --content-shift-x: 0;
    max-width: 650px;
  }

  #adymize-carousel-{{ section.id }} .carousel-content[data-position$='right'] {
    --content-x: calc(100% - max(var(--page-margin), calc((100% - 1440px) / 2 + var(--page-margin))));
    --content-shift-x: -100%;
    max-width: 650px;
  }

  #adymize-carousel-{{ section.id }} .carousel-content[data-position^='top'] {
    --content-y: 14%;
    --content-shift-y: 0;
  }

  #adymize-carousel-{{ section.id }} .carousel-content[data-position^='bottom'] {
    --content-y: 86%;
    --content-shift-y: -100%;
  }

  #adymize-carousel-{{ section.id }} .carousel-eyebrow {
    display: inline-flex;
    margin: 0 0 14px;
    padding: 7px 12px;
    border-radius: 999px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-shadow: none;
  }

  #adymize-carousel-{{ section.id }} .carousel-content h2 {
    margin: 0 0 15px;
    font-size: {{ section.settings.heading_size_desktop }}px !important;
    line-height: 1.1;
    color: {{ section.settings.heading_color }} !important;
  }

  #adymize-carousel-{{ section.id }} .carousel-content p {
    margin: 0 0 25px;
    font-size: {{ section.settings.subheading_size_desktop }}px !important;
    line-height: 1.5;
    color: {{ section.settings.subheading_color }} !important;
  }

  #adymize-carousel-{{ section.id }} .carousel-btn {
    display: inline-block;
    padding: 14px 34px;
    background: {{ section.settings.button_bg_color }} !important;
    color: {{ section.settings.button_text_color }} !important;
    text-decoration: none;
    font-weight: 700;
    border-radius: {{ section.settings.button_radius }}px !important;
    transition: opacity 0.3s ease;
    min-height: 48px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  #adymize-carousel-{{ section.id }} .carousel-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
  }

  #adymize-carousel-{{ section.id }} .carousel-arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    width: 50px;
    height: 50px;
    transform: translateY(-50%);
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #adymize-carousel-{{ section.id }} .carousel-arrow.prev {
    left: 20px;
  }

  #adymize-carousel-{{ section.id }} .carousel-arrow.next {
    right: 20px;
  }

  #adymize-carousel-{{ section.id }} .carousel-arrow svg {
    width: 22px;
    height: 22px;
    fill: #000;
  }

  #adymize-carousel-{{ section.id }} .carousel-dots {
    position: absolute;
    left: 50%;
    bottom: 25px;
    z-index: 5;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
  }

  #adymize-carousel-{{ section.id }} .carousel-dot {
    width: 44px;
    height: 44px;
    padding: 16px;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  #adymize-carousel-{{ section.id }} .carousel-dot::after {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
  }

  #adymize-carousel-{{ section.id }} .carousel-dot:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  #adymize-carousel-{{ section.id }} .carousel-dot.active {
    background: transparent;
  }

  #adymize-carousel-{{ section.id }} .carousel-dot.active::after {
    width: 28px;
    border-radius: 999px;
    background: {{ section.settings.button_bg_color }};
    transform: translateX(-8px);
  }

  #adymize-carousel-{{ section.id }} .carousel-video--mobile { display: none; }

  @media screen and (max-width: 767px) {
    #adymize-carousel-{{ section.id }} {
      {% if section.settings.full_height %}
        height: 100vh !important;
        height: 100svh !important;
      {% else %}
        height: {{ section.settings.mobile_height }}px !important;
      {% endif %}
      overflow: hidden;
      background: transparent;
    }

    #adymize-carousel-{{ section.id }} .carousel-track {
      height: 100%;
      align-items: stretch;
    }

    #adymize-carousel-{{ section.id }} .carousel-slide {
      height: 100%;
    }

    #adymize-carousel-{{ section.id }} picture {
      width: 100%;
      height: 100%;
    }

    #adymize-carousel-{{ section.id }} .carousel-image,
    #adymize-carousel-{{ section.id }} .carousel-video,
    #adymize-carousel-{{ section.id }} .placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--mobile-media-position, var(--media-position, center center));
    }

    #adymize-carousel-{{ section.id }} .carousel-content {
      width: 92%;
      max-width: none;
      left: 4%;
      right: auto;
      top: auto;
      bottom: 54px;
      transform: none;
      padding: 0 10px;
      text-align: left;
    }

    #adymize-carousel-{{ section.id }} .carousel-video--desktop:has(+ .carousel-video--mobile) { display: none; }
    #adymize-carousel-{{ section.id }} .carousel-video--mobile { display: block; }

    #adymize-carousel-{{ section.id }} .carousel-content h2 {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
    }

    #adymize-carousel-{{ section.id }} .carousel-content p {
      font-size: {{ section.settings.subheading_size_mobile }}px !important;
    }

    #adymize-carousel-{{ section.id }} .carousel-arrow {
      width: 38px;
      height: 38px;
    }

    #adymize-carousel-{{ section.id }} .carousel-arrow.prev {
      left: 10px;
    }

    #adymize-carousel-{{ section.id }} .carousel-arrow.next {
      right: 10px;
    }

    #adymize-carousel-{{ section.id }} .carousel-dots {
      bottom: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #adymize-carousel-{{ section.id }} .carousel-track { transition: none; }
  }
</style>

<div
  id="adymize-carousel-{{ section.id }}"
  class="premium-hero"
  data-autoplay="{{ section.settings.auto_play }}"
  data-speed="{{ section.settings.auto_play_time | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="Homepage promotions"
  tabindex="0"
>
  {% if section.settings.show_arrows %}
    <button class="carousel-arrow prev" type="button" aria-label="Previous Slide">
      <svg viewBox="0 0 24 24">
        <path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"></path>
      </svg>
    </button>
  {% endif %}

  <div class="carousel-track">
    {% for block in section.blocks %}
      {% assign hero_link = block.settings.slide_link %}
      {% if hero_link == blank %}
        {% assign hero_link = routes.root_url | append: 'collections/earbuds' %}
      {% endif %}
      <div
        class="carousel-slide"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ forloop.length }}"
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        style="--media-position: {{ block.settings.image_position }}; --mobile-media-position: {{ block.settings.mobile_image_position }};"
        {{ block.shopify_attributes }}
      >
        {% if hero_link != blank and block.settings.button_label == blank %}
          <a href="{{ hero_link }}" class="carousel-link" aria-label="{{ block.settings.heading | default: 'Shop earbuds' | escape }}"></a>
        {% endif %}

        <div
          class="carousel-overlay"
          style="background: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});"
        ></div>

        {% if block.settings.desktop_video != blank %}
          {{ block.settings.desktop_video | video_tag: class: 'carousel-video carousel-video--desktop', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '2000x' }}
          {% if block.settings.mobile_video != blank %}
            {{ block.settings.mobile_video | video_tag: class: 'carousel-video carousel-video--mobile', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '900x' }}
          {% endif %}
        {% else %}
          <picture>
            {% if block.settings.mobile_image != blank %}
              <source
                media="(max-width: 767px)"
                srcset="{{ block.settings.mobile_image | image_url: width: 360 }} 360w, {{ block.settings.mobile_image | image_url: width: 540 }} 540w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 900 }} 900w"
                sizes="100vw"
              >
            {% endif %}

            {% if block.settings.desktop_image != blank %}
            <img
              class="carousel-image"
              src="{{ block.settings.desktop_image | image_url: width: 1440 }}"
              srcset="{{ block.settings.desktop_image | image_url: width: 960 }} 960w, {{ block.settings.desktop_image | image_url: width: 1440 }} 1440w, {{ block.settings.desktop_image | image_url: width: 1920 }} 1920w, {{ block.settings.desktop_image | image_url: width: 2400 }} 2400w"
              sizes="100vw"
              alt="{{ block.settings.desktop_image.alt | escape }}"
              width="{{ block.settings.desktop_image.width }}"
              height="{{ block.settings.desktop_image.height }}"
              {% if forloop.first %}
                loading="eager"
                fetchpriority="high"
              {% else %}
                loading="lazy"
              {% endif %}
            >
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'carousel-image placeholder-svg' }}
            {% endif %}
          </picture>
        {% endif %}

        {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank %}
          <div class="carousel-content" data-position="{{ block.settings.content_position }}">
            {% if block.settings.eyebrow != blank %}
              <div class="carousel-eyebrow">{{ block.settings.eyebrow | escape }}</div>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.subheading != blank %}
              <p>{{ block.settings.subheading }}</p>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <a href="{{ hero_link }}" class="carousel-btn">
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if section.settings.show_arrows %}
    <button class="carousel-arrow next" type="button" aria-label="Next Slide">
      <svg viewBox="0 0 24 24">
        <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"></path>
      </svg>
    </button>
  {% endif %}

  {% if section.settings.show_dots %}
    <div class="carousel-dots">
      {% for block in section.blocks %}
        <button
          type="button"
          class="carousel-dot {% if forloop.first %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go To Slide {{ forloop.index }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  (function() {
    function initCarousel() {
      const carousel = document.querySelector('#adymize-carousel-{{ section.id }}');
      if (!carousel || carousel.dataset.initialized === 'true') return;
      
      carousel.dataset.initialized = 'true';
      const track = carousel.querySelector('.carousel-track');
      const slides = carousel.querySelectorAll('.carousel-slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const prevBtn = carousel.querySelector('.carousel-arrow.prev');
      const nextBtn = carousel.querySelector('.carousel-arrow.next');
      
      const totalSlides = slides.length;
      const autoplay = carousel.dataset.autoplay === 'true';
      const speed = parseInt(carousel.dataset.speed, 10) || 5000;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let currentSlide = 0;
      let autoplayInterval;
      let startX = 0;
      let isFocused = false;

      if (totalSlides <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        const dotsWrap = carousel.querySelector('.carousel-dots');
        if (dotsWrap) dotsWrap.style.display = 'none';
        return;
      }

      function updateSlide(index) {
        currentSlide = index;
        track.style.transform = 'translateX(-' + currentSlide * 100 + '%)';
        slides.forEach((slide, slideIndex) => {
          const active = slideIndex === currentSlide;
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          slide.querySelectorAll('video').forEach(video => {
            if (active && !reducedMotion) {
              const playPromise = video.play();
              if (playPromise && typeof playPromise.catch === 'function') playPromise.catch(() => {});
            } else {
              video.pause();
            }
          });
        });
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === currentSlide);
          dot.setAttribute('aria-current', index === currentSlide ? 'true' : 'false');
        });
      }

      function nextSlide() { updateSlide((currentSlide + 1) % totalSlides); }
      function prevSlide() { updateSlide((currentSlide - 1 + totalSlides) % totalSlides); }

      function startAutoplay() {
        if (!autoplay || reducedMotion || isFocused) return;
        stopAutoplay();
        autoplayInterval = setInterval(nextSlide, speed);
        carousel.dataset.intervalId = autoplayInterval;
      }

      function stopAutoplay() {
        if (autoplayInterval) clearInterval(autoplayInterval);
      }

      function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetAutoplay(); });
      if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetAutoplay(); });
      dots.forEach(dot => dot.addEventListener('click', () => { updateSlide(parseInt(dot.dataset.index, 10)); resetAutoplay(); }));

      track.addEventListener('touchstart', e => startX = e.touches[0].clientX, { passive: true });
      track.addEventListener('touchend', e => {
        const endX = e.changedTouches[0].clientX;
        if (startX - endX > 50) { nextSlide(); resetAutoplay(); }
        if (endX - startX > 50) { prevSlide(); resetAutoplay(); }
      }, { passive: true });

      carousel.addEventListener('keydown', event => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          nextSlide();
          resetAutoplay();
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          prevSlide();
          resetAutoplay();
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });

      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', startAutoplay);
      carousel.addEventListener('focusin', () => {
        isFocused = true;
        stopAutoplay();
      });
      carousel.addEventListener('focusout', event => {
        if (!carousel.contains(event.relatedTarget)) {
          isFocused = false;
          startAutoplay();
        }
      });

      updateSlide(0);
      startAutoplay();
    }

    // Run on load
    initCarousel();

    // Re-run JS perfectly inside Shopify Theme Editor when saving/changing settings
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initCarousel();
      }
    });

    // Clean up interval to prevent memory leaks in Theme Editor
    document.addEventListener('shopify:section:unload', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        const carousel = document.querySelector('#adymize-carousel-{{ section.id }}');
        if (carousel && carousel.dataset.intervalId) {
          clearInterval(parseInt(carousel.dataset.intervalId));
        }
      }
    });

    document.addEventListener('shopify:block:select', function(event) {
      const carousel = document.querySelector('#adymize-carousel-{{ section.id }}');
      if (!carousel || !carousel.contains(event.target)) return;
      const slides = Array.from(carousel.querySelectorAll('.carousel-slide'));
      const selected = slides.indexOf(event.target.closest('.carousel-slide'));
      if (selected < 0) return;
      carousel.querySelector('.carousel-track').style.transform = 'translateX(-' + selected * 100 + '%)';
      slides.forEach((slide, index) => slide.setAttribute('aria-hidden', index === selected ? 'false' : 'true'));
      carousel.querySelectorAll('.carousel-dot').forEach((dot, index) => {
        dot.classList.toggle('active', index === selected);
        dot.setAttribute('aria-current', index === selected ? 'true' : 'false');
      });
    });
  })();
</script>
