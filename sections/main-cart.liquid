{%- liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
-%}

{%- capture cart_page_more_blocks_content -%}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{%- endcapture -%}

{%- capture cart_items_children -%}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true -%}
        </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true -%}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <!-- Left Column: Banners, Title, Items -->
      <div class="cart-page__main-column">
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' -%}
        </div>

        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' -%}
        </div>

        {{ cart_page_more_blocks_content }}
      </div>

      <!-- Right Column: Summary -->
      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

    </div>
  </div>
{%- endcapture -%}

{%- render 'cart-items-component', children: cart_items_children, section_id: section.id -%}


<section class="grooves-cart-help" aria-label="Shopping guidance and customer support">
  <div class="gch-wrap">
    <section class="gch-discover" aria-labelledby="gch-discover-{{ section.id }}">
      <div class="gch-heading"><div><span class="gch-eyebrow">FIND YOUR NEXT EVERYDAY ESSENTIAL</span><h2 id="gch-discover-{{ section.id }}">Make room for more Grooves.</h2></div><a class="gch-text-link" href="{{ routes.all_products_collection_url }}">Explore all products &rarr;</a></div>
      <div class="gch-categories">
        {% assign cart_category_handles = 'earbuds,headphones,neck-band,adaptor' | split: ',' %}
        {% assign cart_category_labels = 'Wireless earbuds,Headphones,Neckband earphones,Charging adapters' | split: ',' %}
        {% assign cart_category_notes = 'Small format. Everyday listening.,Find your preferred wearing style.,Connected earpieces. Flexible listening.,Match your device and charging protocol.' | split: ',' %}
        {% for category_handle in cart_category_handles %}
          {% assign category = collections[category_handle] %}
          {% if category != blank %}
            {% assign category_image = category.image | default: category.products.first.featured_image %}
            <a class="gch-category" href="{{ category.url }}">
              <div class="gch-image">{% if category_image != blank %}{{ category_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '240,360,500', sizes: '(max-width: 600px) 44vw, 260px', alt: cart_category_labels[forloop.index0] }}{% endif %}</div>
              <div class="gch-category-copy"><h3>{{ cart_category_labels[forloop.index0] }}</h3><p>{{ cart_category_notes[forloop.index0] }}</p><span>Explore collection &rarr;</span></div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </section>
    <section class="gch-check" aria-labelledby="gch-check-{{ section.id }}">
      <div><span class="gch-eyebrow">A QUICK CHECK BEFORE CHECKOUT</span><h2 id="gch-check-{{ section.id }}">Your choice. Checked.</h2><p>A minute now helps you choose the right audio or charging accessory for your everyday setup.</p><a class="gch-text-link" href="/pages/contact">Need help choosing? Contact Grooves &rarr;</a></div>
      <ol class="gch-checklist"><li><strong>Check the exact model</strong><span>Review the selected colour, quantity, fit and product specifications.</span></li><li><strong>Match your device</strong><span>For chargers, compare the connector, supported protocol and cable requirements with your device documentation.</span></li><li><strong>Review the final total</strong><span>Enter your delivery address at checkout to see available shipping options and the final payable amount.</span></li></ol>
    </section>
    <section class="gch-faq" aria-labelledby="gch-faq-{{ section.id }}">
      <div class="gch-heading"><div><span class="gch-eyebrow">GOOD TO KNOW</span><h2 id="gch-faq-{{ section.id }}">Before you place your order.</h2></div></div>
      <details><summary>How do I update my cart?</summary><p>Use the quantity controls beside each item, or remove an item you no longer need. Check the selected variant before continuing to checkout.</p></details>
      <details><summary>Which payment methods can I use?</summary><p>The payment methods available for your order are shown at checkout. Review the final total before completing payment.</p></details>
      <details><summary>Where can I check shipping and return terms?</summary><p>Read our <a href="/policies/shipping-policy">shipping policy</a> and <a href="/policies/refund-policy">refund policy</a> before ordering. Eligibility and any conditions follow the published policies; delivery availability is checked using your address at checkout.</p></details>
      <details><summary>How do I choose between earbuds, headphones and neckbands?</summary><p>Start with the wearing style you prefer, then compare the exact model's fit, connectivity and charging details. Our <a href="/blogs/news/grooves-earbuds-vs-headphones-buying-guide">earbuds vs headphones buying guide</a> helps you compare formats without assuming every model has the same features.</p></details>
      <details><summary>Where can I get help after ordering?</summary><p>Contact our <a href="/pages/contact">customer support team</a> for order questions. For existing warranty or support requests, use <a href="/pages/track-status">warranty and ticket status</a>. Keep your order details handy.</p></details>
    </section>
    <section class="gch-guide" aria-labelledby="gch-guide-{{ section.id }}"><div><span class="gch-eyebrow">CHOOSE WITH CONFIDENCE</span><h2 id="gch-guide-{{ section.id }}">Audio and charging, chosen for you.</h2><p>Explore Grooves wireless earbuds, headphones, neckband earphones and mobile charging accessories in India. Compare the current price, available variant and model-specific information on each product page. For charging accessories, check your device's supported charging standard and the cable needed for your setup.</p></div><div class="gch-guide-links"><a href="/blogs/news/grooves-earbuds-vs-headphones-buying-guide">Read the audio buying guide &rarr;</a><a href="/pages/contact">Ask a product question &rarr;</a><a href="/policies/shipping-policy">Shipping information &rarr;</a></div></section>
  </div>
</section>
<style>
#shopify-section-{{ section.id }}{height:auto;flex-shrink:0}
#shopify-section-{{ section.id }} > cart-items-component{height:auto;min-height:0}

.grooves-cart-help{color:#17243d;background:#f5f7fb;padding:48px 24px;margin-top:32px}.gch-wrap{max-width:1240px;margin:auto;display:grid;gap:48px}.gch-wrap h2{font-size:clamp(25px,3vw,36px);line-height:1.15;margin:10px 0 16px;letter-spacing:-.025em}.gch-wrap h3{font-size:18px;line-height:1.3;margin:0 0 8px}.gch-wrap p{font-size:15px;line-height:1.7;margin:0 0 16px}.gch-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em}.gch-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:22px}.gch-text-link{color:#17243d;font-size:14px;font-weight:700;text-underline-offset:4px}.gch-categories{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.gch-category{color:inherit;text-decoration:none;background:#fff;border:1px solid #e1e7ef;border-radius:20px;overflow:hidden;transition:box-shadow .2s}.gch-category:hover{box-shadow:0 8px 24px #17243d14}.gch-image{aspect-ratio:4/3;background:#fff;display:grid;place-items:center;padding:16px}.gch-image img{width:100%;height:100%;object-fit:contain;max-height:190px}.gch-category-copy{padding:20px}.gch-category-copy p{color:#4d5c70;font-size:13px;min-height:44px}.gch-category-copy span{font-size:13px;font-weight:700}.gch-check{background:#17243d;color:#fff;border-radius:24px;padding:36px;display:grid;grid-template-columns:1fr 1.15fr;gap:48px}.gch-check h2,.gch-check .gch-text-link{color:#fff}.gch-check p{color:#dce5f1}.gch-checklist{list-style:none;padding:0;margin:0;counter-reset:cart-check;display:grid;gap:22px}.gch-checklist li{counter-increment:cart-check;position:relative;padding-left:46px}.gch-checklist li:before{content:counter(cart-check,decimal-leading-zero);position:absolute;left:0;top:0;color:#77c9ed;font-weight:700;font-size:18px}.gch-checklist strong,.gch-checklist span{display:block}.gch-checklist strong{font-size:16px;margin-bottom:5px}.gch-checklist span{font-size:14px;line-height:1.6;color:#dce5f1}.gch-faq{max-width:900px;width:100%;margin:auto}.gch-faq details{border-bottom:1px solid #d8e0eb;padding:0 4px}.gch-faq summary{cursor:pointer;padding:20px 0;font-size:16px;font-weight:600;line-height:1.4}.gch-faq details p{color:#4d5c70;max-width:760px}.gch-faq a{color:#17243d;text-decoration:underline;text-underline-offset:3px}.gch-guide{border-top:1px solid #d8e0eb;padding-top:36px;display:grid;grid-template-columns:1.8fr 1fr;gap:48px}.gch-guide p{color:#4d5c70}.gch-guide-links{display:grid;align-content:center;gap:12px}.gch-guide-links a{color:#17243d;background:#fff;border:1px solid #e1e7ef;border-radius:12px;padding:16px;text-decoration:none;font-size:14px;font-weight:600}.gch-wrap a:focus-visible,.gch-wrap summary:focus-visible{outline:3px solid #2689c9;outline-offset:4px}
@media(max-width:850px){.gch-categories{grid-template-columns:repeat(2,minmax(0,1fr))}.gch-check,.gch-guide{grid-template-columns:1fr;gap:28px}.gch-check{padding:28px}}
@media(max-width:500px){.grooves-cart-help{padding:32px 16px}.gch-wrap{gap:34px}.gch-heading{align-items:flex-start;flex-direction:column;gap:4px}.gch-categories{gap:12px}.gch-category{border-radius:14px}.gch-category-copy{padding:14px}.gch-wrap h3{font-size:16px}.gch-image{padding:10px}.gch-check{padding:24px 20px}.gch-faq summary{font-size:15px}.gch-guide{gap:16px}}
@media(prefers-reduced-motion:reduce){.gch-category{transition:none}}
</style>

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main-column {
    grid-column: 1;
    display: flex;
    flex-direction: column;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
    grid-column: 1;
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  /* High Conversion Addon Styles */
  .cart-urgency-banner {
    background: #fff8f8;
    border: 1px dashed #ff4d4d;
    color: #d93838;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-weight: 500;
  }

  .cart-announcement-bar {
    background: linear-gradient(135deg, #13a8b9 0%, #0c7c88 100%);
    color: #ffffff;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    text-align: center;
    margin-bottom: 16px;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(19, 168, 185, 0.2);
  }

  .cart-trust-badges-box {
    margin-top: 15px;
    padding: 16px;
    background: #fcfcfc;
    border-radius: 10px;
    border: 1px solid #e5e5e5;
  }

  .trust-box-title {
    font-size: 13px;
    font-weight: 700;
    color: #222;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .trust-badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid #f0f0f0;
  }

  .badge-icon-wrap {
    font-size: 18px;
  }

  .badge-texts {
    display: flex;
    flex-direction: column;
    font-size: 11px;
    line-height: 1.3;
  }

  .badge-texts strong {
    color: #111;
  }

  .badge-texts span {
    color: #666;
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: 1fr min(50vw, var(--sidebar-width));
    }

    .cart-page__main-column {
      grid-column: 1;
    }

    .cart-page__summary {
      grid-column: 2;
      padding-top: 0;
      position: relative;
    }

    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr minmax(
          var(--sidebar-width),
          calc((100vw - var(--page-width)) / 2 + var(--sidebar-width))
        );
    }
  }

  @media screen and (min-width: 1400px) {
    .cart-page {
      grid-template-columns: 1fr var(--sidebar-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}