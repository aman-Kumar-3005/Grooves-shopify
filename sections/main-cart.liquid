{%- liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
-%}

{%- capture cart_page_more_blocks_content -%}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{%- endcapture -%}

{%- capture cart_items_children -%}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true -%}
        </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true -%}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <!-- Left Column: Banners, Title, Items -->
      <div class="cart-page__main-column">
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' -%}
        </div>

        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' -%}
        </div>

        {{ cart_page_more_blocks_content }}
      </div>

      <!-- Right Column: Summary -->
      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

    </div>
  </div>
{%- endcapture -%}

{%- render 'cart-items-component', children: cart_items_children, section_id: section.id -%}

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main-column {
    grid-column: 1;
    display: flex;
    flex-direction: column;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
    grid-column: 1;
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  /* High Conversion Addon Styles */
  .cart-urgency-banner {
    background: #fff8f8;
    border: 1px dashed #ff4d4d;
    color: #d93838;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-weight: 500;
  }

  .cart-announcement-bar {
    background: linear-gradient(135deg, #13a8b9 0%, #0c7c88 100%);
    color: #ffffff;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    text-align: center;
    margin-bottom: 16px;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(19, 168, 185, 0.2);
  }

  .cart-trust-badges-box {
    margin-top: 15px;
    padding: 16px;
    background: #fcfcfc;
    border-radius: 10px;
    border: 1px solid #e5e5e5;
  }

  .trust-box-title {
    font-size: 13px;
    font-weight: 700;
    color: #222;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .trust-badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid #f0f0f0;
  }

  .badge-icon-wrap {
    font-size: 18px;
  }

  .badge-texts {
    display: flex;
    flex-direction: column;
    font-size: 11px;
    line-height: 1.3;
  }

  .badge-texts strong {
    color: #111;
  }

  .badge-texts span {
    color: #666;
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: 1fr min(50vw, var(--sidebar-width));
    }

    .cart-page__main-column {
      grid-column: 1;
    }

    .cart-page__summary {
      grid-column: 2;
      padding-top: 0;
      position: relative;
    }

    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr minmax(
          var(--sidebar-width),
          calc((100vw - var(--page-width)) / 2 + var(--sidebar-width))
        );
    }
  }

  @media screen and (min-width: 1400px) {
    .cart-page {
      grid-template-columns: 1fr var(--sidebar-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}