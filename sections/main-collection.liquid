

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  {% render 'grooves-breadcrumbs', collection: collection %}
{% capture grooves_collection_intro %}{% case collection.handle %}
{% when 'earbuds' %}Compare true wireless earbuds for everyday music and calls. Check the specifications for the exact model rather than assuming that battery life, water resistance or noise cancellation is shared across the range.
{% when 'headphones' %}Browse headphones and compare their wearing style, connection options and stated battery information. Choose the exact model for your listening setup; features differ between products.
{% when 'neck-band' %}Explore neckband earphones for listeners who prefer earpieces connected by a band. Compare the stated playback conditions, charging input and controls for each model.
{% when 'adaptor' %}Compare charging adapters by the connection, stated output and charging protocol required by your device. A higher wattage printed on an adapter does not by itself establish compatibility with a particular phone.
{% when 'accessories' %}Explore the current accessories selection and open each product for its exact specifications and available options. Compare the connection your device needs before ordering an audio or charging accessory.
{% when 'combo' %}Compare combos by the individual products named in each listing. Confirm that every included item meets your needs; one component’s specifications do not automatically describe the other component.
{% when 'offers' %}Browse the products currently shown in the offers collection. Compare the live product page and chosen variant for current pricing and availability; the collection does not promise a fixed discount or a permanent offer.
{% when 'power-bank' %}When choosing a power bank, compare capacity, output, input charging and the connections required by your devices. Products appear here only when listed in this collection; an empty collection does not indicate current availability.
{% endcase %}{% endcapture %}{% assign grooves_collection_intro = grooves_collection_intro | strip %}
{% if grooves_collection_intro != blank %}<div class="grooves-collection-guidance"><p>{{ grooves_collection_intro }}</p></div>{% endif %}

  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% capture grooves_collection_answers %}{% case collection.handle %}
{% when 'earbuds' %}
<h3 id="earbuds-question-1">How do you choose wireless earbuds?</h3><p>Choose wireless earbuds by comparing fit, device compatibility, calling needs and playback time per charge. Check whether the stated battery figure includes extra charges from the case. Confirm the charging port and any model-specific water-resistance or noise-cancellation claim. If a required specification is missing, ask support before choosing.</p>
<h3 id="earbuds-question-2">Are all earbuds suitable for workouts?</h3><p>Check the exact model’s stated water-resistance rating and fit before choosing earbuds for exercise. Sweat or splash protection is different from protection during swimming or immersion. The charging case may have a different rating from the earpieces. If the listing does not state a rating, confirm it before use.</p>
{% when 'headphones' %}
<h3 id="headphones-question-1">What should you check before buying Bluetooth headphones?</h3><p>Compare wearing comfort, device connectivity, microphone information and charging requirements before buying Bluetooth headphones. Check whether your setup needs a wired input as well as Bluetooth. If a noise-cancellation feature matters to you, confirm its type for the exact model rather than relying on the appearance of the headphones.</p>
<h3 id="headphones-question-2">Are headphones or earbuds a better everyday choice?</h3><p>Headphones use an on-ear or over-ear fit, while earbuds sit at or inside the ear and are usually easier to store in a small bag. Compare comfort, portability and the listening situations you expect. Neither format by itself guarantees better calling, sound quality or battery runtime across different models.</p>
{% when 'neck-band' %}
<h3 id="neck-band-question-1">What is the difference between TWS earbuds and neckbands?</h3><p>True wireless earbuds have separate earpieces that are usually stored and recharged in a case. Neckband earphones connect the earpieces to a band worn around the neck. The choice depends on comfort, storage and how you prefer to handle the earpieces; neither format guarantees better sound or longer battery life.</p>
<h3 id="neck-band-question-2">How should neckband battery figures be compared?</h3><p>Compare neckband battery figures measured under similar conditions, including volume and whether the result refers to music, calls or standby. Higher volume and enabled features can change runtime. A stated result at a particular volume is a test condition, rather than a promise of the same duration in every situation.</p>
{% when 'adaptor' %}
<h3 id="adaptor-question-1">How do you choose a fast mobile charger?</h3><p>Check your device manufacturer’s supported charging protocol and power requirements, then match both the adapter and cable to those requirements. Check the listed output modes rather than wattage alone. Connector shape does not establish charging compatibility, and the device determines which supported mode it can use with compatible equipment.</p>
<h3 id="adaptor-question-2">Does USB-C always mean the same charging speed?</h3><p>No. USB-C describes the connector shape, while power capability and charging protocols vary between products. A USB-C port can support different combinations of charging and data functions. Check the specifications of the phone, adapter and cable together; a matching plug alone does not guarantee a particular charging speed.</p>
{% when 'accessories' %}
<h3 id="accessories-question-1">How do you check accessory compatibility?</h3><p>Identify your exact device model and its supported connector or wireless connection, then compare those requirements with the accessory listing. For chargers, also check the supported charging protocol and cable capability. For audio products, check the connection and controls you need. Ask support if a required detail is not listed.</p>
<h3 id="accessories-question-2">Where can I get help choosing an accessory?</h3><p>Contact customer support with the exact device model and the accessory you are considering. Explain which connection or feature you need, such as a charging protocol, wired input or microphone. Including the product link helps identify the correct listing and avoids confusing similarly named models or different product generations.</p>
{% when 'combo' %}
<h3 id="combo-question-1">What should you check before buying an electronics combo?</h3><p>Check the exact models included in the combo, the selected variants, charging requirements and stated package contents. Compare each component with your own device requirements. A bundle name is not a substitute for an itemised contents list, so confirm any missing model or accessory detail with support before ordering.</p>
<h3 id="combo-question-2">Do all products in a combo have identical specifications?</h3><p>No. Each product included in a combo has its own specifications and compatibility requirements. Battery figures, charging inputs or connection features stated for one component do not automatically apply to another. Read the individual product pages where available, and check the selected combo listing for the exact included items.</p>
{% when 'offers' %}
<h3 id="offers-question-1">How do you compare an offer fairly?</h3><p>Compare the exact model, selected variant and included accessories before judging an offer. Check whether you are comparing the same generation and package contents across listings. Review the current payable amount and delivery details at checkout, since a percentage discount alone does not describe the complete purchase or its suitability.</p>
<h3 id="offers-question-2">Can offer prices and availability change?</h3><p>Yes. Offer prices and stock availability can change, and different variants may have different information. Review the selected product page and the details shown when you order. An older promotion or saved collection screenshot should not be treated as a guarantee of future pricing, included items or stock availability.</p>
{% when 'power-bank' %}
<h3 id="power-bank-question-1">What should you check before buying a power bank?</h3><p>Choose a power bank by checking its stated capacity, output power, supported charging protocols and ports against your device requirements. Confirm how the power bank itself is recharged and which cable is needed. Capacity and wattage describe different things, so a larger capacity alone does not establish faster charging.</p>
<h3 id="power-bank-question-2">Is battery capacity the same as output power?</h3><p>No. Capacity describes stored charge or energy, while output power describes the rate at which energy can be delivered to compatible equipment. Compare the stated units and test conditions. The number of phone charges also depends on the phone battery and conversion losses, so capacity alone cannot guarantee a recharge count.</p>
{% endcase %}{% endcapture %}{% assign grooves_collection_answers = grooves_collection_answers | strip %}
{% if grooves_collection_answers != blank %}<section class="grooves-collection-guidance" aria-labelledby="collection-buying-help-{{ section.id }}"><h2 id="collection-buying-help-{{ section.id }}">Choosing {{ collection.title | escape }}</h2>{{ grooves_collection_answers }}<p>Explore <a href="{{ routes.all_products_collection_url }}">all Grooves products</a> or <a href="/pages/contact">contact Grooves support</a> for help with a specific model.</p></section>{% endif %}
<style>.grooves-collection-guidance{max-width:1280px;margin:0 auto;padding:12px 24px;line-height:1.6}.grooves-collection-guidance h2{font-size:clamp(22px,3vw,28px)}.grooves-collection-guidance h3{font-size:18px;margin:20px 0 8px}.grooves-collection-guidance p{margin:8px 0 16px}@media(max-width:749px){.grooves-collection-guidance{padding:10px 16px}}</style>



{% if grooves_collection_answers != blank %}
{% assign grooves_faq_entries = grooves_collection_answers | split: '<h3' %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":{{ canonical_url | append: '#faqs' | json }},"mainEntity":[{% for entry in grooves_faq_entries offset: 1 %}{% assign question_part = entry | split: '</h3>' | first | split: '>' | last | strip %}{% assign answer_part = entry | split: '</h3><p>' | last | split: '</p>' | first | strip %}{% unless forloop.first %},{% endunless %}{"@type":"Question","name":{{ question_part | json }},"acceptedAnswer":{"@type":"Answer","text":{{ answer_part | json }}}}{% endfor %}]}</script>
{% endif %}
{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
