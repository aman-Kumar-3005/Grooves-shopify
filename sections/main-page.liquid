

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}

{% if page.handle == 'about-grooves' %}
<section aria-labelledby="grooves-company-information">
<h2 id="grooves-company-information">Grooves Lifestyle in India</h2>
<p>Grooves Lifestyle is an audio and mobile-accessories brand serving customers in India. This website is operated by Mewalt Electronics Private Limited.</p>
<p>Explore <a href="/collections/earbuds">wireless earbuds</a>, <a href="/collections/headphones">headphones</a>, <a href="/collections/neck-band">neckbands</a> and <a href="/collections/adaptor">charging adapters</a>. Specifications, availability and included accessories depend on the exact model.</p>
<h3 id="grooves-customer-support">How can I contact Grooves support?</h3>
<p>For product, order or warranty questions, email <a href="mailto:support@grooveslifestyle.com">support@grooveslifestyle.com</a> or call <a href="tel:+919216921661">+91 9216921661</a>. Read the <a href="/policies/shipping-policy">shipping policy</a> and <a href="/policies/refund-policy">refund policy</a> for the published terms.</p>
<p>Official website: <a href="{{ request.origin }}">grooveslifestyle.com</a>. Find Grooves Audio &amp; Lifestyle on <a href="https://in.linkedin.com/company/grooves-audio">LinkedIn</a>.</p>
</section>
{% endif %}

  </div>
</div>

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
