{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .press-slider-wrapper {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 1.5rem;
    overflow: hidden;
  }

  .press-header-area {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    gap: 15px;
  }

  .press-title-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .press-subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.subtitle_color }};
  }

  .press-subtitle svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .press-title {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    margin: 0;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }

  /* Navigation Arrows */
  .press-nav-arrows {
    display: flex;
    gap: 10px;
  }

  .press-nav-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid #eaeaea;
    cursor: pointer;
    color: #333;
    transition: all 0.3s ease;
  }

  .press-nav-btn:hover {
    background-color: #f5f5f5;
    transform: scale(1.05);
  }

  .press-nav-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Slider Track */
  .press-slider-track {
    display: flex;
    gap: {{ section.settings.logo_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    scroll-behavior: smooth;
    padding-bottom: 10px;
  }

  .press-slider-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .press-logo-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 15px;
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    transition: transform 0.3s ease;
  }

  .press-logo-item:hover {
    transform: translateY(-3px);
  }

  .press-logo-item img,
  .press-logo-item svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 768px) {
    .press-title {
      font-size: 24px;
    }
    .press-logo-item {
      width: {{ section.settings.logo_width_mobile }}px;
      height: {{ section.settings.logo_height_mobile }}px;
    }
    .press-nav-arrows {
      display: none; /* Hide arrows on mobile, allow touch swipe */
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" id="PressSection-{{ section.id }}">
  <div class="press-slider-wrapper">
    
    <div class="press-header-area">
      <div class="press-title-box">
        {%- if section.settings.subtitle != blank -%}
          <div class="press-subtitle">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            {{ section.settings.subtitle }}
          </div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="press-title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>

      <div class="press-nav-arrows">
        <button class="press-nav-btn prev-btn" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="press-nav-btn next-btn" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="press-slider-track" id="PressTrack-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="press-logo-item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" target="_blank" rel="noopener" style="display: block; width: 100%; height: 100%;">
          {%- endif -%}
          
          {%- if block.settings.image != blank -%}
            {%- assign press_logo_alt = block.settings.image.alt | default: 'Featured publication logo' -%}
            <img
              src="{{ block.settings.image | image_url: width: 240 }}"
              srcset="{{ block.settings.image | image_url: width: 160 }} 160w, {{ block.settings.image | image_url: width: 240 }} 240w, {{ block.settings.image | image_url: width: 320 }} 320w"
              sizes="(max-width: 768px) {{ section.settings.logo_width_mobile }}px, {{ section.settings.logo_width }}px"
              alt="{{ press_logo_alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              decoding="async"
            >
          {%- else -%}
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('PressSection-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('#PressTrack-{{ section.id }}');
    const prevBtn = section.querySelector('.prev-btn');
    const nextBtn = section.querySelector('.next-btn');

    if (track && prevBtn && nextBtn) {
      const scrollAmount = 250; // Adjust scroll distance per click

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Press Logos Slider",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / Badge Text",
      "default": "Places where we have been featured"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#3b82f6"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "In The Press"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Image Size Settings (Desktop)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image Size Settings (Mobile)"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 80,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo Width (Mobile)",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height (Mobile)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Card Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Logo Box Background (Optional)",
      "default": "transparent",
      "info": "Use #ffffff for a white box behind logos."
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Logo Box Corner Radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "logo_item",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Article (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Logos Slider",
      "blocks": [
        { "type": "logo_item" },
        { "type": "logo_item" },
        { "type": "logo_item" },
        { "type": "logo_item" },
        { "type": "logo_item" }
      ]
    }
  ]
}
{% endschema %}
