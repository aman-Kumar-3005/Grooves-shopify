<div class="tr-announcement-bar" id="tr-announcement-{{ section.id }}">
  <div class="tr-container">
    <div class="tr-announcement-row">
      <!-- 3-Part Promo (Exact from Screenshot 1 & 2) -->
      <div class="tr-announcement-main-promo">
        <!-- Left Block -->
        <div class="tr-ann-block tr-ann-left">
          <span>{{ section.settings.left_line_1 | default: 'FLAT 10% OFF ON' }}</span>
          <span>{{ section.settings.left_line_2 | default: 'PREPAID ORDERS' }}</span>
        </div>

        <!-- Middle Code Block (Neon Lime Stacked) -->
        <div class="tr-ann-block tr-ann-code">
          <span class="tr-code-sub">{{ section.settings.code_word_1 | default: 'USE' }}</span>
          <span class="tr-code-sub">{{ section.settings.code_word_2 | default: 'CODE:' }}</span>
          <span class="tr-code-main">{{ section.settings.code_word_3 | default: 'TR10' }}</span>
        </div>

        <!-- Vertical Divider -->
        <span class="tr-ann-divider">|</span>

        <!-- Right Block -->
        <div class="tr-ann-block tr-ann-right">
          <span>{{ section.settings.right_line_1 | default: 'FREE SHIPPING' }}</span>
          <span>{{ section.settings.right_line_2 | default: 'ACROSS INDIA' }}</span>
        </div>
      </div>

      <!-- Desktop Extra EMI Banner (Right side as seen in Desktop Screenshot 2) -->
      {% if section.settings.show_emi %}
        <div class="tr-announcement-emi-box">
          <span class="tr-emi-icon">💳</span>
          <span class="tr-emi-lime">0% Interest</span>
          <span class="tr-emi-text">on EMI</span>
          <span class="tr-emi-lime">No-Cost EMI</span>
          <span class="tr-emi-text">Available!!</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  // Hide announcement bar smoothly on scroll down (Desktop & Mobile)
  (function() {
    function onScroll() {
      if (window.pageYOffset > 15) {
        document.body.classList.add('tr-header-scrolled');
      } else {
        document.body.classList.remove('tr-header-scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "TR Announcement Bar",
  "settings": [
    {
      "type": "header",
      "content": "Left Block"
    },
    {
      "type": "text",
      "id": "left_line_1",
      "label": "Left Line 1",
      "default": "FLAT 10% OFF ON"
    },
    {
      "type": "text",
      "id": "left_line_2",
      "label": "Left Line 2",
      "default": "PREPAID ORDERS"
    },
    {
      "type": "header",
      "content": "Middle Coupon Block (Neon Lime)"
    },
    {
      "type": "text",
      "id": "code_word_1",
      "label": "Word 1",
      "default": "USE"
    },
    {
      "type": "text",
      "id": "code_word_2",
      "label": "Word 2",
      "default": "CODE:"
    },
    {
      "type": "text",
      "id": "code_word_3",
      "label": "Code",
      "default": "TR10"
    },
    {
      "type": "header",
      "content": "Right Block"
    },
    {
      "type": "text",
      "id": "right_line_1",
      "label": "Right Line 1",
      "default": "FREE SHIPPING"
    },
    {
      "type": "text",
      "id": "right_line_2",
      "label": "Right Line 2",
      "default": "ACROSS INDIA"
    },
    {
      "type": "header",
      "content": "Desktop EMI Banner"
    },
    {
      "type": "checkbox",
      "id": "show_emi",
      "label": "Show EMI Banner on Desktop",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "TR Announcement Bar"
    }
  ]
}
{% endschema %}
