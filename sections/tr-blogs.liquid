<section class="tr-blogs-section" id="tr-blogs-{{ section.id }}" style="padding-top: {{ section.settings.padding_top | default: 20 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;">
  <div class="tr-container">
    {% if section.settings.badge_title != blank %}
      <div class="tr-section-badge-wrap">
        <span class="tr-section-pill">{{ section.settings.badge_title }}</span>
      </div>
    {% endif %}

    {% assign real_blog = blogs[section.settings.blog] %}
    {% assign limit_count = section.settings.articles_count | default: 4 %}

    <div class="tr-blogs-grid">
      {% if real_blog != blank and real_blog.articles_count > 0 %}
        {% for article in real_blog.articles limit: limit_count %}
          <article class="tr-blog-card">
            <a href="{{ article.url }}" class="tr-blog-img-wrap">
              {% if article.image %}
                <img 
                  src="{{ article.image | image_url: width: 600 }}" 
                  alt="{{ article.title }}" 
                  loading="lazy"
                  width="400"
                  height="250"
                >
              {% else %}
                <img 
                  src="{{ 'grooves-blog-open-ear.jpg' | asset_url }}" 
                  alt="{{ article.title }}" 
                  loading="lazy"
                  width="400"
                  height="250"
                >
              {% endif %}
            </a>
            <div class="tr-blog-content">
              <span style="font-size: 11px; color: var(--tr-accent); font-weight: 700; text-transform: uppercase;">
                {{ article.tags.first | default: 'AUDIO GUIDE' }}
              </span>
              <h3 class="tr-blog-title">
                <a href="{{ article.url }}" style="color: inherit; text-decoration: none;">
                  {{ article.title }}
                </a>
              </h3>
              <p style="color: #888888; font-size: 13px; margin: 0; line-height: 1.5;">
                {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
              </p>
              <a href="{{ article.url }}" class="tr-blog-link">
                Read more &rarr;
              </a>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {%- liquid
            assign blk_article = articles[block.settings.article]
            if blk_article != blank
              assign art_title = blk_article.title
              assign art_link = blk_article.url
              assign art_desc = blk_article.excerpt_or_content | strip_html | truncatewords: 20
              assign art_cat = blk_article.tags.first | default: 'AUDIO GUIDE'
              if block.settings.image != blank
                assign art_img = block.settings.image | image_url: width: 600
              elsif block.settings.image_url != blank
                if block.settings.image_url contains 'http' or block.settings.image_url contains '//'
                  assign art_img = block.settings.image_url
                else
                  assign art_img = block.settings.image_url | replace: 'campaign/', '' | asset_url
                endif
              elsif blk_article.image
                assign art_img = blk_article.image | image_url: width: 600
              else
                assign art_img = 'grooves-blog-open-ear.jpg' | asset_url
              endif
            else
              assign art_title = block.settings.title
              assign art_link = block.settings.link | default: '/blogs/news'
              assign art_desc = block.settings.excerpt
              assign art_cat = block.settings.category | default: 'AUDIO GUIDE'
              if block.settings.image != blank
                assign art_img = block.settings.image | image_url: width: 600
              elsif block.settings.image_url != blank
                if block.settings.image_url contains 'http' or block.settings.image_url contains '//'
                  assign art_img = block.settings.image_url
                else
                  assign art_img = block.settings.image_url | replace: 'campaign/', '' | asset_url
                endif
              else
                assign art_img = 'grooves-blog-open-ear.jpg' | asset_url
              endif
            endif
          -%}
          <article class="tr-blog-card" {{ block.shopify_attributes }}>
            <a href="{{ art_link }}" class="tr-blog-img-wrap">
              <img 
                src="{{ art_img }}" 
                alt="{{ art_title }}" 
                loading="lazy"
                width="400"
                height="250"
              >
            </a>
            <div class="tr-blog-content">
              <span style="font-size: 11px; color: var(--tr-accent); font-weight: 700; text-transform: uppercase;">
                {{ art_cat }}
              </span>
              <h3 class="tr-blog-title">
                <a href="{{ art_link }}" style="color: inherit; text-decoration: none;">
                  {{ art_title }}
                </a>
              </h3>
              <p style="color: #888888; font-size: 13px; margin: 0; line-height: 1.5;">
                {{ art_desc }}
              </p>
              <a href="{{ art_link }}" class="tr-blog-link">
                Read more &rarr;
              </a>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grooves Blogs & News",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "GROOVES TECH & LIFESTYLE JOURNAL"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Dynamic Blog"
    },
    {
      "type": "range",
      "id": "articles_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Articles to Display",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Blog Article Fallback",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Select Specific Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Article Image (Upload)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article Title Fallback",
          "default": "Why GaN Fast Charging Is the Future of Everyday Power"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Tag Fallback",
          "default": "TECH ESSENTIALS"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt Fallback",
          "default": "Explore how Gallium Nitride (GaN) components deliver faster, cooler, and more compact charging for laptops, phones, and power banks."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL Fallback",
          "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link Fallback"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooves Blogs & News",
      "blocks": [
        {
          "type": "article",
          "settings": {
            "title": "Why GaN Fast Charging Is the Future of Everyday Power",
            "category": "TECH ESSENTIALS",
            "excerpt": "Explore how Gallium Nitride (GaN) components deliver faster, cooler, and more compact charging for laptops, phones, and power banks.",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
          }
        },
        {
          "type": "article",
          "settings": {
            "title": "Hybrid ANC vs ENC: How Grooves Earbuds Isolate Noise Perfectly",
            "category": "AUDIO LAB",
            "excerpt": "Understand how dual feedforward and feedback microphones cancel up to 35dB of distractions for pristine acoustics.",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesNews.png?v=1782984314"
          }
        }
      ]
    }
  ]
}
{% endschema %}
