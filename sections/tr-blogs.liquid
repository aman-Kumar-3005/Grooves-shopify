<section class="tr-blogs-section" id="tr-blogs-{{ section.id }}" style="padding: 20px 0 40px;">
  <div class="tr-container">
    <div class="tr-section-badge-wrap">
      <span class="tr-section-pill">{{ section.settings.badge_title | default: 'Blogs' }}</span>
    </div>

    {% assign real_blog = blogs[section.settings.blog] %}

    <div class="tr-blogs-grid">
      {% if real_blog != blank and real_blog.articles_count > 0 %}
        {% for article in real_blog.articles limit: 4 %}
          <article class="tr-blog-card">
            <a href="{{ article.url }}" class="tr-blog-img-wrap">
              {% if article.image %}
                <img 
                  src="{{ article.image | image_url: width: 600 }}" 
                  alt="{{ article.title }}" 
                  loading="lazy"
                >
              {% else %}
                <img 
                  src="https://acwo.com/cdn/shop/articles/Best_OWS_Earbuds.webp?v=1789979303&width=533" 
                  alt="{{ article.title }}" 
                  loading="lazy"
                >
              {% endif %}
            </a>
            <div class="tr-blog-content">
              <span style="font-size: 11px; color: var(--tr-accent); font-weight: 700; text-transform: uppercase;">
                {{ article.tags.first | default: 'AUDIO GUIDE' }}
              </span>
              <h3 class="tr-blog-title">
                <a href="{{ article.url }}" style="color: inherit; text-decoration: none;">
                  {{ article.title }}
                </a>
              </h3>
              <p style="color: #888888; font-size: 13px; margin: 0; line-height: 1.5;">
                {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
              </p>
              <a href="{{ article.url }}" class="tr-blog-link">
                Read more &rarr;
              </a>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <article class="tr-blog-card">
            <a href="{{ block.settings.link | default: '/blogs/news' }}" class="tr-blog-img-wrap">
              <img 
                src="{{ block.settings.image_url }}" 
                alt="{{ block.settings.title }}" 
                loading="lazy"
              >
            </a>
            <div class="tr-blog-content">
              <span style="font-size: 11px; color: var(--tr-accent); font-weight: 700; text-transform: uppercase;">
                {{ block.settings.category | default: 'AUDIO GUIDE' }}
              </span>
              <h3 class="tr-blog-title">
                <a href="{{ block.settings.link | default: '/blogs/news' }}" style="color: inherit; text-decoration: none;">
                  {{ block.settings.title }}
                </a>
              </h3>
              <p style="color: #888888; font-size: 13px; margin: 0; line-height: 1.5;">
                {{ block.settings.excerpt }}
              </p>
              <a href="{{ block.settings.link | default: '/blogs/news' }}" class="tr-blog-link">
                Read more &rarr;
              </a>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TR Blogs",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "Blogs"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Dynamic Blog"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Blog Article Fallback",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Article Title",
          "default": "Best Open Ear Earbuds in 2026: Top Picks"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category / Tag",
          "default": "TECH & AUDIO"
        },
        {
          "type": "text",
          "id": "excerpt",
          "label": "Short Excerpt",
          "default": "Looking for the most comfortable open sound experience? Here is our comprehensive guide."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Featured Image URL",
          "default": "https://acwo.com/cdn/shop/articles/Best_OWS_Earbuds.webp?v=1789979303&width=533"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TR Blogs"
    }
  ]
}
{% endschema %}
