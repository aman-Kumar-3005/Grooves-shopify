{% assign journal = blogs[section.settings.blog] %}<section class="tr-blogs-section upgrade-journal"><div class="tr-container"><div class="upgrade-section-head"><div><span class="upgrade-eyebrow">THE GROOVES JOURNAL</span><h2>Good choices start here.</h2><p>A little guidance for your next everyday essential.</p></div>{% if journal.articles_count > 0 %}<a class="upgrade-text-link" href="{{ journal.url }}">Read the journal ↗</a>{% endif %}</div><div class="tr-blogs-grid">{% if journal.articles_count > 0 %}{% for article in journal.articles limit: 3 %}<article class="tr-blog-card"><a href="{{ article.url }}" class="tr-blog-img-wrap">{% if article.image %}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}{% else %}<span class="upgrade-guide-number">0{{ forloop.index }}</span>{% endif %}</a><div class="tr-blog-content"><span class="upgrade-eyebrow">{{ article.tags.first | default: 'GUIDES & STORIES' }}</span><h3 class="tr-blog-title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p class="tr-blog-desc">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p><a class="upgrade-text-link" href="{{ article.url }}">Read story ↗</a></div></article>{% endfor %}{% else %}{% assign guide_titles = 'Find your listening format,Choose your earbuds,Check charging compatibility' | split: ',' %}{% assign guide_links = '#compare-audio-formats,#how-do-you-choose-wireless-earbuds,#check-accessory-compatibility' | split: ',' %}{% assign guide_descriptions = 'Compare the physical differences between earbuds, neckbands and headphones.|Consider fit, connection and the exact model specifications before choosing.|Match your device, cable and charging protocol before ordering.' | split: '|' %}{% for title in guide_titles %}<article class="tr-blog-card upgrade-guide"><a href="{{ guide_links[forloop.index0] }}" class="tr-blog-img-wrap" aria-label="{{ title }}"><span class="upgrade-guide-number">0{{ forloop.index }}</span><span class="upgrade-guide-arrow" aria-hidden="true">↗</span></a><div class="tr-blog-content"><span class="upgrade-eyebrow">BUYING GUIDE</span><h3 class="tr-blog-title"><a href="{{ guide_links[forloop.index0] }}">{{ title }}</a></h3><p class="tr-blog-desc">{{ guide_descriptions[forloop.index0] }}</p><a class="upgrade-text-link" href="{{ guide_links[forloop.index0] }}">Explore the guide ↗</a></div></article>{% endfor %}{% endif %}</div></div></section>
{% schema %}
{
  "name": "Grooves Blogs & News",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "BLOGS"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Dynamic Blog",
      "info": "Select your store blog here. If left blank, it automatically pulls from your 'News' blog."
    },
    {
      "type": "range",
      "id": "articles_count",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Total Articles to Load",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout & Carousel Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Cards per row (Desktop)",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_carousel",
      "label": "Enable Swipe/Carousel on Desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Cards per row (Mobile)",
      "default": 1,
      "info": "Set to 1 or 2 for best visual experience."
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Enable Swipe/Carousel on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Badge & Links)",
      "default": "#45A8E8"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#141414"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Blog Article Fallback",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Select Specific Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Article Image (Upload)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article Title Fallback",
          "default": "BEST OPEN EAR EARBUDS IN 2026"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Tag Fallback",
          "default": "TECH & AUDIO"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt Fallback",
          "default": "Discover how open-ear audio tech delivers spatial acoustics while keeping you aware of your surroundings."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL Fallback",
          "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link Fallback"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooves Blogs & News",
      "blocks": [
        {
          "type": "article",
          "settings": {
            "title": "BEST OPEN EAR EARBUDS IN 2026",
            "category": "TECH & AUDIO",
            "excerpt": "Discover how open-ear audio tech delivers spatial acoustics while keeping you aware of your surroundings.",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
          }
        },
        {
          "type": "article",
          "settings": {
            "title": "GROOVES TURBO GAN: NEXT-GEN CHARGING HUB",
            "category": "INNOVATION",
            "excerpt": "A high-speed GaN fast charger engineered with portable battery backup and smart multi-device protection.",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesNews.png?v=1782984314"
          }
        },
        {
          "type": "article",
          "settings": {
            "title": "BEST EARBUDS UNDER ₹5000 IN INDIA",
            "category": "BUYER GUIDE",
            "excerpt": "Compare features, battery life, quad-mic ENC, and ultra low gaming latency across top contenders.",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
          }
        },
        {
          "type": "article",
          "settings": {
            "title": "WHAT IS THE BEST SOUND SYSTEM FOR HOME?",
            "category": "HOME THEATRE",
            "excerpt": "Transform your entertainment room with deep bass soundbars and dedicated wireless subwoofers.",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesNews.png?v=1782984314"
          }
        }
      ]
    }
  ]
}
{% endschema %}
