<section class="tr-categories-section" id="tr-categories-{{ section.id }}">
  <div class="tr-container">
    <div class="tr-section-badge-wrap">
      <span class="tr-section-pill">{{ section.settings.badge_title | default: 'Shop By Categories' }}</span>
    </div>

    <div class="tr-categories-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign col = block.settings.collection
          if col != blank
            assign c_title = col.title
            assign c_url = col.url
            if col.featured_image
              assign c_img = col.featured_image | image_url: width: 200
            elsif col.products.first.featured_image
              assign c_img = col.products.first.featured_image | image_url: width: 200
            else
              assign c_img = block.settings.image_url
            endif
          else
            assign c_title = block.settings.title
            assign c_url = block.settings.url | default: '/collections/all'
            assign c_img = block.settings.image_url
          endif
        -%}
        <a href="{{ c_url }}" class="tr-category-card">
          <div class="tr-category-icon-box">
            <img 
              src="{{ c_img }}" 
              alt="{{ c_title }}" 
              loading="lazy"
            >
          </div>
          <span class="tr-category-name">{{ c_title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TR Categories",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "Shop By Categories"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection (Dynamic)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name Fallback",
          "default": "Earbuds"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Icon Image URL Fallback",
          "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/bestseller.jpg?v=1781096198"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Category Link Fallback"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TR Categories"
    }
  ]
}
{% endschema %}
