<section class="tr-dual-speakers-section upgrade-spotlights"><div class="tr-container"><div class="upgrade-section-head"><div><span class="upgrade-eyebrow">IN FOCUS</span><h2>{{ section.settings.spotlight_heading | escape }}</h2></div></div><div class="upgrade-spotlight-grid">{% assign featured_handles = 'grooves-alpha-200-with-anc,grooves-signature2-0' | split: ',' %}{% for handle in featured_handles %}{% if forloop.first %}{% assign product = section.settings.featured_product_1 %}{% else %}{% assign product = section.settings.featured_product_2 %}{% endif %}{% if product == blank %}{% assign product = all_products[handle] %}{% endif %}{% if product != blank %}<article class="upgrade-spotlight"><div class="upgrade-spotlight-copy"><span class="upgrade-eyebrow">{% if forloop.first %}WIRELESS AUDIO{% else %}HEADPHONES{% endif %}</span><h3>{{ product.title | escape }}</h3><p>{{ product.price | money }}</p><a href="{{ product.url }}" class="upgrade-button">Explore product ↗</a></div><a href="{{ product.url }}" class="upgrade-spotlight-image" aria-label="{{ product.title | escape }}">{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320,500,800', sizes: '(max-width:749px) 70vw, 30vw', alt: product.title }}</a></article>{% endif %}{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Grooves Audio Spotlights",
  "settings": [
    {
      "type": "text",
      "id": "spotlight_heading",
      "label": "Spotlight heading",
      "default": "Meet your next everyday essential."
    },
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "First spotlight product"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Second spotlight product"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 30
    },
    {
      "type": "header",
      "content": "Speaker Promo Card 1"
    },
    {
      "type": "image_picker",
      "id": "speaker1_img",
      "label": "Speaker 1 Image (Upload)"
    },
    {
      "type": "text",
      "id": "speaker1_image",
      "label": "Or Speaker 1 Image URL (Fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Carniwal_515_Chhetri.webp?v=1773487465"
    },
    {
      "type": "text",
      "id": "speaker1_btn",
      "label": "Button Label",
      "default": "BUY NOW"
    },
    {
      "type": "url",
      "id": "speaker1_link",
      "label": "Speaker 1 Link"
    },
    {
      "type": "header",
      "content": "Speaker Promo Card 2"
    },
    {
      "type": "image_picker",
      "id": "speaker2_img",
      "label": "Speaker 2 Image (Upload)"
    },
    {
      "type": "text",
      "id": "speaker2_image",
      "label": "Or Speaker 2 Image URL (Fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Carniwal_717_Harsh.webp?v=1773487412"
    },
    {
      "type": "text",
      "id": "speaker2_btn",
      "label": "Button Label",
      "default": "BUY NOW"
    },
    {
      "type": "url",
      "id": "speaker2_link",
      "label": "Speaker 2 Link"
    }
  ],
  "blocks": [
    {
      "type": "speaker_card",
      "name": "Custom Speaker Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Speaker Banner Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Or Image URL"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Link To Product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Or Custom URL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title / Alt Text",
          "default": "Grooves Audio Speaker"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "BUY NOW"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooves Dual Speakers"
    }
  ]
}
{% endschema %}
