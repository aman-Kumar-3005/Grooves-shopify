<section class="tr-explore-range-section" id="tr-explore-{{ section.id }}" style="padding: 20px 0 40px;">
  <div class="tr-container">
    <div style="text-align: center; margin-bottom: 30px;">
      <div class="tr-section-title-box">
        <h2>{{ section.settings.section_title | default: "EXPLORE INDIA'S FIRST AUDIO RANGE" }}</h2>
      </div>
    </div>

    <div class="tr-explore-range-grid">
      <!-- Large Hero Feature Card (Left) -->
      <div class="tr-explore-hero-card">
        <img 
          src="{{ section.settings.hero_image | default: 'https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Home-DwOTSFire-Prime-web.webp?v=1745321002' }}" 
          alt="{{ section.settings.hero_title | default: 'DwOTS 107 Pro' }}"
          class="tr-explore-hero-bg"
          loading="lazy"
        >
        <div class="tr-explore-hero-content">
          <span style="color: var(--tr-accent); font-weight: 800; font-size: 13px; text-transform: uppercase;">
            {{ section.settings.hero_tag | default: 'SUPER FAST CHARGING' }}
          </span>
          <h3 style="font-size: 24px; font-weight: 900; color: #fff; margin: 6px 0 14px;">
            {{ section.settings.hero_title | default: 'DwOTS 107 Pro - Fast Charging Wireless Earbuds' }}
          </h3>
          <a href="{{ section.settings.hero_link | default: '/products/dwots-fire-wireless-charging-earbuds-moon-white' }}" class="tr-btn tr-btn-accent" style="padding: 10px 24px;">
            {{ section.settings.hero_btn_text | default: 'BUY NOW' }}
          </a>
        </div>
      </div>

      <!-- 4-Grid Cards (Right) -->
      <div class="tr-explore-right-grid">
        {% for block in section.blocks %}
          <div class="tr-product-mini-card">
            <a href="{{ block.settings.link | default: '/products/dwots-fire-wireless-charging-earbuds-moon-white' }}">
              <img 
                src="{{ block.settings.image_url }}" 
                alt="{{ block.settings.title }}" 
                class="tr-product-thumb"
                loading="lazy"
              >
            </a>
            <div class="tr-product-info">
              <h4 class="tr-product-title">{{ block.settings.title }}</h4>
              <div class="tr-product-price-row">
                <span class="tr-price-current">{{ block.settings.price }}</span>
                {% if block.settings.compare_price != blank %}
                  <span class="tr-price-compare">{{ block.settings.compare_price }}</span>
                  <span class="tr-price-discount">{{ block.settings.discount_tag }}</span>
                {% endif %}
              </div>
              <a href="{{ block.settings.link | default: '/products/dwots-fire-wireless-charging-earbuds-moon-white' }}" class="tr-btn tr-btn-accent tr-card-btn">
                BUY NOW
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TR Explore Range",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "EXPLORE INDIA'S FIRST AUDIO RANGE"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Product Title",
      "default": "DwOTS 107 Pro - Fast Charging Wireless Earbuds"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Hero Tagline",
      "default": "SUPER FAST CHARGING"
    },
    {
      "type": "text",
      "id": "hero_image",
