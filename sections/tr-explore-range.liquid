          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "DwOTS 107 Pro",
            "price": "₹1,199",
            "compare_price": "₹3,999",
            "discount_tag": "70% OFF",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/DwOTS_107_New.webp?v=1770725157"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "DwOTS Prime",
            "price": "₹1,299",
            "compare_price": "₹4,499",
            "discount_tag": "71% OFF",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/home-Fire-new.webp?v=1770725157"
