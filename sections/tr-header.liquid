{%- liquid
  assign logo_image = section.settings.logo | default: settings.logo
  assign logo_url = section.settings.logo_url
  assign logo_w_desk = section.settings.logo_width | default: 130
  assign logo_w_mob = section.settings.logo_width_mobile | default: 85

  assign header_menu = section.settings.menu | default: linklists['main-menu']
  if header_menu != blank and header_menu.links.size > 0
    assign nav_links = header_menu.links
  elsif linklists['main-menu'].links.size > 0
    assign nav_links = linklists['main-menu'].links
  endif
-%}

<header class="tr-header" id="tr-header-{{ section.id }}" style="--tr-logo-w-desk: {{ logo_w_desk }}px; --tr-logo-w-mob: {{ logo_w_mob }}px;">
  <div class="tr-container">
    <div class="tr-header-inner">

      <!-- Left Side: Mobile Hamburger & Search / Desktop Logo -->
      <div class="tr-header-left">
        <!-- Mobile Menu Toggle Button (Visible on mobile/tablet) -->
        <button class="tr-mobile-menu-toggle" type="button" aria-label="Open Navigation Menu" onclick="document.body.classList.toggle('tr-mobile-nav-active')">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- Mobile Search Button (Exact match for mobile screenshot next to hamburger) -->
        <a href="/search" class="tr-header-icon-btn tr-mobile-search-btn" aria-label="Search">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Desktop Logo Link (Shown on left on desktop) -->
        <a href="/" class="tr-logo-link tr-desktop-logo">
          {% if logo_image != blank %}
            <img 
              src="{{ logo_image | image_url: width: 600 }}" 
              alt="{{ shop.name | default: section.settings.brand_name | default: 'Grooves Lifestyle' }}"
              class="tr-logo-image"
              width="{{ logo_w_desk }}"
              height="auto"
              loading="eager"
            >
          {% elsif logo_url != blank %}
            <img 
              src="{{ logo_url }}" 
              alt="{{ section.settings.brand_name | default: 'Grooves Lifestyle' }}"
              class="tr-logo-image"
              width="{{ logo_w_desk }}"
              height="auto"
              loading="eager"
            >
          {% else %}
            <div class="tr-brand-wordmark">
              <span class="tr-logo-text">{{ section.settings.brand_name | default: 'Grooves Lifestyle' }}</span>
              <span class="tr-logo-reg">&reg;</span>
              <span class="tr-soundwave-bars">
                <span></span><span></span><span></span><span></span><span></span>
              </span>
            </div>
          {% endif %}
        </a>
      </div>

      <!-- Center: Mobile Centered Logo / Desktop Navigation Menu -->
      <div class="tr-header-center">
        <!-- Mobile Centered Brand Logo (Exact match for mobile screenshot in center) -->
        <a href="/" class="tr-logo-link tr-mobile-logo">
          {% if logo_image != blank %}
            <img 
              src="{{ logo_image | image_url: width: 600 }}" 
              alt="{{ shop.name | default: section.settings.brand_name | default: 'Grooves Lifestyle' }}"
              class="tr-logo-image"
              width="{{ logo_w_mob }}"
              height="auto"
              loading="eager"
            >
          {% elsif logo_url != blank %}
            <img 
              src="{{ logo_url }}" 
              alt="{{ section.settings.brand_name | default: 'Grooves Lifestyle' }}"
              class="tr-logo-image"
              width="{{ logo_w_mob }}"
              height="auto"
              loading="eager"
            >
          {% else %}
            <div class="tr-brand-wordmark">
              <span class="tr-logo-text">{{ section.settings.brand_name | default: 'Grooves Lifestyle' }}</span>
              <span class="tr-logo-reg">&reg;</span>
              <span class="tr-soundwave-bars">
                <span></span><span></span><span></span><span></span><span></span>
              </span>
            </div>
          {% endif %}
        </a>

        <!-- Desktop Navigation Menu (Connected to Shopify Main Menu) -->
        <nav class="tr-nav-menu" aria-label="Main Navigation">
          {%- if nav_links != blank and nav_links.size > 0 -%}
            {% for link in nav_links %}
              <a 
                href="{{ link.url }}" 
                class="tr-nav-link {% if link.current or forloop.first %}active{% endif %}"
              >
                {{ link.title }}
              </a>
            {% endfor %}
          {%- elsif section.blocks.size > 0 -%}
            {% for block in section.blocks %}
              {% if block.type == 'nav_item' %}
                <a 
                  href="{{ block.settings.url | default: '/collections/all' }}" 
                  class="tr-nav-link {% if block.settings.is_active or forloop.first %}active{% endif %}"
                >
                  {{ block.settings.title }}
                </a>
              {% endif %}
            {% endfor %}
          {%- else -%}
            <a href="/" class="tr-nav-link active">Home</a>
            <a href="/collections/all" class="tr-nav-link">Accessories</a>
            <a href="/collections/all" class="tr-nav-link">Combo</a>
            <a href="/collections/all" class="tr-nav-link">Earbuds</a>
            <a href="/collections/all" class="tr-nav-link">Headphones</a>
            <a href="/pages/contact" class="tr-nav-link">Contact</a>
            <a href="/pages/about-us" class="tr-nav-link">About Us</a>
          {%- endif -%}
        </nav>
      </div>

      <!-- Right: Action Icons (Account with ⚡ & Bag with Red 0 Badge) -->
      <div class="tr-header-actions">
        <!-- Desktop Search Icon -->
        <a href="/search" class="tr-header-icon-btn tr-desktop-search-btn" aria-label="Search">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Account with Orange Lightning Badge (Exact match for screenshot) -->
        <a href="/account" class="tr-header-icon-btn tr-account-icon-btn" aria-label="Account">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="tr-lightning-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#ffa200" stroke="#ffa200" stroke-width="1">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </span>
        </a>

        <!-- Shopping Bag with Circular Red Count Badge (Exact match for screenshot) -->
        <a href="/cart" class="tr-header-icon-btn tr-cart-icon-btn" aria-label="Cart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 7v13a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7"></path>
            <path d="M9 7V5a3 3 0 0 1 6 0v2"></path>
          </svg>
          <span class="tr-cart-count">{{ cart.item_count | default: 0 }}</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Mobile Slideout Navigation Drawer (Connected to Shopify Main Menu) -->
  <div class="tr-mobile-drawer-overlay" onclick="document.body.classList.remove('tr-mobile-nav-active')"></div>
  <div class="tr-mobile-drawer" id="tr-mobile-drawer">
    <div class="tr-mobile-drawer-header">
      <div class="tr-brand-wordmark">
        <span class="tr-logo-text">{{ section.settings.brand_name | default: 'Grooves Lifestyle' }}</span>
        <span class="tr-logo-reg">&reg;</span>
        <span class="tr-soundwave-bars">
          <span></span><span></span><span></span><span></span><span></span>
        </span>
      </div>
      <button class="tr-mobile-drawer-close" type="button" aria-label="Close Navigation Menu" onclick="document.body.classList.remove('tr-mobile-nav-active')">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="tr-mobile-drawer-nav">
      {%- if nav_links != blank and nav_links.size > 0 -%}
        {% for link in nav_links %}
          <a href="{{ link.url }}" class="tr-mobile-drawer-link {% if link.current or forloop.first %}active{% endif %}">
            <span>{{ link.title }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        {% endfor %}
      {%- elsif section.blocks.size > 0 -%}
        {% for block in section.blocks %}
          {% if block.type == 'nav_item' %}
            <a href="{{ block.settings.url | default: '/collections/all' }}" class="tr-mobile-drawer-link {% if block.settings.is_active or forloop.first %}active{% endif %}">
              <span>{{ block.settings.title }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          {% endif %}
        {% endfor %}
      {%- else -%}
        <a href="/" class="tr-mobile-drawer-link active"><span>Home</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/collections/all" class="tr-mobile-drawer-link"><span>Earbuds</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/collections/all" class="tr-mobile-drawer-link"><span>Headphones</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/collections/all" class="tr-mobile-drawer-link"><span>Accessories</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/collections/all" class="tr-mobile-drawer-link"><span>Combo</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/collections/all" class="tr-mobile-drawer-link"><span>Power Bank</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/collections/all" class="tr-mobile-drawer-link"><span>Adaptor</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
        <a href="/pages/contact" class="tr-mobile-drawer-link"><span>Support</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
      {%- endif -%}
    </nav>
    <div class="tr-mobile-drawer-footer">
      <a href="/account" class="tr-mobile-drawer-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Account / Login</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Ensure header remains sticky while announcement hides smoothly
  (function() {
    function handleHeaderScroll() {
      if (window.pageYOffset > 15) {
        document.body.classList.add('tr-header-scrolled');
      } else {
        document.body.classList.remove('tr-header-scrolled');
      }
    }
    window.addEventListener('scroll', handleHeaderScroll, { passive: true });
    handleHeaderScroll();
  })();
</script>

{% schema %}
{
  "name": "Grooves Header",
  "settings": [
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_url",
      "label": "Or Logo Image URL (CDN / External)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Desktop Logo Width",
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Mobile Logo Width",
      "default": 85
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name Fallback",
      "default": "Grooves Lifestyle"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Custom Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Link Title",
          "default": "Wireless Audio"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Active (Shows Underline)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooves Header",
      "settings": {
        "menu": "main-menu"
      }
    }
  ]
}
{% endschema %}
