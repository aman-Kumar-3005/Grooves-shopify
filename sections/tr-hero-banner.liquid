<section class="tr-hero-slider" id="tr-hero-{{ section.id }}">
  <div class="tr-hero-slides-container">
    {% for block in section.blocks %}
      {%- liquid
        assign desk_img = block.settings.image
        assign default_hero_asset = 'campaign/grooves-audio-desktop-branded.png' | asset_url
        assign desk_url = block.settings.image_url | default: default_hero_asset
        assign mob_img = block.settings.mobile_image
        assign mob_url = block.settings.mobile_image_url
      -%}
      <div class="tr-hero-slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="tr-hero-slide-link">
          <div class="tr-hero-img-wrap">
            <picture>
              {% if mob_img != blank %}
                <source media="(max-width: 768px)" srcset="{{ mob_img | image_url: width: 800 }}">
              {% elsif mob_url != blank %}
                <source media="(max-width: 768px)" srcset="{{ mob_url }}">
              {% endif %}
              
              {% if desk_img != blank %}
                <img 
                  src="{{ desk_img | image_url: width: 2000 }}" 
                  alt="{{ block.settings.heading | default: 'Grooves Lifestyle Tech Essentials' }}" 
                  class="tr-hero-img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="1920"
                  height="auto"
                >
              {% else %}
                <img 
                  src="{{ desk_url }}" 
                  alt="{{ block.settings.heading | default: 'Grooves Lifestyle Tech Essentials' }}" 
                  class="tr-hero-img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="1920"
                  height="auto"
                >
              {% endif %}
            </picture>

            {% if block.settings.show_text_overlay and block.settings.heading != blank %}
              <div class="tr-hero-overlay">
                <div class="tr-hero-content">
                  {% if block.settings.badge_text != blank %}
                    <div class="tr-hero-discount-tag">
                      <span>⚡</span> {{ block.settings.badge_text }}
                    </div>
                  {% endif %}
                  <h2 class="tr-hero-title">{{ block.settings.heading }}</h2>
                  {% if block.settings.subheading != blank %}
                    <p class="tr-hero-desc">{{ block.settings.subheading }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank %}
                    <span class="tr-btn tr-btn-accent">
                      {{ block.settings.button_label }}
                    </span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="tr-hero-dots">
      {% for block in section.blocks %}
        <button 
          class="tr-hero-dot {% if forloop.first %}active{% endif %}" 
          data-target-slide="{{ forloop.index0 }}" 
          aria-label="Slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

<script>
  (function() {
    const slider = document.getElementById('tr-hero-{{ section.id }}');
    if (!slider) return;
    const slides = slider.querySelectorAll('.tr-hero-slide');
    const dots = slider.querySelectorAll('.tr-hero-dot');
    let current = 0;
    let timer = null;

    function showSlide(index) {
      slides.forEach((s, i) => s.classList.toggle('active', i === index));
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
      current = index;
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        showSlide(idx);
        resetTimer();
      });
    });

    function resetTimer() {
      if (timer) clearInterval(timer);
      if (slides.length > 1) {
        timer = setInterval(() => {
          let next = (current + 1) % slides.length;
          showSlide(next);
        }, 5500);
      }
    }
    resetTimer();

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        showSlide((current + 1) % slides.length);
        resetTimer();
      } else if (touchEndX - touchStartX > 50) {
        showSlide((current - 1 + slides.length) % slides.length);
        resetTimer();
      }
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Grooves Hero Banner",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
