<section class="tr-hero-slider" id="tr-hero-{{ section.id }}">
  <div class="tr-hero-slides-container">
    {% for block in section.blocks %}
      <div class="tr-hero-slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}">
        <div class="tr-hero-img-wrap">
          <img 
            src="{{ block.settings.image_url | default: 'https://cdn.shopify.com/s/files/1/0666/4870/3294/files/WEB_Hompage_SwIRL_Powerwebp.webp?v=1789044187' }}" 
            alt="{{ block.settings.heading | default: 'TR Audio & Tech' }}" 
            class="tr-hero-img"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
          {% if block.settings.heading != blank or block.settings.badge_text != blank %}
            <div class="tr-hero-overlay">
              <div class="tr-hero-content">
                {% if block.settings.badge_text != blank %}
                  <div class="tr-hero-discount-tag">
                    <span>⚡</span> {{ block.settings.badge_text }}
                  </div>
                {% endif %}
                <h1 class="tr-hero-title">{{ block.settings.heading }}</h1>
                {% if block.settings.subheading != blank %}
                  <p class="tr-hero-desc">{{ block.settings.subheading }}</p>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="tr-btn tr-btn-accent">
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="tr-hero-dots">
      {% for block in section.blocks %}
        <button 
          class="tr-hero-dot {% if forloop.first %}active{% endif %}" 
          data-target-slide="{{ forloop.index0 }}" 
          aria-label="Slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

<script>
  (function() {
    const slider = document.getElementById('tr-hero-{{ section.id }}');
    if (!slider) return;
    const slides = slider.querySelectorAll('.tr-hero-slide');
    const dots = slider.querySelectorAll('.tr-hero-dot');
    let current = 0;

    function showSlide(index) {
      slides.forEach((s, i) => s.classList.toggle('active', i === index));
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
      current = index;
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => showSlide(idx));
    });

    if (slides.length > 1) {
      setInterval(() => {
        let next = (current + 1) % slides.length;
        showSlide(next);
      }, 5500);
    }
  })();
</script>

{% schema %}
{
  "name": "TR Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "image_url",
          "label": "Slide Image URL (Placeholder)",
          "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/WEB_Hompage_SwIRL_Powerwebp.webp?v=1789044187"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Discount / Offer Badge",
          "default": "FLAT 10% OFF | USE CODE: GET10OFF"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SwIRL Series"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "The Rechargeable Power Fan"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "BUY NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TR Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/WEB_Hompage_SwIRL_Powerwebp.webp?v=1789044187",
            "heading": "SwIRL Series",
            "badge_text": "FLAT 10% OFF | USE CODE: GET10OFF",
            "button_label": "BUY NOW"
          }
        },
        {
          "type": "slide",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/WEB_Hompage_New_Bold.webp?v=1789042588",
            "heading": "DwOTS Bold",
            "badge_text": "NEXT-GEN AUDIO",
            "button_label": "EXPLORE NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
