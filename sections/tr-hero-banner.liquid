{%- liquid
  assign d_height = section.settings.desktop_height | default: 500
  assign d_fit = section.settings.desktop_image_fit | default: 'contain'
  assign d_width = section.settings.desktop_banner_width | default: 100

  assign m_height = section.settings.mobile_height | default: 350
  assign m_fit = section.settings.mobile_image_fit | default: 'contain'
  assign m_width = section.settings.mobile_banner_width | default: 100
  assign slider_bg = section.settings.slider_bg | default: '#000000'
-%}

<style>
  #tr-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: {{ d_width }}% !important;
    margin-inline: auto !important;
    background: {{ slider_bg }} !important;
    overflow: hidden;
  }

  #tr-hero-{{ section.id }} .tr-hero-slides-container {
    width: 100% !important;
    {% if d_fit == 'auto' %}
      height: auto !important;
      max-height: none !important;
    {% else %}
      height: {{ d_height }}px !important;
      max-height: {{ d_height }}px !important;
    {% endif %}
    overflow: hidden;
    position: relative;
  }

  #tr-hero-{{ section.id }} .tr-hero-slide {
    width: 100% !important;
    {% if d_fit == 'auto' %}
      height: auto !important;
    {% else %}
      height: {{ d_height }}px !important;
    {% endif %}
    display: none;
    position: relative;
  }

  #tr-hero-{{ section.id }} .tr-hero-slide.active {
    display: block !important;
  }

  #tr-hero-{{ section.id }} .tr-hero-slide-link {
    display: block !important;
    width: 100% !important;
    {% if d_fit == 'auto' %}
      height: auto !important;
    {% else %}
      height: {{ d_height }}px !important;
    {% endif %}
    text-decoration: none;
    color: inherit;
  }

  #tr-hero-{{ section.id }} .tr-hero-img-wrap {
    width: 100% !important;
    {% if d_fit == 'auto' %}
      height: auto !important;
      max-height: none !important;
    {% else %}
      height: {{ d_height }}px !important;
      max-height: {{ d_height }}px !important;
    {% endif %}
    position: relative;
    overflow: hidden;
    background: {{ slider_bg }} !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  #tr-hero-{{ section.id }} .tr-hero-img-wrap picture {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    {% if d_fit == 'auto' %}
      height: auto !important;
    {% else %}
      height: 100% !important;
    {% endif %}
  }

  #tr-hero-{{ section.id }} .tr-hero-img {
    display: block !important;
    object-position: center !important;
    {% if d_fit == 'auto' %}
      width: 100% !important;
      height: auto !important;
      max-height: none !important;
      object-fit: contain !important;
    {% elsif d_fit == 'contain' %}
      width: 100% !important;
      height: {{ d_height }}px !important;
      max-height: {{ d_height }}px !important;
      object-fit: contain !important;
    {% else %}
      width: 100% !important;
      height: {{ d_height }}px !important;
      max-height: {{ d_height }}px !important;
      object-fit: cover !important;
    {% endif %}
  }

  @media (max-width: 768px) {
    #tr-hero-{{ section.id }} {
      max-width: {{ m_width }}% !important;
    }

    #tr-hero-{{ section.id }} .tr-hero-slides-container {
      width: 100% !important;
      {% if m_fit == 'auto' %}
        height: auto !important;
        max-height: none !important;
      {% else %}
        height: {{ m_height }}px !important;
        max-height: {{ m_height }}px !important;
      {% endif %}
    }

    #tr-hero-{{ section.id }} .tr-hero-slide,
    #tr-hero-{{ section.id }} .tr-hero-slide.active,
    #tr-hero-{{ section.id }} .tr-hero-slide-link {
      width: 100% !important;
      {% if m_fit == 'auto' %}
        height: auto !important;
      {% else %}
        height: {{ m_height }}px !important;
      {% endif %}
    }

    #tr-hero-{{ section.id }} .tr-hero-img-wrap {
      width: 100% !important;
      {% if m_fit == 'auto' %}
        height: auto !important;
        max-height: none !important;
        min-height: unset !important;
      {% else %}
        height: {{ m_height }}px !important;
        max-height: {{ m_height }}px !important;
        min-height: unset !important;
      {% endif %}
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    #tr-hero-{{ section.id }} .tr-hero-img-wrap picture {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      {% if m_fit == 'auto' %}
        height: auto !important;
      {% else %}
        height: 100% !important;
      {% endif %}
    }

    #tr-hero-{{ section.id }} .tr-hero-img {
      display: block !important;
      object-position: center !important;
      {% if m_fit == 'auto' %}
        width: 100% !important;
        height: auto !important;
        max-height: none !important;
        object-fit: contain !important;
      {% elsif m_fit == 'contain' %}
        width: 100% !important;
        height: {{ m_height }}px !important;
        max-height: {{ m_height }}px !important;
        object-fit: contain !important;
      {% else %}
        width: 100% !important;
        height: {{ m_height }}px !important;
        max-height: {{ m_height }}px !important;
        object-fit: cover !important;
      {% endif %}
    }
  }
</style>

<section class="tr-hero-slider" id="tr-hero-{{ section.id }}">
  <div class="tr-hero-slides-container">
    {% for block in section.blocks %}
      {%- liquid
        assign desk_img = block.settings.image
        assign default_hero_asset = 'campaign/grooves-audio-desktop-branded.png' | asset_url
        assign desk_url = block.settings.image_url | default: default_hero_asset
        assign mob_img = block.settings.mobile_image
        assign mob_url = block.settings.mobile_image_url
      -%}
      <div class="tr-hero-slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="tr-hero-slide-link">
          <div class="tr-hero-img-wrap">
            <picture>
              {% if mob_img != blank %}
                <source media="(max-width: 768px)" srcset="{{ mob_img | image_url: width: 800 }}">
              {% elsif mob_url != blank %}
                <source media="(max-width: 768px)" srcset="{{ mob_url }}">
              {% endif %}
              
              {% if desk_img != blank %}
                <img 
                  src="{{ desk_img | image_url: width: 2000 }}" 
                  alt="{{ block.settings.heading | default: 'Grooves Lifestyle Tech Essentials' }}" 
                  class="tr-hero-img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="1920"
                  height="auto"
                >
              {% else %}
                <img 
                  src="{{ desk_url }}" 
                  alt="{{ block.settings.heading | default: 'Grooves Lifestyle Tech Essentials' }}" 
                  class="tr-hero-img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="1920"
                  height="auto"
                >
              {% endif %}
            </picture>

            {% if block.settings.show_text_overlay and block.settings.heading != blank %}
              <div class="tr-hero-overlay">
                <div class="tr-hero-content">
                  {% if block.settings.badge_text != blank %}
                    <div class="tr-hero-discount-tag">
                      <span>⚡</span> {{ block.settings.badge_text }}
                    </div>
                  {% endif %}
                  <h2 class="tr-hero-title">{{ block.settings.heading }}</h2>
                  {% if block.settings.subheading != blank %}
                    <p class="tr-hero-desc">{{ block.settings.subheading }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank %}
                    <span class="tr-btn tr-btn-accent">
                      {{ block.settings.button_label }}
                    </span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="tr-hero-dots">
      {% for block in section.blocks %}
        <button 
          class="tr-hero-dot {% if forloop.first %}active{% endif %}" 
          data-target-slide="{{ forloop.index0 }}" 
          aria-label="Slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

<script>
  (function() {
    const slider = document.getElementById('tr-hero-{{ section.id }}');
    if (!slider) return;
    const slides = slider.querySelectorAll('.tr-hero-slide');
    const dots = slider.querySelectorAll('.tr-hero-dot');
    let current = 0;
    let timer = null;

    function showSlide(index) {
      slides.forEach((s, i) => s.classList.toggle('active', i === index));
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
      current = index;
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        showSlide(idx);
        resetTimer();
      });
    });

    function resetTimer() {
      if (timer) clearInterval(timer);
      if (slides.length > 1) {
        const speed = {{ section.settings.autoplay_speed | default: 5 | times: 1000 }};
        timer = setInterval(() => {
          let next = (current + 1) % slides.length;
          showSlide(next);
        }, speed);
      }
    }
    resetTimer();

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        showSlide((current + 1) % slides.length);
        resetTimer();
      } else if (touchEndX - touchStartX > 50) {
        showSlide((current - 1 + slides.length) % slides.length);
        resetTimer();
      }
    }, { passive: true });
  })();
</script>

{% schema %}
{
