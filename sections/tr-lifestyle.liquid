<section class="tr-lifestyle-section upgrade-lifestyle"><div class="tr-container"><div class="upgrade-section-head"><div><span class="upgrade-eyebrow">MADE FOR YOUR EVERYDAY</span><h2>{{ section.settings.badge_title | escape }}</h2><p>A little more music. A little more you.</p></div></div><div class="tr-lifestyle-grid">{% for block in section.blocks %}{% assign col = block.settings.collection %}{% if col != blank %}<a href="{{ col.url }}" class="tr-lifestyle-card" {{ block.shopify_attributes }}><div class="tr-lifestyle-img-wrap">{{ col.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320,500,700', sizes: '(max-width:749px) 44vw, 24vw', alt: col.title }}</div><div class="upgrade-lifestyle-copy"><span class="upgrade-eyebrow">{{ col.title | escape }}</span><h3>{{ block.settings.title | escape }}</h3><span class="upgrade-text-link">Explore collection ↗</span></div></a>{% endif %}{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Grooves Lifestyle",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "DESIGNED FOR YOUR LIFESTYLE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "lifestyle_item",
      "name": "Lifestyle Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection (Dynamic)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Upload)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Lifestyle Name Fallback",
          "default": "Daily Commute & Travel"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL Fallback",
          "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link Fallback"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooves Lifestyle",
      "blocks": [
        {
          "type": "lifestyle_item",
          "settings": {
            "title": "Daily Commute & Travel",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesmovie-night.png?v=1782984281"
          }
        },
        {
          "type": "lifestyle_item",
          "settings": {
            "title": "Work, Focus & Coding",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesNews.png?v=1782984314"
          }
        },
        {
          "type": "lifestyle_item",
          "settings": {
            "title": "Workout & Fitness",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesWorkout.png?v=1782984362"
          }
        },
        {
          "type": "lifestyle_item",
          "settings": {
            "title": "Gaming & Low Latency",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesinnovators.png?v=1782984337"
          }
        },
        {
          "type": "lifestyle_item",
          "settings": {
            "title": "Home & Entertainment",
            "image_url": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/landing-page-imagesParty.png?v=1782984388"
          }
        }
      ]
    }
  ]
}
{% endschema %}
