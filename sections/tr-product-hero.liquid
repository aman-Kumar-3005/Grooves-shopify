{%- liquid
  assign target_product = product
  if target_product == blank and section.settings.fallback_product != blank
    assign target_product = all_products[section.settings.fallback_product]
  endif

  assign current_variant = target_product.selected_or_first_available_variant
  assign prod_title = target_product.title
  assign prod_subtitle = ''
  
  if current_variant != blank
    assign p_price = current_variant.price | money
    if current_variant.compare_at_price > current_variant.price
      assign p_compare = current_variant.compare_at_price | money
      assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
      assign discount_text = discount_pct | append: '% OFF'
    else
      assign p_compare = ''
      assign discount_text = ''
    endif
  else
    assign p_price = ''
    assign p_compare = ''
    assign discount_text = ''
  endif
-%}

{% render 'grooves-breadcrumbs', product: product %}

{%- style -%}
  #tr-pdp-hero-{{ section.id }} {
    --tr-bg: {{ section.settings.bg_color | default: '#0b0b0b' }};
    --tr-card: {{ section.settings.card_bg | default: '#161616' }};
    --tr-border: rgba(255, 255, 255, 0.1);
    --tr-text: {{ section.settings.text_color | default: '#ffffff' }};
    --tr-muted: #999999;
    --tr-accent: {{ section.settings.accent_color | default: '#4cf800' }};
    background-color: var(--tr-bg);
    color: var(--tr-text);
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: inherit;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  #tr-pdp-hero-{{ section.id }} *,
  #tr-pdp-hero-{{ section.id }} *::before,
  #tr-pdp-hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #tr-pdp-hero-{{ section.id }} .tr-container {
    width: 100% !important;
    max-width: 1320px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
  }

  /* --- Main Responsive Grid --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 44px;
    align-items: start;
    width: 100%;
  }

  /* --- Left: Media Gallery --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-gallery-wrap {
    display: flex;
    gap: 16px;
    position: sticky;
    top: 24px;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 520px;
    overflow-y: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumbnails::-webkit-scrollbar {
    display: none;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item {
    width: 70px;
    height: 70px;
    border-radius: 12px;
    background: #ffffff;
    border: 2px solid var(--tr-border);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item.active,
  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item:hover {
    border-color: var(--tr-accent);
    box-shadow: 0 0 10px rgba(76, 248, 0, 0.35);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-main-media {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--tr-border);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-main-media img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    object-fit: contain;
    object-position: center;
    display: block;
    margin: 0 auto;
    transition: opacity 0.25s ease;
  }

  /* --- Right: Product Details --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-details {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-rating-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    padding: 6px 14px;
    border-radius: 30px;
    width: fit-content;
    max-width: 100%;
    flex-wrap: wrap;
    font-size: 13px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-stars {
    color: #ffb800;
    letter-spacing: 1px;
    font-size: 14px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-review-count {
    color: var(--tr-muted);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-title {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
    color: var(--tr-text);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-subtitle {
    font-size: 14px;
    color: var(--tr-muted);
    line-height: 1.5;
    margin: -6px 0 0 0;
    overflow-wrap: break-word;
    word-break: break-word;
    white-space: normal;
  }

  /* --- Price Box --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-price-box {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 14px 18px;
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    border-radius: 14px;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-price {
    font-size: 28px;
    font-weight: 800;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-mrp {
    font-size: 16px;
    color: var(--tr-muted);
    text-decoration: line-through;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-discount-badge {
    background: var(--tr-accent);
    color: #000000;
    font-size: 12px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }

  /* --- Dynamic Swatches --- */
  #tr-pdp-hero-{{ section.id }} .tr-swatch-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatches-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--tr-card);
    color: var(--tr-text);
    border: 1.5px solid var(--tr-border);
    padding: 8px 14px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    max-width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-btn.active,
  #tr-pdp-hero-{{ section.id }} .tr-swatch-btn:hover {
    border-color: var(--tr-accent);
    background: rgba(76, 248, 0, 0.08);
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-color-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.3);
    display: inline-block;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }

  /* --- Personalisation Box --- */
  #tr-pdp-hero-{{ section.id }} .tr-personalise-box {
    background: var(--tr-card);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    padding: 14px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-box label {
    font-size: 13px;
    font-weight: 700;
    color: var(--tr-text);
    line-height: 1.4;
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-input {
    width: 100%;
    background: var(--tr-bg);
    border: 1px solid var(--tr-border);
    color: var(--tr-text) !important;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-input::placeholder,
  #tr-pdp-hero-{{ section.id }} .tr-pincode-input::placeholder {
    color: #888888 !important;
    opacity: 1;
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-input:focus {
    border-color: var(--tr-accent);
  }

  /* --- Coupon Banner --- */
  #tr-pdp-hero-{{ section.id }} .tr-coupon-banner {
    background: rgba(76, 248, 0, 0.08);
    border: 1px solid var(--tr-accent);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-coupon-text {
    font-size: 13px;
    font-weight: 700;
    color: var(--tr-text);
    flex: 1 1 180px;
    min-width: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-coupon-code-pill {
    background: var(--tr-accent);
    color: #000000;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-coupon-code-pill:active {
    transform: scale(0.95);
  }

  /* --- Pincode Checker --- */
  #tr-pdp-hero-{{ section.id }} .tr-pincode-block {
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pincode-wrap {
    display: flex;
    gap: 8px;
    width: 100%;
    align-items: stretch;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pincode-input {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    color: var(--tr-text) !important;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pincode-input:focus {
    border-color: var(--tr-accent);
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-check {
    background: var(--tr-card);
    color: var(--tr-accent);
    border: 1px solid var(--tr-accent);
    padding: 0 18px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-check:hover {
    background: var(--tr-accent);
    color: #000;
  }

  /* --- CTA Buttons --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now {
    width: 100%;
    max-width: 100%;
    background: var(--tr-accent);
    color: #000000;
    border: none;
    padding: 15px 16px;
    border-radius: 12px;
    font-size: 14.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    white-space: normal;
    line-height: 1.3;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now:hover {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(76, 248, 0, 0.25);
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart {
    width: 100%;
    max-width: 100%;
    background: transparent;
    color: var(--tr-text);
    border: 2px solid var(--tr-text);
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 14.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: all 0.25s ease;
    text-align: center;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart:hover {
    background: var(--tr-text);
    color: var(--tr-bg);
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now[disabled],
  #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* --- 4 Trust Badges --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--tr-border);
    margin-top: 4px;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item {
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    border-radius: 12px;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    min-width: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
    background: #fff;
    border-radius: 6px;
    padding: 2px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item span {
    font-size: 11px;
    font-weight: 700;
    color: var(--tr-text);
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  /* ===================================================
     TABLET & MOBILE RESPONSIVE BREAKPOINTS
     =================================================== */
  @media screen and (max-width: 991px) {
    #tr-pdp-hero-{{ section.id }} {
      padding-top: 16px;
      padding-bottom: 36px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-container {
      padding: 0 16px !important;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-gallery-wrap {
      position: static;
      flex-direction: column-reverse;
      gap: 12px;
      width: 100%;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-thumbnails {
      flex-direction: row;
      width: 100%;
      max-height: none;
      overflow-x: auto;
      padding-bottom: 4px;
      gap: 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item {
      width: 62px;
      height: 62px;
    }
  }

  @media screen and (max-width: 600px) {
    #tr-pdp-hero-{{ section.id }} .tr-container {
      padding: 0 14px !important;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-title {
      font-size: 22px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-subtitle {
      font-size: 12.5px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-price-box {
      padding: 12px 14px;
      gap: 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-price {
      font-size: 22px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-mrp {
      font-size: 14px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-discount-badge {
      font-size: 11px;
      padding: 4px 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-coupon-banner {
      padding: 10px 12px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-coupon-text {
      font-size: 12px;
      flex: 1 1 140px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-coupon-code-pill {
      font-size: 11px;
      padding: 6px 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-badges-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      padding: 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now,
    #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart {
      font-size: 13px;
      padding: 14px 12px;
    }
  }
#tr-pdp-hero-{{ section.id }} .tr-catalog-spec-list { margin:0; font-size:14px; line-height:1.5; }
#tr-pdp-hero-{{ section.id }} .tr-catalog-spec-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.25fr); gap:12px; padding:7px 0; border-bottom:1px solid var(--tr-border); }
#tr-pdp-hero-{{ section.id }} .tr-catalog-spec-row dt { font-weight:600; }
#tr-pdp-hero-{{ section.id }} .tr-catalog-spec-row dd { margin:0; overflow-wrap:anywhere; }
{%- endstyle -%}

<section class="tr-pdp-top-wrapper" id="tr-pdp-hero-{{ section.id }}">
  <div class="tr-container">
    <div class="tr-pdp-grid">
      
      <!-- Media Gallery (Left on Desktop, Top on Mobile) -->
      <div class="tr-pdp-gallery-wrap">
        <div class="tr-pdp-thumbnails">
          {% if target_product != blank and target_product.media.size > 0 %}
            {% for media in target_product.media %}
              <div 
                class="tr-pdp-thumb-item {% if forloop.first %}active{% endif %}" 
                data-media-src="{{ media | image_url: width: 1000 }}" 
                data-media-id="{{ media.id }}"
              >
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | default: prod_title | escape }}" loading="lazy" width="70" height="70">
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <div class="tr-pdp-main-media">
          <button type="button" class="grooves-share-trigger" aria-label="Share this product" aria-haspopup="dialog" aria-controls="grooves-share-dialog-{{ section.id }}"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M6 12H4v9h16v-9h-2"/></svg></button>
          {%- liquid
            assign initial_img = ''
            if current_variant.featured_image != blank
              assign initial_img = current_variant.featured_image | image_url: width: 1000
            elsif target_product.featured_image != blank
              assign initial_img = target_product.featured_image | image_url: width: 1000
            endif
          -%}
          <img 
            id="tr-main-display-img-{{ section.id }}" 
            src="{{ initial_img }}" 
            alt="{{ prod_title | escape }}"
            width="600"
            height="600"
          >
        </div>
      </div>

      <!-- Product Info Column (Right on Desktop, Bottom on Mobile) -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="tr-pdp-form-{{ section.id }}" class="tr-pdp-details">
        <input type="hidden" name="id" id="tr-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">

        {% comment %}Unverified template ratings removed. Genuine reviews must come from a verified review provider.{% endcomment %}

        <!-- Title & Subtitle -->
        <h1 class="tr-pdp-title" id="product-title-{{ section.id }}">{{ prod_title }}</h1>

        {% if prod_subtitle != blank %}
          <p class="tr-pdp-subtitle">{{ prod_subtitle }}</p>
        {% endif %}

        {% comment %}USB-C charging input confirmed by store owner for these rechargeable audio models on 27 October 2026.{% endcomment %}
        {% assign usb_c_confirmed_handles = 'grooves-fire-true-wireless-earbuds-ergonomic-bluetooth-in-ear-headphones-with-dual-tone-charging-case-touch-controls-deep-bass,grooves-fire-earuds,grooves-fire-earuds-white,grooves-ullet-eckad,grooves-ninja-pro2-earbuds,grooves-aximo-neckband,grooves-infinity,grooves-theta-pro,grooves-beat,alpha-100x,grooves-metal-x1,grooves-fort,grooves-robo-x-thunder,grooves-alpha-200-with-anc,grooves-alpha100,grooves-ultra-100,grooves-theta100-pro,grooves-signature2-0,grooves-delta-plus,grooves-metal-blast,grooves-beat-2-0-true-wireless-bluetooth-earbuds-tws-wireless-earbuds-with-charging-case-built-in-mic-for-calls-stereo-sound-comfortable-in-ear-fit-compatible-with-android-ios,grooves-ninja-pro2-tws-true-wireless-bluetooth-earbuds-with-mic-charging-case,grooves-infinity-ultra-luxury-diamond-finish-120-hrs-standby-super-bass-and-adaptive-4-mic-enc-low-latency-calling-with-voice-control-5-3-bluetooth-headset-white-true-wireless,grooves-vibe-2-0,grooves-ultra-earbuds,grooves-metal-earbuds,grooves-delta-2-0' | split: ',' %}
{% comment %}Model-specific specifications from owner-supplied GROOVES catalogue, pages 2, 3, 14 and 15. Different model generations are deliberately excluded. No catalogue prices imported.{% endcomment %}
{% capture catalogue_spec_rows %}
{% case target_product.handle %}
