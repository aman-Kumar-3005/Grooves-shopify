{%- liquid
  assign target_product = product
  if target_product == blank and section.settings.fallback_product != blank
    assign target_product = all_products[section.settings.fallback_product]
  endif

  assign current_variant = target_product.selected_or_first_available_variant
  assign prod_title = target_product.title | default: section.settings.product_title | default: "DwOTS Fire - Dual Sharing TWS with Wireless Charging"
  assign prod_subtitle = target_product.metafields.custom.subtitle.value | default: target_product.metafields.custom.subtitle | default: section.settings.product_subtitle | default: "Dual Pairing | 52 Hours Playback | Wireless Charging | 45ms Low Latency"
  
  if current_variant != blank
    assign p_price = current_variant.price | money
    if current_variant.compare_at_price > current_variant.price
      assign p_compare = current_variant.compare_at_price | money
      assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
      assign discount_text = discount_pct | append: '% OFF'
    else
      assign p_compare = ''
      assign discount_text = section.settings.discount_badge_text
    endif
  else
    assign p_price = section.settings.fallback_price | default: "₹1,499"
    assign p_compare = section.settings.fallback_compare_price | default: "₹4,999"
    assign discount_text = section.settings.discount_badge_text | default: "70% OFF"
  endif
-%}

{%- style -%}
  #tr-pdp-hero-{{ section.id }} {
    --tr-bg: {{ section.settings.bg_color | default: '#0b0b0b' }};
    --tr-card: {{ section.settings.card_bg | default: '#161616' }};
    --tr-border: rgba(255, 255, 255, 0.1);
    --tr-text: {{ section.settings.text_color | default: '#ffffff' }};
    --tr-muted: #999999;
    --tr-accent: {{ section.settings.accent_color | default: '#4cf800' }};
    background-color: var(--tr-bg);
    color: var(--tr-text);
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: inherit;
    overflow-x: hidden;
  }

  #tr-pdp-hero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #tr-pdp-hero-{{ section.id }} .tr-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- Main Responsive Grid --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: start;
  }

  /* --- Left: Media Gallery --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-gallery-wrap {
    display: flex;
    gap: 16px;
    position: sticky;
    top: 24px;
    align-items: flex-start;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 540px;
    overflow-y: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumbnails::-webkit-scrollbar {
    display: none;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    background: var(--tr-card);
    border: 2px solid var(--tr-border);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item.active,
  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item:hover {
    border-color: var(--tr-accent);
    transform: translateY(-2px);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-main-media {
    flex-grow: 1;
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-main-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: opacity 0.25s ease;
  }

  /* --- Right: Product Details --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-rating-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    padding: 6px 14px;
    border-radius: 30px;
    width: fit-content;
    font-size: 13px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-stars {
    color: #ffb800;
    letter-spacing: 1px;
    font-size: 14px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-review-count {
    color: var(--tr-muted);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-title {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-subtitle {
    font-size: 14px;
    color: var(--tr-muted);
    line-height: 1.5;
    margin: -8px 0 0 0;
  }

  /* --- Price Box --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-price-box {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--tr-border);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-price {
    font-size: 30px;
    font-weight: 800;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-mrp {
    font-size: 18px;
    color: var(--tr-muted);
    text-decoration: line-through;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-discount-badge {
    background: var(--tr-accent);
    color: #000000;
    font-size: 12px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }

  /* --- Dynamic Swatches --- */
  #tr-pdp-hero-{{ section.id }} .tr-swatch-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatches-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--tr-card);
    color: var(--tr-text);
    border: 1.5px solid var(--tr-border);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-btn.active,
  #tr-pdp-hero-{{ section.id }} .tr-swatch-btn:hover {
    border-color: var(--tr-accent);
    background: rgba(76, 248, 0, 0.08);
  }

  #tr-pdp-hero-{{ section.id }} .tr-swatch-color-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.3);
    display: inline-block;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }

  /* --- Personalisation Box --- */
  #tr-pdp-hero-{{ section.id }} .tr-personalise-box {
    background: var(--tr-card);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    padding: 16px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-box label {
    font-size: 13px;
    font-weight: 700;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-input {
    width: 100%;
    background: var(--tr-bg);
    border: 1px solid var(--tr-border);
    color: var(--tr-text);
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-personalise-input:focus {
    border-color: var(--tr-accent);
  }

  /* --- Coupon Banner --- */
  #tr-pdp-hero-{{ section.id }} .tr-coupon-banner {
    background: rgba(76, 248, 0, 0.08);
    border: 1px solid var(--tr-accent);
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  #tr-pdp-hero-{{ section.id }} .tr-coupon-text {
    font-size: 13px;
    font-weight: 700;
    color: var(--tr-text);
  }

  #tr-pdp-hero-{{ section.id }} .tr-coupon-code-pill {
    background: var(--tr-accent);
    color: #000;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
    transition: transform 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-coupon-code-pill:active {
    transform: scale(0.95);
  }

  /* --- Pincode Checker --- */
  #tr-pdp-hero-{{ section.id }} .tr-pincode-wrap {
    display: flex;
    gap: 10px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pincode-input {
    flex-grow: 1;
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    color: var(--tr-text);
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pincode-input:focus {
    border-color: var(--tr-accent);
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-check {
    background: var(--tr-card);
    color: var(--tr-accent);
    border: 1px solid var(--tr-accent);
    padding: 0 22px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-check:hover {
    background: var(--tr-accent);
    color: #000;
  }

  /* --- CTA Buttons --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now {
    width: 100%;
    background: var(--tr-accent);
    color: #000000;
    border: none;
    padding: 16px 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now:hover {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(76, 248, 0, 0.25);
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart {
    width: 100%;
    background: transparent;
    color: var(--tr-text);
    border: 2px solid var(--tr-text);
    padding: 15px 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart:hover {
    background: var(--tr-text);
    color: var(--tr-bg);
  }

  #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now[disabled],
  #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* --- 4 Trust Badges --- */
  #tr-pdp-hero-{{ section.id }} .tr-pdp-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--tr-border);
    margin-top: 4px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item {
    background: var(--tr-card);
    border: 1px solid var(--tr-border);
    border-radius: 12px;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item span {
    font-size: 11px;
    font-weight: 700;
    color: var(--tr-text);
    line-height: 1.3;
  }

  /* ===================================================
     TABLET & MOBILE RESPONSIVE BREAKPOINTS
     =================================================== */
  @media screen and (max-width: 991px) {
    #tr-pdp-hero-{{ section.id }} {
      padding-top: 20px;
      padding-bottom: 40px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-gallery-wrap {
      position: static;
      flex-direction: column-reverse;
      gap: 12px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-thumbnails {
      flex-direction: row;
      width: 100%;
      max-height: none;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-thumb-item {
      width: 64px;
      height: 64px;
    }
  }

  @media screen and (max-width: 600px) {
    #tr-pdp-hero-{{ section.id }} .tr-container {
      padding: 0 15px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-title {
      font-size: 22px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-subtitle {
      font-size: 13px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-price {
      font-size: 24px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-mrp {
      font-size: 15px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-badges-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-pdp-badge-item {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      padding: 10px 12px;
    }

    #tr-pdp-hero-{{ section.id }} .tr-btn-buy-now,
    #tr-pdp-hero-{{ section.id }} .tr-btn-add-cart {
      font-size: 13.5px;
      padding: 14px 16px;
    }
  }
{%- endstyle -%}

<section class="tr-pdp-top-wrapper" id="tr-pdp-hero-{{ section.id }}">
  <div class="tr-container">
    <div class="tr-pdp-grid">
      
      <!-- Media Gallery (Left on Desktop, Top on Mobile) -->
      <div class="tr-pdp-gallery-wrap">
        <div class="tr-pdp-thumbnails">
          {% if target_product != blank and target_product.media.size > 0 %}
            {% for media in target_product.media %}
              <div 
                class="tr-pdp-thumb-item {% if forloop.first %}active{% endif %}" 
                data-media-src="{{ media | image_url: width: 1000 }}" 
                data-media-id="{{ media.id }}"
              >
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | default: prod_title | escape }}" loading="lazy" width="72" height="72">
              </div>
            {% endfor %}
          {% else %}
            <div class="tr-pdp-thumb-item active" data-media-src="//acwo.com/cdn/shop/files/dwots_fire_9.png?v=1783600774">
              <img src="//acwo.com/cdn/shop/files/dwots_fire_9.png?v=1783600774" alt="DwOTS Fire White" loading="lazy" width="72" height="72">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="//acwo.com/cdn/shop/files/Fire_Black_New_3D.gif?v=1772180394">
              <img src="//acwo.com/cdn/shop/files/Fire_Black_New_3D.gif?v=1772180394" alt="DwOTS Fire 3D" loading="lazy" width="72" height="72">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="//acwo.com/cdn/shop/files/fire-rotating-black.webp?v=1772185073">
              <img src="//acwo.com/cdn/shop/files/fire-rotating-black.webp?v=1772185073" alt="DwOTS Fire Rotating" loading="lazy" width="72" height="72">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="//acwo.com/cdn/shop/files/DwOTS_Firenew-black.png?v=1772185073">
              <img src="//acwo.com/cdn/shop/files/DwOTS_Firenew-black.png?v=1772185073" alt="DwOTS Fire Black Case" loading="lazy" width="72" height="72">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="//acwo.com/cdn/shop/files/dwots-fire_c6ef8f2a-15bc-4428-84ca-c1066661bf8d.webp?v=1772179131">
              <img src="//acwo.com/cdn/shop/files/dwots-fire_c6ef8f2a-15bc-4428-84ca-c1066661bf8d.webp?v=1772179131" alt="DwOTS Fire In Ear" loading="lazy" width="72" height="72">
            </div>
          {% endif %}
        </div>

        <div class="tr-pdp-main-media">
          {%- liquid
            assign initial_img = '//acwo.com/cdn/shop/files/dwots_fire_9.png?v=1783600774'
            if current_variant.featured_image != blank
              assign initial_img = current_variant.featured_image | image_url: width: 1000
            elsif target_product.featured_image != blank
              assign initial_img = target_product.featured_image | image_url: width: 1000
            endif
          -%}
          <img 
            id="tr-main-display-img-{{ section.id }}" 
            src="{{ initial_img }}" 
            alt="{{ prod_title | escape }}"
            width="600"
            height="600"
          >
        </div>
      </div>

      <!-- Product Info Column (Right on Desktop, Bottom on Mobile) -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="tr-pdp-form-{{ section.id }}" class="tr-pdp-details">
        <input type="hidden" name="id" id="tr-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">

        <!-- Rating Row -->
        {% if section.settings.show_rating %}
          <div class="tr-pdp-rating-row">
            <span class="tr-pdp-stars">★★★★★</span>
            <strong>{{ section.settings.rating_score | default: '4.8' }}</strong>
            <span class="tr-pdp-review-count">| {{ section.settings.reviews_count | default: '128 Verified Reviews' }}</span>
          </div>
        {% endif %}

        <!-- Title & Subtitle -->
        <h1 class="tr-pdp-title">{{ prod_title }}</h1>
        {% if prod_subtitle != blank %}
          <p class="tr-pdp-subtitle">{{ prod_subtitle }}</p>
        {% endif %}

        <!-- Dynamic Price Box -->
        <div class="tr-pdp-price-box">
          <span class="tr-pdp-price" id="tr-pdp-price-val-{{ section.id }}">{{ p_price }}</span>
          <span class="tr-pdp-mrp" id="tr-pdp-compare-val-{{ section.id }}" {% if p_compare == blank %}style="display:none;"{% endif %}>{{ p_compare }}</span>
          <span class="tr-pdp-discount-badge" id="tr-pdp-discount-val-{{ section.id }}" {% if discount_text == blank %}style="display:none;"{% endif %}>{{ discount_text }}</span>
        </div>

        <!-- Dynamic Variant / Color Swatches -->
        {% if target_product != blank and target_product.variants.size > 1 %}
          <div class="tr-swatch-section">
            <div class="tr-swatch-label">
              {{ target_product.options.first | default: 'Option' }}: 
              <span id="tr-selected-color-name-{{ section.id }}" style="color: var(--tr-accent);">{{ current_variant.title }}</span>
            </div>
            <div class="tr-swatches-row">
              {% for variant in target_product.variants %}
                {%- liquid
                  assign v_price = variant.price | money
                  assign v_compare = ''
                  assign v_discount = ''
                  if variant.compare_at_price > variant.price
                    assign v_compare = variant.compare_at_price | money
                    assign v_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                    assign v_discount = v_pct | append: '% OFF'
                  endif
                  assign v_img = ''
                  if variant.featured_image != blank
                    assign v_img = variant.featured_image | image_url: width: 1000
                  endif
                -%}
                <button 
                  type="button"
                  class="tr-swatch-btn {% if variant.id == current_variant.id %}active{% endif %}" 
                  data-variant-id="{{ variant.id }}"
                  data-available="{{ variant.available }}"
                  data-color-name="{{ variant.title | escape }}" 
                  data-price="{{ v_price }}"
                  data-compare="{{ v_compare }}"
                  data-discount="{{ v_discount }}"
                  data-img-url="{{ v_img }}"
                >
                  {% if variant.featured_image != blank %}
                    <span class="tr-swatch-color-circle" style="background-image: url('{{ variant.featured_image | image_url: width: 60 }}');"></span>
                  {% else %}
                    <span class="tr-swatch-color-circle" style="background: {{ variant.title | split: ' ' | last | downcase }};"></span>
                  {% endif %}
                  {{ variant.title }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% elsif target_product == blank %}
          <!-- Fallback Swatches for Theme Editor Preview -->
          <div class="tr-swatch-section">
            <div class="tr-swatch-label">Color: <span id="tr-selected-color-name-{{ section.id }}" style="color: var(--tr-accent);">Moon White</span></div>
            <div class="tr-swatches-row">
              <button type="button" class="tr-swatch-btn active" data-color-name="Moon White" data-img-url="//acwo.com/cdn/shop/files/dwots_fire_9.png?v=1783600774">
                <span class="tr-swatch-color-circle" style="background: #ffffff;"></span>
                Moon White
              </button>
              <button type="button" class="tr-swatch-btn" data-color-name="Carbon Black" data-img-url="//acwo.com/cdn/shop/files/DwOTS_Firenew-black.png?v=1772185073">
                <span class="tr-swatch-color-circle" style="background: #111111;"></span>
                Carbon Black
              </button>
              <button type="button" class="tr-swatch-btn" data-color-name="Steel Blue" data-img-url="//acwo.com/cdn/shop/files/dwots-fire_c6ef8f2a-15bc-4428-84ca-c1066661bf8d.webp?v=1772179131">
                <span class="tr-swatch-color-circle" style="background: #3b5998;"></span>
                Steel Blue
              </button>
            </div>
          </div>
        {% endif %}

        <!-- Personalise Engraving (Connected to Order Line Item Properties) -->
        {% if section.settings.enable_personalisation %}
          <div class="tr-personalise-box">
            <label for="tr-engrave-text-{{ section.id }}">✨ {{ section.settings.personalise_label | default: 'Make Your Product Personalised (Optional Free Engraving)' }}</label>
            <input 
              type="text" 
              name="properties[Engraving]"
              id="tr-engrave-text-{{ section.id }}" 
              class="tr-personalise-input" 
              placeholder="{{ section.settings.personalise_placeholder | default: 'Enter name or initials to engrave on case (Max 12 chars)' }}" 
              maxlength="12"
            >
          </div>
        {% endif %}

        <!-- Offer Coupon Box -->
        {% if section.settings.show_coupon %}
          <div class="tr-coupon-banner">
            <div class="tr-coupon-text">
              <span>🏷️ {{ section.settings.coupon_text | default: 'Get 15% OFF on 2 or More Items' }}</span>
            </div>
            <span class="tr-coupon-code-pill" id="tr-coupon-pill-{{ section.id }}" title="Click to copy">
              {{ section.settings.coupon_code | default: 'Use Code: TR15' }}
            </span>
          </div>
        {% endif %}

        <!-- Pincode Delivery Check -->
        {% if section.settings.show_pincode %}
          <div>
            <label style="font-size: 13px; font-weight: 700; margin-bottom: 8px; display: block;">{{ section.settings.pincode_label | default: 'Check Estimated Delivery Date' }}</label>
            <div class="tr-pincode-wrap">
              <input type="text" class="tr-pincode-input" id="tr-pincode-input-{{ section.id }}" placeholder="Enter 6-Digit Delivery Pincode" maxlength="6" inputmode="numeric">
              <button type="button" class="tr-btn-check" id="tr-pincode-btn-{{ section.id }}">CHECK</button>
            </div>
            <div id="tr-pincode-msg-{{ section.id }}" style="font-size: 12.5px; margin-top: 8px; font-weight: 600; display: none;"></div>
          </div>
        {% endif %}

        <!-- Dynamic CTA Buttons -->
        <div class="tr-pdp-actions">
          {% if section.settings.show_buy_now %}
            <button 
              type="button" 
              class="tr-btn-buy-now" 
              id="tr-buy-now-btn-{{ section.id }}"
              {% if current_variant != blank and current_variant.available == false %}disabled{% endif %}
            >
              ⚡ {{ section.settings.buy_now_label | default: 'BUY IT NOW - PAY ON DELIVERY / UPI' }}
            </button>
          {% endif %}
          <button 
            type="submit" 
            class="tr-btn-add-cart" 
            id="tr-add-cart-btn-{{ section.id }}"
            {% if current_variant != blank and current_variant.available == false %}disabled{% endif %}
          >
            {% if current_variant != blank and current_variant.available == false %}
              SOLD OUT
            {% else %}
              {{ section.settings.add_to_cart_label | default: 'ADD TO CART' }}
            {% endif %}
          </button>
        </div>

        <!-- 4 PDP Trust Badges -->
        <div class="tr-pdp-badges-grid">
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/ACwO-Free-Shipping.webp?v=1701524211" alt="Free Shipping" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_1_text | default: 'Free Shipping' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/365-days-warranty-icon.png?v=1715862240" alt="1 Year Warranty" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_2_text | default: '1 Year Warranty' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/ACwO-72Hrs-Replacement-Policy.webp?v=1701511254" alt="72Hrs Replacement" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_3_text | default: '72h Replacement' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/GST-Billing.png?v=1717494620" alt="GST Billing" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_4_text | default: 'GST Billing' }}</span>
          </div>
        </div>
      </form>

    </div>
  </div>
</section>

<script>
(function() {
  const sectionEl = document.getElementById('tr-pdp-hero-{{ section.id }}');
  if (!sectionEl) return;

  const mainImg = document.getElementById('tr-main-display-img-{{ section.id }}');
  const variantInput = document.getElementById('tr-variant-id-{{ section.id }}');
  const colorNameEl = document.getElementById('tr-selected-color-name-{{ section.id }}');
  const priceEl = document.getElementById('tr-pdp-price-val-{{ section.id }}');
  const compareEl = document.getElementById('tr-pdp-compare-val-{{ section.id }}');
  const discountEl = document.getElementById('tr-pdp-discount-val-{{ section.id }}');
  const addToCartBtn = document.getElementById('tr-add-cart-btn-{{ section.id }}');
  const buyNowBtn = document.getElementById('tr-buy-now-btn-{{ section.id }}');
  const form = document.getElementById('tr-pdp-form-{{ section.id }}');
  const defaultAddText = {{ section.settings.add_to_cart_label | default: 'ADD TO CART' | json }};

  // 1. Thumbnail Switching
  sectionEl.querySelectorAll('.tr-pdp-thumb-item').forEach(thumb => {
    thumb.addEventListener('click', function() {
      sectionEl.querySelectorAll('.tr-pdp-thumb-item').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      const src = this.getAttribute('data-media-src');
      if (src && mainImg) mainImg.src = src;
    });
  });

  // 2. Dynamic Variant / Color Swatch Switching
  sectionEl.querySelectorAll('.tr-swatch-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      sectionEl.querySelectorAll('.tr-swatch-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');

      const vId = this.getAttribute('data-variant-id');
      const colorName = this.getAttribute('data-color-name');
      const imgUrl = this.getAttribute('data-img-url');
      const price = this.getAttribute('data-price');
      const compare = this.getAttribute('data-compare');
      const discount = this.getAttribute('data-discount');
      const available = this.getAttribute('data-available') !== 'false';

      if (colorNameEl && colorName) colorNameEl.textContent = colorName;
      if (imgUrl && mainImg) mainImg.src = imgUrl;
      if (vId && variantInput) {
        variantInput.value = vId;
        // Update URL with selected variant ID without reloading
        if (window.history && window.history.replaceState && window.location.pathname.includes('/products/')) {
          const newUrl = window.location.pathname + '?variant=' + vId;
          window.history.replaceState({ path: newUrl }, '', newUrl);
        }
      }

      if (price && priceEl) priceEl.textContent = price;
      if (compareEl) {
        if (compare) {
          compareEl.textContent = compare;
          compareEl.style.display = 'inline';
        } else {
          compareEl.style.display = 'none';
        }
      }
      if (discountEl) {
        if (discount) {
          discountEl.textContent = discount;
          discountEl.style.display = 'inline-block';
        } else {
          discountEl.style.display = 'none';
        }
      }

      if (addToCartBtn) {
        addToCartBtn.disabled = !available;
        addToCartBtn.textContent = available ? defaultAddText : 'SOLD OUT';
      }
      if (buyNowBtn) {
        buyNowBtn.disabled = !available;
      }
    });
  });

  // 3. Pincode Delivery Checker
  const pinBtn = document.getElementById('tr-pincode-btn-{{ section.id }}');
  const pinInput = document.getElementById('tr-pincode-input-{{ section.id }}');
  const pinMsg = document.getElementById('tr-pincode-msg-{{ section.id }}');

  if (pinBtn && pinInput && pinMsg) {
    pinBtn.addEventListener('click', function() {
      const val = pinInput.value.trim();
      if (/^[1-9][0-9]{5}$/.test(val)) {
        pinMsg.style.display = 'block';
        pinMsg.style.color = 'var(--tr-accent)';
        pinMsg.textContent = '✓ Delivery expected in 2-4 business days to ' + val + '. Free shipping eligible!';
      } else {
        pinMsg.style.display = 'block';
        pinMsg.style.color = '#ff4d4d';
        pinMsg.textContent = '✕ Please enter a valid 6-digit Indian PIN code.';
      }
    });
  }

  // 4. Coupon Copy on Click
  const couponPill = document.getElementById('tr-coupon-pill-{{ section.id }}');
  if (couponPill) {
    couponPill.addEventListener('click', function() {
      const rawText = this.textContent.replace(/Use Code:/i, '').trim();
      navigator.clipboard.writeText(rawText).then(() => {
        const old = this.textContent;
        this.textContent = 'COPIED: ' + rawText + ' ✓';
        setTimeout(() => { this.textContent = old; }, 2000);
      });
    });
  }

  // 5. Real Shopify Add to Cart & Buy Now AJAX
  async function handleCartAction(redirectToCheckout) {
    if (!form) return;
    const vId = variantInput ? variantInput.value : '';
    if (!vId) {
      alert('Please select a product in Theme Customizer settings or open this on a Product page.');
      return;
    }

    const formData = new FormData(form);
    const activeBtn = redirectToCheckout ? buyNowBtn : addToCartBtn;
    const originalText = activeBtn ? activeBtn.innerHTML : '';

    if (activeBtn) {
      activeBtn.disabled = true;
      activeBtn.innerHTML = redirectToCheckout ? 'REDIRECTING TO CHECKOUT...' : 'ADDING TO CART...';
    }

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
      });

      if (!response.ok) throw new Error('Failed to add item');
      const itemData = await response.json();

      if (redirectToCheckout) {
        window.location.href = '/checkout';
      } else {
        if (activeBtn) activeBtn.innerHTML = 'ADDED TO CART ✓';
        window.dispatchEvent(new Event('cart:refresh'));
        document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: itemData } }));
        setTimeout(() => {
          window.location.href = '/cart';
        }, 500);
      }
    } catch (err) {
      console.error(err);
      alert('Could not add product to cart. Please check stock availability.');
      if (activeBtn) {
        activeBtn.disabled = false;
        activeBtn.innerHTML = originalText;
      }
    }
  }

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      handleCartAction(false);
    });
  }

  if (buyNowBtn) {
    buyNowBtn.addEventListener('click', function(e) {
      e.preventDefault();
      handleCartAction(true);
    });
  }
})();
</script>

