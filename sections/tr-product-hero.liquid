<div class="tr-catalog-spec-row"><dt>Wire</dt><dd>4-core copper wire</dd></div>
{% endcase %}
{% endcapture %}
{% assign catalogue_spec_rows = catalogue_spec_rows | strip %}
{% if usb_c_confirmed_handles contains target_product.handle or catalogue_spec_rows != blank %}
<div class="tr-pdp-specifications">
<h2 style="font-size:16px;margin:16px 0 8px;">Key specifications</h2>
<dl class="tr-catalog-spec-list">
{{ catalogue_spec_rows }}
{% if usb_c_confirmed_handles contains target_product.handle %}<div class="tr-catalog-spec-row"><dt>Charging input</dt><dd>USB-C</dd></div>{% endif %}
</dl>
</div>
{% endif %}

        <!-- Dynamic Price Box -->
        <div class="tr-pdp-price-box">
          <span class="tr-pdp-price" id="tr-pdp-price-val-{{ section.id }}">{{ p_price }}</span>
          <span class="tr-pdp-mrp" id="tr-pdp-compare-val-{{ section.id }}" {% if p_compare == blank %}style="display:none;"{% endif %}>{{ p_compare }}</span>
          <span class="tr-pdp-discount-badge" id="tr-pdp-discount-val-{{ section.id }}" {% if discount_text == blank %}style="display:none;"{% endif %}>{{ discount_text }}</span>
        </div>

        <!-- Dynamic Variant / Color Swatches -->
        {% if target_product != blank and target_product.variants.size > 1 %}
          <div class="tr-swatch-section">
            <div class="tr-swatch-label">
              {{ target_product.options.first | default: 'Option' }}: 
              <span id="tr-selected-color-name-{{ section.id }}" style="color: var(--tr-accent);">{{ current_variant.title }}</span>
            </div>
            <div class="tr-swatches-row">
              {% for variant in target_product.variants %}
                {%- liquid
                  assign v_price = variant.price | money
                  assign v_compare = ''
                  assign v_discount = ''
                  if variant.compare_at_price > variant.price
                    assign v_compare = variant.compare_at_price | money
                    assign v_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                    assign v_discount = v_pct | append: '% OFF'
                  endif
                  assign v_img = ''
                  if variant.featured_image != blank
                    assign v_img = variant.featured_image | image_url: width: 1000
                  endif
                -%}
                <button 
                  type="button"
                  class="tr-swatch-btn {% if variant.id == current_variant.id %}active{% endif %}" 
                  data-variant-id="{{ variant.id }}"
                  data-available="{{ variant.available }}"
                  data-color-name="{{ variant.title | escape }}" 
                  data-price="{{ v_price }}"
                  data-compare="{{ v_compare }}"
                  data-discount="{{ v_discount }}"
                  data-img-url="{{ v_img }}"
                >
                  {% if variant.featured_image != blank %}
                    <span class="tr-swatch-color-circle" style="background-image: url('{{ variant.featured_image | image_url: width: 60 }}');"></span>
                  {% else %}
                    <span class="tr-swatch-color-circle" style="background: {{ variant.title | split: ' ' | last | downcase }};"></span>
                  {% endif %}
                  {{ variant.title }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Personalise Engraving (Connected to Order Line Item Properties) -->
        {% if section.settings.enable_personalisation %}
          <div class="tr-personalise-box">
            <label for="tr-engrave-text-{{ section.id }}">✨ {{ section.settings.personalise_label | default: 'Make Your Product Personalised (Optional Free Engraving)' }}</label>
            <input 
              type="text" 
              name="properties[Engraving]"
              id="tr-engrave-text-{{ section.id }}" 
              class="tr-personalise-input" 
              placeholder="{{ section.settings.personalise_placeholder | default: 'Enter name or initials to engrave on case (Max 12 chars)' }}" 
              maxlength="12"
            >
          </div>
        {% endif %}

        <!-- Offer Coupon Box -->
        {% if section.settings.show_coupon %}
          <div class="tr-coupon-banner">
            <div class="tr-coupon-text">
              <span>🏷️ {{ section.settings.coupon_text | default: 'Get 15% OFF on 2 or More Items' }}</span>
            </div>
            <span class="tr-coupon-code-pill" id="tr-coupon-pill-{{ section.id }}" title="Click to copy">
              {{ section.settings.coupon_code | default: 'Use Code: TR15' }}
            </span>
          </div>
        {% endif %}

        <!-- Pincode Delivery Check -->
        {% if section.settings.show_pincode %}
          <div class="tr-pincode-block">
            <label style="font-size: 13px; font-weight: 700; margin-bottom: 8px; display: block;">{{ section.settings.pincode_label | default: 'Check Estimated Delivery Date' }}</label>
            <div class="tr-pincode-wrap">
              <input type="text" class="tr-pincode-input" id="tr-pincode-input-{{ section.id }}" placeholder="Enter 6-Digit Delivery Pincode" maxlength="6" inputmode="numeric">
              <button type="button" class="tr-btn-check" id="tr-pincode-btn-{{ section.id }}">CHECK</button>
            </div>
            <div id="tr-pincode-msg-{{ section.id }}" style="font-size: 12.5px; margin-top: 8px; font-weight: 600; display: none;"></div>
          </div>
        {% endif %}

        <!-- Dynamic CTA Buttons -->
        <div class="tr-pdp-actions">
          {% if section.settings.show_buy_now %}
            <button 
              type="button" 
              class="tr-btn-buy-now" 
              id="tr-buy-now-btn-{{ section.id }}"
              {% if current_variant != blank and current_variant.available == false %}disabled{% endif %}
            >
              ⚡ {{ section.settings.buy_now_label | default: 'BUY IT NOW - PAY ON DELIVERY / UPI' }}
            </button>
          {% endif %}
          <button 
            type="submit" 
            class="tr-btn-add-cart" 
            id="tr-add-cart-btn-{{ section.id }}"
            {% if current_variant != blank and current_variant.available == false %}disabled{% endif %}
          >
            {% if current_variant != blank and current_variant.available == false %}
              SOLD OUT
            {% else %}
              {{ section.settings.add_to_cart_label | default: 'ADD TO CART' }}
            {% endif %}
          </button>
        </div>

        <!-- 4 PDP Trust Badges -->
        <div class="tr-pdp-badges-grid">
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/ACwO-Free-Shipping.webp?v=1701524211" alt="Delivery" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_1_text | default: 'Free Shipping' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/365-days-warranty-icon.png?v=1715862240" alt="Warranty support" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_2_text | default: '1 Year Warranty' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/ACwO-72Hrs-Replacement-Policy.webp?v=1701511254" alt="Replacement support" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_3_text | default: '72h Replacement' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/GST-Billing.png?v=1717494620" alt="Checkout" width="32" height="32" loading="lazy">
            <span>{{ section.settings.badge_4_text | default: 'GST Billing' }}</span>
          </div>
        </div>
      </form>

    </div>
  </div>
</section>

<section class="grooves-product-help" aria-labelledby="product-help-{{ section.id }}" style="max-width:1280px;margin:0 auto;padding:20px 24px;line-height:1.6;">
<h2 id="product-help-{{ section.id }}" style="font-size:24px;">Product help for {{ product.title | escape }}</h2>
{% if usb_c_confirmed_handles contains product.handle %}
<h3 id="product-charging-{{ section.id }}" style="font-size:18px;">How is {{ product.title | escape }} charged?</h3>
<p>{{ product.title | escape }} uses a USB-C charging input. Follow the model’s charging instructions and confirm the required power input before choosing an adapter.</p>
{% endif %}
<h3 id="product-compatibility-help-{{ section.id }}" style="font-size:18px;">How can I confirm compatibility for {{ product.title | escape }}?</h3>
<p>Check the specifications above for the exact model and selected option. If a required connection or feature is not listed, <a href="/pages/contact">contact Grooves support</a> with your device model before ordering; specifications from another Grooves product should not be assumed to apply.</p>
<h3 id="product-order-terms-{{ section.id }}" style="font-size:18px;">Which delivery and return terms apply to {{ product.title | escape }}?</h3>
<p>Review the <a href="/policies/shipping-policy">shipping policy</a> and <a href="/policies/refund-policy">refund policy</a>. Delivery details are shown during checkout. Ask <a href="mailto:support@grooveslifestyle.com">Grooves customer support</a> to confirm warranty coverage and package contents for the exact model if they are not specified.</p>
<p><a href="{{ routes.all_products_collection_url }}">Explore all Grooves products</a>.</p>
</section>


<script>
(function() {
  const sectionEl = document.getElementById('tr-pdp-hero-{{ section.id }}');
  if (!sectionEl) return;

  const mainImg = document.getElementById('tr-main-display-img-{{ section.id }}');
  const variantInput = document.getElementById('tr-variant-id-{{ section.id }}');
  const colorNameEl = document.getElementById('tr-selected-color-name-{{ section.id }}');
  const priceEl = document.getElementById('tr-pdp-price-val-{{ section.id }}');
  const compareEl = document.getElementById('tr-pdp-compare-val-{{ section.id }}');
  const discountEl = document.getElementById('tr-pdp-discount-val-{{ section.id }}');
  const addToCartBtn = document.getElementById('tr-add-cart-btn-{{ section.id }}');
  const buyNowBtn = document.getElementById('tr-buy-now-btn-{{ section.id }}');
  const form = document.getElementById('tr-pdp-form-{{ section.id }}');
  const defaultAddText = {{ section.settings.add_to_cart_label | default: 'ADD TO CART' | json }};

  // 1. Thumbnail Switching
  sectionEl.querySelectorAll('.tr-pdp-thumb-item').forEach(thumb => {
    thumb.addEventListener('click', function() {
      sectionEl.querySelectorAll('.tr-pdp-thumb-item').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      const src = this.getAttribute('data-media-src');
      if (src && mainImg) mainImg.src = src;
    });
  });

  // 2. Dynamic Variant / Color Swatch Switching
  sectionEl.querySelectorAll('.tr-swatch-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      sectionEl.querySelectorAll('.tr-swatch-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');

      const vId = this.getAttribute('data-variant-id');
      const colorName = this.getAttribute('data-color-name');
      const imgUrl = this.getAttribute('data-img-url');
      const price = this.getAttribute('data-price');
      const compare = this.getAttribute('data-compare');
      const discount = this.getAttribute('data-discount');
      const available = this.getAttribute('data-available') !== 'false';

      if (colorNameEl && colorName) colorNameEl.textContent = colorName;
      if (imgUrl && mainImg) mainImg.src = imgUrl;
      if (vId && variantInput) {
        variantInput.value = vId;
        if (window.history && window.history.replaceState && window.location.pathname.includes('/products/')) {
          const newUrl = window.location.pathname + '?variant=' + vId;
          window.history.replaceState({ path: newUrl }, '', newUrl);
        }
      }

      if (price && priceEl) priceEl.textContent = price;
      if (compareEl) {
        if (compare) {
          compareEl.textContent = compare;
          compareEl.style.display = 'inline';
        } else {
          compareEl.style.display = 'none';
        }
      }
      if (discountEl) {
        if (discount) {
          discountEl.textContent = discount;
          discountEl.style.display = 'inline-block';
        } else {
          discountEl.style.display = 'none';
        }
      }

      if (addToCartBtn) {
        addToCartBtn.disabled = !available;
        addToCartBtn.textContent = available ? defaultAddText : 'SOLD OUT';
      }
      if (buyNowBtn) {
        buyNowBtn.disabled = !available;
      }
    });
  });

  // 3. Pincode Delivery Checker
  const pinBtn = document.getElementById('tr-pincode-btn-{{ section.id }}');
  const pinInput = document.getElementById('tr-pincode-input-{{ section.id }}');
  const pinMsg = document.getElementById('tr-pincode-msg-{{ section.id }}');

  if (pinBtn && pinInput && pinMsg) {
    pinBtn.addEventListener('click', function() {
      const val = pinInput.value.trim();
      if (/^[1-9][0-9]{5}$/.test(val)) {
        pinMsg.style.display = 'block';
        pinMsg.style.color = 'var(--tr-accent)';
        pinMsg.textContent = '✓ Delivery expected in 2-4 business days to ' + val + '. Free shipping eligible!';
      } else {
        pinMsg.style.display = 'block';
        pinMsg.style.color = '#ff4d4d';
        pinMsg.textContent = '✕ Please enter a valid 6-digit Indian PIN code.';
      }
    });
  }

  // 4. Coupon Copy on Click
  const couponPill = document.getElementById('tr-coupon-pill-{{ section.id }}');
  if (couponPill) {
    couponPill.addEventListener('click', function() {
      const rawText = this.textContent.replace(/Use Code:/i, '').trim();
      navigator.clipboard.writeText(rawText).then(() => {
        const old = this.textContent;
        this.textContent = 'COPIED: ' + rawText + ' ✓';
        setTimeout(() => { this.textContent = old; }, 2000);
      });
    });
  }

  // 5. Real Shopify Add to Cart & Buy Now AJAX
  async function handleCartAction(redirectToCheckout) {
    if (!form) return;
    const vId = variantInput ? variantInput.value : '';
    if (!vId) {
      alert('Please select a product in Theme Customizer settings or open this on a Product page.');
      return;
    }

    const formData = new FormData(form);
    const activeBtn = redirectToCheckout ? buyNowBtn : addToCartBtn;
    const originalText = activeBtn ? activeBtn.innerHTML : '';

    if (activeBtn) {
      activeBtn.disabled = true;
      activeBtn.innerHTML = redirectToCheckout ? 'REDIRECTING TO CHECKOUT...' : 'ADDING TO CART...';
    }

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
      });

      if (!response.ok) throw new Error('Failed to add item');
      const itemData = await response.json();

      if (redirectToCheckout) {
        window.location.href = '/checkout';
      } else {
        if (activeBtn) activeBtn.innerHTML = 'ADDED TO CART ✓';
        window.dispatchEvent(new Event('cart:refresh'));
        document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: itemData } }));
        setTimeout(() => {
          window.location.href = '/cart';
        }, 500);
      }
    } catch (err) {
      console.error(err);
      alert('Could not add product to cart. Please check stock availability.');
      if (activeBtn) {
        activeBtn.disabled = false;
        activeBtn.innerHTML = originalText;
      }
    }
  }

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      handleCartAction(false);
    });
  }

  if (buyNowBtn) {
    buyNowBtn.addEventListener('click', function(e) {
      e.preventDefault();
      handleCartAction(true);
    });
  }
})();
</script>


{% comment %}Product data for this custom PDP only. Native Shopify product sections retain their own schema. Prices and stock are read from current variant objects; zero/unset prices do not create free offers.{% endcomment %}
{% if product != blank %}
{% assign schema_offer_count = 0 %}
{% for schema_variant in product.variants %}{% if schema_variant.price > 0 %}{% assign schema_offer_count = schema_offer_count | plus: 1 %}{% endif %}{% endfor %}
<script type="application/ld+json" id="grooves-product-schema-{{ section.id }}">
{
"@context":"https://schema.org",
"@type":"Product",
"@id":{{ canonical_url | append: '#product' | json }},
"name":{{ product.title | json }},
"url":{{ canonical_url | json }},
"brand":{"@type":"Brand","name":{{ product.vendor | default: 'Grooves' | json }}},
"mainEntityOfPage":{"@id":{{ canonical_url | append: '#webpage' | json }}}
{% if product.type != blank %},"category":{{ product.type | json }}{% endif %}
{% if product.selected_or_first_available_variant.sku != blank %},"sku":{{ product.selected_or_first_available_variant.sku | json }}{% endif %}
{% if product.images.size > 0 %},"image":[{% for schema_image in product.images limit: 6 %}{{ schema_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endif %}
{% if schema_offer_count > 0 %},"offers":[
{% assign schema_offer_written = false %}
{% for schema_variant in product.variants %}{% if schema_variant.price > 0 %}{% if schema_offer_written %},{% endif %}
{"@type":"Offer","url":{{ request.origin | append: schema_variant.url | json }},"price":{{ schema_variant.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | default: shop.currency | json }},"availability":"https://schema.org/{% if schema_variant.available %}InStock{% else %}OutOfStock{% endif %}","seller":{"@id":{{ request.origin | append: '/#organization' | json }}}{% if schema_variant.sku != blank %},"sku":{{ schema_variant.sku | json }}{% endif %}}
{% assign schema_offer_written = true %}{% endif %}{% endfor %}
]{% endif %}
}
</script>
{% endif %}



<dialog class="grooves-share-dialog" id="grooves-share-dialog-{{ section.id }}" aria-labelledby="grooves-share-title-{{ section.id }}" data-share-title="{{ target_product.title | escape }}" data-share-url="{{ shop.url | append: target_product.url | escape }}">
