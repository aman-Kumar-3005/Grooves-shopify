{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign prod_title = product.title | default: section.settings.product_title | default: "Grooves Pulse Pro ANC - Wireless Earbuds with Qi Fast Charging"
  assign prod_subtitle = product.metafields.custom.subtitle.value | default: product.metafields.custom.subtitle | default: section.settings.product_subtitle | default: "Hybrid Active Noise Cancellation | 60-Hour Total Playtime | Quad-Mic ENC"
  assign p_price = current_variant.price | money | default: section.settings.fallback_price | default: "₹1,499"
  assign p_compare = current_variant.compare_at_price | money | default: section.settings.fallback_compare_price | default: "₹4,999"
-%}

<section class="tr-pdp-top-wrapper" id="tr-pdp-hero-{{ section.id }}">
  <div class="tr-container">
    <div class="tr-pdp-grid">
      <!-- Media Gallery (Left) -->
      <div class="tr-pdp-gallery-wrap">
        <div class="tr-pdp-thumbnails">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div class="tr-pdp-thumb-item {% if forloop.first %}active{% endif %}" data-media-src="{{ media | image_url: width: 1000 }}" data-type="{{ media.media_type }}">
                <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | default: prod_title }}" loading="lazy" width="64" height="64">
              </div>
            {% endfor %}
          {% else %}
            <div class="tr-pdp-thumb-item active" data-media-src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Earbuds.png?v=1723186673" data-type="image">
              <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Earbuds.png?v=1723186673" alt="Grooves Pulse Pro White" loading="lazy" width="64" height="64">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/wireless-audio.jpg?v=1781096198" data-type="image">
              <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/wireless-audio.jpg?v=1781096198" alt="Grooves Pulse Pro Carbon" loading="lazy" width="64" height="64">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/bestseller.jpg?v=1781096198" data-type="image">
              <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/bestseller.jpg?v=1781096198" alt="Grooves Pulse Pro Blue" loading="lazy" width="64" height="64">
            </div>
            <div class="tr-pdp-thumb-item" data-media-src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Portable-Powerbank.jpg?v=1776514365" data-type="image">
              <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Portable-Powerbank.jpg?v=1776514365" alt="Grooves Fast Charge Case" loading="lazy" width="64" height="64">
            </div>
          {% endif %}
        </div>

        <div class="tr-pdp-main-media">
          <img 
            id="tr-main-display-img" 
            src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 }}{% else %}https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Earbuds.png?v=1723186673{% endif %}" 
            alt="{{ prod_title }}"
            width="600"
            height="600"
          >
        </div>
      </div>

      <!-- Product Info Column (Right) -->
      <div class="tr-pdp-details">
        <!-- Rating Row -->
        {% if section.settings.show_rating %}
          <div class="tr-pdp-rating-row">
            <span class="tr-pdp-stars">★★★★★</span>
            <strong style="color: #fff;">{{ section.settings.rating_score | default: '4.8' }}</strong>
            <span class="tr-pdp-review-count">| {{ section.settings.reviews_count | default: '128 Verified Reviews' }}</span>
          </div>
        {% endif %}

        <!-- Title & Subtitle -->
        <h1 class="tr-pdp-title">{{ prod_title }}</h1>
        {% if prod_subtitle != blank %}
          <p class="tr-pdp-subtitle">{{ prod_subtitle }}</p>
        {% endif %}

        <!-- Price Box -->
        <div class="tr-pdp-price-box">
          <span class="tr-pdp-price" id="tr-pdp-price-val">{{ p_price }}</span>
          {% if p_compare != blank and p_compare != '$0.00' %}
            <span class="tr-pdp-mrp" id="tr-pdp-compare-val">{{ p_compare }}</span>
            <span class="tr-pdp-discount-badge">{{ section.settings.discount_badge_text | default: '70% OFF' }}</span>
          {% endif %}
        </div>

        <!-- Color Swatches -->
        <div class="tr-swatch-section">
          <div class="tr-swatch-label">Color: <span id="tr-selected-color-name" style="color: var(--tr-accent);">Moon White</span></div>
          <div class="tr-swatches-row">
            <button class="tr-swatch-btn active" data-color-name="Moon White" data-img-url="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Earbuds.png?v=1723186673">
              <span class="tr-swatch-color-circle" style="background: #ffffff;"></span>
              Moon White
            </button>
            <button class="tr-swatch-btn" data-color-name="Carbon Black" data-img-url="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/wireless-audio.jpg?v=1781096198">
              <span class="tr-swatch-color-circle" style="background: #111111;"></span>
              Carbon Black
            </button>
            <button class="tr-swatch-btn" data-color-name="Steel Blue" data-img-url="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/bestseller.jpg?v=1781096198">
              <span class="tr-swatch-color-circle" style="background: #3b5998;"></span>
              Steel Blue
            </button>
          </div>
        </div>

        <!-- Personalise Engraving -->
        {% if section.settings.enable_personalisation %}
          <div class="tr-personalise-box">
            <label for="tr-engrave-text">✨ {{ section.settings.personalise_label | default: 'Make Your Product Personalised (Free Custom Engraving by Grooves Lifestyle)' }}</label>
            <input 
              type="text" 
              id="tr-engrave-text" 
              class="tr-personalise-input" 
              placeholder="{{ section.settings.personalise_placeholder | default: 'Enter name or initials to engrave on case (Max 12 chars)' }}" 
              maxlength="12"
            >
          </div>
        {% endif %}

        <!-- Offer Coupon Box -->
        {% if section.settings.show_coupon %}
          <div class="tr-coupon-banner">
            <div class="tr-coupon-text">
              <span>🏷️ {{ section.settings.coupon_text | default: 'Get 10% OFF on Prepaid Orders' }}</span>
            </div>
            <span class="tr-coupon-code-pill">{{ section.settings.coupon_code | default: 'Use Code: GROOVES10' }}</span>
          </div>
        {% endif %}

        <!-- Pincode Delivery Check -->
        {% if section.settings.show_pincode %}
          <div>
            <label style="font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 6px; display: block;">{{ section.settings.pincode_label | default: 'Check Estimated Delivery Date' }}</label>
            <div class="tr-pincode-wrap">
              <input type="text" class="tr-pincode-input" id="tr-pincode-input" placeholder="Enter Delivery Pincode" maxlength="6">
              <button type="button" class="tr-btn tr-btn-dark" style="padding: 10px 20px;" onclick="checkPincode()">CHECK</button>
            </div>
            <div id="tr-pincode-msg" style="font-size: 12px; margin-top: 6px; color: var(--tr-accent); display: none;">
              ✓ Delivery expected in 2-4 business days. Free shipping eligible!
            </div>
          </div>
        {% endif %}

        <!-- CTA Buttons -->
        <div class="tr-pdp-actions">
          {% if section.settings.show_buy_now %}
            <button type="button" class="tr-btn-buy-now" onclick="alert('Proceeding to Instant Fast Checkout...')">
              ⚡ {{ section.settings.buy_now_label | default: 'BUY IT NOW - PAY ON DELIVERY / UPI' }}
            </button>
          {% endif %}
          <button type="button" class="tr-btn-add-cart" onclick="alert('Item added to cart!')">
            {{ section.settings.add_to_cart_label | default: 'ADD TO CART' }}
          </button>
        </div>

        <!-- 4 PDP Trust Badges -->
        <div class="tr-pdp-badges-grid">
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Track-order.png?v=1745498991" alt="Free Shipping" width="36" height="36">
            <span>{{ section.settings.badge_1_text | default: 'Free Shipping' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/warranty_7c995ef0-7603-4c91-9e2c-358aa029fbf7.png?v=1745498991" alt="1 Year Warranty" width="36" height="36">
            <span>{{ section.settings.badge_2_text | default: '1 Year Warranty' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Return_product.png?v=1745498991" alt="7 Days Replacement" width="36" height="36">
            <span>{{ section.settings.badge_3_text | default: '7 Days Replacement' }}</span>
          </div>
          <div class="tr-pdp-badge-item">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/GST-Billing.png?v=1717494620" alt="GST Billing" width="36" height="36">
            <span>{{ section.settings.badge_4_text | default: 'GST Billing' }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Thumbnail switching logic
  document.querySelectorAll('.tr-pdp-thumb-item').forEach(thumb => {
    thumb.addEventListener('click', function() {
      document.querySelectorAll('.tr-pdp-thumb-item').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      const src = this.getAttribute('data-media-src');
      document.getElementById('tr-main-display-img').src = src;
    });
  });

  // Color Swatches
  document.querySelectorAll('.tr-swatch-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.tr-swatch-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const colorName = this.getAttribute('data-color-name');
      const imgUrl = this.getAttribute('data-img-url');
      document.getElementById('tr-selected-color-name').textContent = colorName;
      if (imgUrl) {
        document.getElementById('tr-main-display-img').src = imgUrl;
      }
    });
  });

  function checkPincode() {
    const input = document.getElementById('tr-pincode-input');
    const msg = document.getElementById('tr-pincode-msg');
    if (input.value.length >= 6) {
      msg.style.display = 'block';
    } else {
      alert('Please enter a valid 6-digit Indian PIN code');
    }
  }
</script>

