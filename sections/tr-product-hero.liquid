  <div class="grooves-share-product">{% if target_product.featured_image %}<img src="{{ target_product.featured_image | image_url: width: 160 }}" width="64" height="64" alt="" loading="lazy">{% endif %}<p>{{ target_product.title | escape }}</p></div>
  <div class="grooves-share-options">
    <a class="grooves-share-option" href="https://wa.me/?text={{ target_product.title | append: ' ' | append: shop.url | append: target_product.url | url_encode }}" target="_blank" rel="noopener noreferrer"><span class="grooves-share-circle grooves-share-wa"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/><path d="M8 7c-2 3 3 8 6 8l2-2-3-1-1 1-2-2 1-1-1-3Z"/></svg></span><span>WhatsApp</span></a>
    <a class="grooves-share-option" href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: target_product.url | url_encode }}" target="_blank" rel="noopener noreferrer"><span class="grooves-share-circle grooves-share-fb" aria-hidden="true">f</span><span>Facebook</span></a>
    <a class="grooves-share-option" href="https://twitter.com/intent/tweet?url={{ shop.url | append: target_product.url | url_encode }}&text={{ target_product.title | url_encode }}" target="_blank" rel="noopener noreferrer"><span class="grooves-share-circle grooves-share-x" aria-hidden="true">𝕏</span><span>X</span></a>
    <a class="grooves-share-option" href="mailto:?subject={{ target_product.title | url_encode }}&body={{ shop.url | append: target_product.url | url_encode }}"><span class="grooves-share-circle grooves-share-email"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></span><span>Email</span></a>
  </div>
  <div class="grooves-share-copy"><input aria-label="Product link" type="text" readonly value="{{ shop.url | append: target_product.url | escape }}"><button type="button" data-share-copy>Copy link</button></div>
  <p class="grooves-share-status" role="status" aria-live="polite"></p>
  <button type="button" class="grooves-share-more" hidden>More sharing options</button>
</dialog>
