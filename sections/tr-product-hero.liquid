<div class="tr-catalog-spec-row"><dt>Bluetooth version</dt><dd>5.4</dd></div>
<div class="tr-catalog-spec-row"><dt>Wireless range</dt><dd>10–15 m</dd></div>
<div class="tr-catalog-spec-row"><dt>Playback time</dt><dd>5–6 hours</dd></div>
<div class="tr-catalog-spec-row"><dt>Standby time</dt><dd>150 days</dd></div>
<div class="tr-catalog-spec-row"><dt>Water resistance rating</dt><dd>IPX5</dd></div>
{% when 'grooves-fire-earuds', 'grooves-fire-earuds-white' %}
<div class="tr-catalog-spec-row"><dt>Type</dt><dd>True wireless earbuds (TWS)</dd></div>
<div class="tr-catalog-spec-row"><dt>Battery capacity</dt><dd>250 mAh</dd></div>
<div class="tr-catalog-spec-row"><dt>Bluetooth version</dt><dd>5.3</dd></div>
<div class="tr-catalog-spec-row"><dt>Wireless range</dt><dd>10–15 m</dd></div>
<div class="tr-catalog-spec-row"><dt>Playback time</dt><dd>20 hours</dd></div>
<div class="tr-catalog-spec-row"><dt>Standby time</dt><dd>150 hours</dd></div>
<div class="tr-catalog-spec-row"><dt>Water resistance rating</dt><dd>IPX5</dd></div>
{% when 'grooves-aximo-neckband', 'grooves-ullet-eckad' %}
<div class="tr-catalog-spec-row"><dt>Type</dt><dd>Wireless neckband earphones</dd></div>
<div class="tr-catalog-spec-row"><dt>Bluetooth version</dt><dd>5.4</dd></div>
<div class="tr-catalog-spec-row"><dt>Wireless range</dt><dd>15 m</dd></div>
<div class="tr-catalog-spec-row"><dt>Battery</dt><dd>3.7 V, 200 mAh; double IC</dd></div>
<div class="tr-catalog-spec-row"><dt>Music playback</dt><dd>40 hours at 60% volume</dd></div>
<div class="tr-catalog-spec-row"><dt>Charging voltage</dt><dd>5 V</dd></div>
<div class="tr-catalog-spec-row"><dt>Charging</dt><dd>USB-C fast charging</dd></div>
<div class="tr-catalog-spec-row"><dt>Driver</dt><dd>10 mm copper driver</dd></div>
<div class="tr-catalog-spec-row"><dt>Chipset</dt><dd>JL7023</dd></div>
