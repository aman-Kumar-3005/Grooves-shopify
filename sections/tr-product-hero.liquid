.grooves-share-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}
.grooves-share-header h2{font:700 20px/1.3 inherit;font-family:inherit;font-size:20px;font-weight:700;line-height:1.3;margin:0;text-transform:none;letter-spacing:0;color:#17233b}
.grooves-share-close{font:28px/1 inherit;font-family:inherit;font-size:28px;line-height:1;width:36px;height:36px;flex-shrink:0;border:0;border-radius:50%;background:#f3f5f7;color:#364152;cursor:pointer}
.grooves-share-product{display:flex;align-items:center;gap:14px;padding-bottom:20px;border-bottom:1px solid #edf0f3;margin-bottom:22px}
.grooves-share-product img{object-fit:contain;border-radius:10px;background:#fff;flex-shrink:0}
.grooves-share-product p{font-size:14px;line-height:1.5;font-weight:600;margin:0;overflow-wrap:anywhere}
.grooves-share-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:24px}
.grooves-share-option{display:flex;flex-direction:column;align-items:center;gap:9px;text-decoration:none;color:#263244;font-size:12px;line-height:1.4;min-width:0}
.grooves-share-circle{width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;transition:transform .15s}
.grooves-share-option:hover .grooves-share-circle{transform:translateY(-2px)}
.grooves-share-wa{background:#e8f8ed;color:#128c4a}.grooves-share-fb{background:#eaf1ff;color:#1877f2;font-family:Arial,sans-serif}.grooves-share-x{background:#f0f2f4;color:#111}.grooves-share-email{background:#eef0ff;color:#5557b8}
.grooves-share-copy{display:flex;align-items:center;border:1px solid #d9dfe7;background:#f7f8fa;border-radius:9px;padding:5px;gap:5px;min-width:0}
.grooves-share-copy input{min-width:0;flex:1;width:0;border:0;box-shadow:none;outline-offset:0;background:transparent;color:#5a6576;font-size:12px;padding:8px}
.grooves-share-copy button{min-height:40px;white-space:nowrap;background:#17233b;color:#fff;border:0;border-radius:6px;padding:8px 14px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.grooves-share-status{margin:8px 0 0;font-size:12px;color:#167047;min-height:18px}
.grooves-share-more{display:block;width:100%;min-height:44px;margin-top:8px;padding:10px;border:1px solid #d9dfe7;border-radius:8px;color:#17233b;background:#fff;font:inherit;font-size:13px;cursor:pointer}
.grooves-share-more[hidden]{display:none}
.grooves-share-trigger:focus-visible,.grooves-share-dialog button:focus-visible,.grooves-share-dialog a:focus-visible{outline:2px solid #2780bd;outline-offset:3px}
@media(max-width:600px){.grooves-share-trigger{top:12px;right:12px}.grooves-share-dialog{inset:auto 0 0;margin:0;width:100%;max-width:100%;border-radius:20px 20px 0 0;padding:22px 20px max(22px,env(safe-area-inset-bottom));max-height:90dvh}.grooves-share-header{margin-bottom:18px}}
@media(prefers-reduced-motion:reduce){.grooves-share-circle,.grooves-share-trigger{transition:none}}
</style>
<script>
(function(){
 var dialog=document.getElementById('grooves-share-dialog-{{ section.id }}');
 var trigger=document.querySelector('[aria-controls="grooves-share-dialog-{{ section.id }}"]');
 if(!dialog||!trigger||dialog.dataset.ready)return;
 dialog.dataset.ready='true';
 document.body.appendChild(dialog);
 var status=dialog.querySelector('.grooves-share-status'),input=dialog.querySelector('input'),copy=dialog.querySelector('[data-share-copy]'),more=dialog.querySelector('.grooves-share-more');
 trigger.addEventListener('click',function(){status.textContent='';copy.textContent='Copy link';dialog.showModal();});
 dialog.querySelector('.grooves-share-close').addEventListener('click',function(){dialog.close();});
 dialog.addEventListener('click',function(event){if(event.target===dialog){var r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
 dialog.addEventListener('close',function(){trigger.focus({preventScroll:true});});
 copy.addEventListener('click',async function(){var ok=false;
 if(navigator.clipboard&&window.isSecureContext){try{await navigator.clipboard.writeText(dialog.dataset.shareUrl);ok=true;}catch(e){}}
 if(!ok){input.focus();input.select();input.setSelectionRange(0,input.value.length);try{ok=document.execCommand('copy');}catch(e){}}
 status.textContent=ok?'Link copied!':'Select and copy the link above.';copy.textContent=ok?'Copied!':'Copy link';
 });
 if(navigator.share){more.hidden=false;more.addEventListener('click',async function(){try{await navigator.share({title:dialog.dataset.shareTitle,url:dialog.dataset.shareUrl});}catch(e){if(e.name!=='AbortError')status.textContent='Choose an option above or copy the link.';}});}
})();
</script>


