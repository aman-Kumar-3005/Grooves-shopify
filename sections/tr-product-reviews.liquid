{% comment %}
Unverified template reviews, ratings, customer photos and testimonials removed.
Display future genuine product reviews through a verified review provider.
{% endcomment %}
{% schema %}
{
  "name": "TR PDP Reviews",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score"
    },
    {
      "type": "text",
      "id": "reviews_count",
      "label": "Reviews Count Text"
    },
    {
      "type": "checkbox",
      "id": "show_customer_photos",
      "label": "Show Customer Photos Grid",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_reviews_list",
      "label": "Show Review Cards",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer Badge",
          "default": false
        },
        {
          "type": "select",
          "id": "stars",
          "label": "Star Rating",
          "options": [
            {
              "value": "★★★★★",
              "label": "5 Stars"
            },
            {
              "value": "★★★★☆",
              "label": "4 Stars"
            },
            {
              "value": "★★★☆☆",
              "label": "3 Stars"
            }
          ],
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Heading"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Body"
        },
        {
          "type": "text",
          "id": "variant_info",
          "label": "Purchased Variant & Date"
        }
      ]
    },
    {
      "type": "photo",
      "name": "Customer Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Photo (Upload)"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Or Photo URL (Fallback)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TR PDP Reviews"
    }
  ]
}
{% endschema %}
