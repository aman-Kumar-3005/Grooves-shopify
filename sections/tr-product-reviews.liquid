{%- liquid
  assign r_score = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.custom.rating.value | default: product.metafields.custom.rating | default: "4.8"
  assign r_count = product.metafields.reviews.rating_count | default: product.metafields.custom.review_count | default: "128"
-%}

<section class="tr-reviews-section" id="tr-reviews-{{ section.id }}" style="background: #0a0a0a; border-top: 1px solid #1f1f1f; position: relative; z-index: 20; clear: both;">
  <div class="tr-container">
    <div class="tr-reviews-container">
      <!-- Reviews Header -->
      <div class="tr-reviews-header">
        <div class="tr-section-badge-wrap" style="margin-top: 0;">
          <span class="tr-section-pill">CUSTOMER REVIEWS</span>
        </div>
        <div class="tr-reviews-score">{{ r_score }} <span style="font-size: 28px; color: var(--tr-gold);">★★★★★</span></div>
        <p style="color: #888888; font-size: 15px; margin: 0;">Based on {{ r_count }} verified customer reviews</p>
      </div>

      <!-- Customer Photos Grid -->
      <div class="tr-customer-photos-grid">
        {% if product.metafields.custom.customer_photos.value != blank %}
          {% for photo in product.metafields.custom.customer_photos.value limit: 6 %}
            <div class="tr-customer-photo-card">
              <img src="{{ photo | image_url: width: 300 }}" alt="Customer review photo" loading="lazy">
            </div>
          {% endfor %}
        {% else %}
          <div class="tr-customer-photo-card">
            <img src="//acwo.com/cdn/shop/files/dwots_fire_9.png?v=1783600774" alt="Customer review photo 1" loading="lazy">
          </div>
          <div class="tr-customer-photo-card">
            <img src="//acwo.com/cdn/shop/files/DwOTS_Firenew-black.png?v=1772185073" alt="Customer review photo 2" loading="lazy">
          </div>
          <div class="tr-customer-photo-card">
            <img src="//acwo.com/cdn/shop/files/dwots-fire_c6ef8f2a-15bc-4428-84ca-c1066661bf8d.webp?v=1772179131" alt="Customer review photo 3" loading="lazy">
          </div>
          <div class="tr-customer-photo-card">
            <img src="//acwo.com/cdn/shop/files/Fire_Black_New_3D.gif?v=1772180394" alt="Customer review photo 4" loading="lazy">
          </div>
          <div class="tr-customer-photo-card">
            <img src="//acwo.com/cdn/shop/files/fire-rotating-black.webp?v=1772185073" alt="Customer review photo 5" loading="lazy">
          </div>
          <div class="tr-customer-photo-card">
            <img src="https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Home-DwOTSFire-Prime-web.webp?v=1745321002" alt="Customer review photo 6" loading="lazy">
          </div>
        {% endif %}
      </div>

      <!-- Review Cards Grid -->
      <div class="tr-review-cards-grid">
        <div class="tr-review-card">
          <div class="tr-reviewer-header">
            <span class="tr-reviewer-name">Rahul Sharma</span>
            <span class="tr-verified-badge">✓ Verified Buyer</span>
          </div>
          <div class="tr-pdp-stars">★★★★★</div>
          <h4 style="color: #fff; margin: 0; font-size: 15px;">2 Pairs in 1 Case is Pure Genius!</h4>
          <p class="tr-review-text">
            I was skeptical about two pairs fitting inside one pocket-sized case, but TR nailed the design! The in-ear pair gives punchy bass for gym sessions and the half-in-ear is so lightweight for office meetings. Wireless charging works flawlessly on my Qi pad.
          </p>
          <span style="font-size: 11px; color: #666;">Purchased: Moon White • 3 days ago</span>
        </div>

        <div class="tr-review-card">
          <div class="tr-reviewer-header">
            <span class="tr-reviewer-name">Ananya Verma</span>
            <span class="tr-verified-badge">✓ Verified Buyer</span>
          </div>
          <div class="tr-pdp-stars">★★★★★</div>
          <h4 style="color: #fff; margin: 0; font-size: 15px;">Unbeatable Battery & Sound Quality</h4>
          <p class="tr-review-text">
            Battery life easily lasts over a week without needing a recharge. Quad mic ENC does an outstanding job cutting down street noise when I'm on work calls outside. Definitely worth every rupee.
          </p>
          <span style="font-size: 11px; color: #666;">Purchased: Carbon Black • 1 week ago</span>
        </div>

        <div class="tr-review-card">
          <div class="tr-reviewer-header">
            <span class="tr-reviewer-name">Vikram Malhotra</span>
            <span class="tr-verified-badge">✓ Verified Buyer</span>
          </div>
          <div class="tr-pdp-stars">★★★★★</div>
          <h4 style="color: #fff; margin: 0; font-size: 15px;">Gaming Beast Mode is Real!</h4>
          <p class="tr-review-text">
            45ms low latency makes gaming super responsive. Zero delay in footsteps on BGMI. Fast delivery within 3 days to Bengaluru and solid premium packaging with all accessories included.
          </p>
          <span style="font-size: 11px; color: #666;">Purchased: Steel Blue • 2 weeks ago</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TR PDP Reviews",
  "settings": [],
  "presets": [
    {
      "name": "TR PDP Reviews"
    }
  ]
}
{% endschema %}
