<section class="tr-support-section" id="tr-support-{{ section.id }}" style="padding-top: {{ section.settings.padding_top | default: 20 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;">
  <div class="tr-container">
    {% if section.settings.badge_title != blank %}
      <div class="tr-section-badge-wrap">
        <span class="tr-section-pill">{{ section.settings.badge_title }}</span>
      </div>
    {% endif %}

    <!-- Support Cards -->
    <div class="tr-support-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign support_title = block.settings.title
          assign support_key = support_title | downcase
          assign support_link = block.settings.link | default: '/pages/contact'
          if support_key contains 'instagram'
            assign support_link = 'https://www.instagram.com/grooveslifestyle'
          elsif support_key contains 'youtube'
            assign support_link = 'https://www.youtube.com/@grooveslifestyle'
          elsif support_key contains 'warranty'
            assign support_title = 'Warranty support'
          elsif support_key contains 'replacement'
            assign support_title = 'Replacement support'
          endif
          if block.settings.image != blank
            assign sup_icon = block.settings.image | image_url: width: 120
          else
            assign sup_icon = block.settings.icon_url
          endif
        -%}
        <a href="{{ support_link }}" class="tr-support-card" style="text-decoration: none;" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
          <img src="{{ sup_icon }}" alt="" loading="lazy" width="50" height="50">
          {% else %}
          <svg aria-hidden="true" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:#45a8e8;flex-shrink:0">
            {% if support_key contains "instagram" %}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8"/>
            {% elsif support_key contains "youtube" %}<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3Z"/>
            {% elsif support_key contains "warranty" %}<path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6Z"/><path d="m8 12 3 3 5-6"/>
            {% elsif support_key contains "replacement" %}<path d="M20 7a9 9 0 1 0 1 8M20 2v5h-5"/>
            {% elsif support_key contains "faq" %}<circle cx="12" cy="12" r="9"/><path d="M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4m0 3v1"/>
            {% else %}<path d="M4 13v-1a8 8 0 0 1 16 0v1M4 12H2v7h4v-7Zm16 0h2v7h-4v-7Zm0 7c0 3-4 3-7 3"/>{% endif %}
          </svg>
          {% endif %}
          <h4 class="tr-support-title">{{ support_title }}</h4>
          {% if block.settings.subtitle != blank %}
            <span style="font-size: 11px; color: #888888;">{{ block.settings.subtitle }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>

  <!-- Bottom Policy Strip -->
  {% if section.settings.show_policy_strip %}
    <div class="tr-policy-strip">
      <div class="tr-container">
        <div class="tr-policy-strip-inner">
          <div class="tr-policy-item">
            <span>{{ section.settings.policy_1_icon | default: '🚚' }}</span>
            <span>{{ section.settings.policy_1_text | default: 'Pan India Delivery' }}</span>
          </div>
          <div class="tr-policy-item">
            <span>{{ section.settings.policy_2_icon | default: '🛡️' }}</span>
            <span>{{ section.settings.policy_2_text | default: 'Warranty support' }}</span>
          </div>
          <div class="tr-policy-item">
            <span>{{ section.settings.policy_3_icon | default: '💵' }}</span>
            <span>{{ section.settings.policy_3_text | default: 'COD Available' }}</span>
          </div>
          <div class="tr-policy-item">
            <span>{{ section.settings.policy_4_icon | default: '🔄' }}</span>
            <span>{{ section.settings.policy_4_text | default: 'Replacement support' }}</span>
          </div>
          <div class="tr-policy-item">
            <span>{{ section.settings.policy_5_icon | default: '🔒' }}</span>
            <span>{{ section.settings.policy_5_text | default: '100% Secure Checkout' }}</span>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "TR Support & Policies",
  "settings": [
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
