    },
    {
      "type": "text",
      "id": "policy_2_icon",
      "label": "Policy 2 Icon",
      "default": "🛡️"
    },
    {
      "type": "text",
      "id": "policy_2_text",
      "label": "Policy 2 Text",
      "default": "1 Year Warranty"
    },
    {
      "type": "text",
      "id": "policy_3_icon",
      "label": "Policy 3 Icon",
      "default": "💵"
    },
    {
      "type": "text",
      "id": "policy_3_text",
      "label": "Policy 3 Text",
      "default": "COD Available"
    },
    {
      "type": "text",
      "id": "policy_4_icon",
      "label": "Policy 4 Icon",
      "default": "🔄"
    },
    {
      "type": "text",
      "id": "policy_4_text",
      "label": "Policy 4 Text",
      "default": "7 Days Easy Replacement"
    },
    {
      "type": "text",
      "id": "policy_5_icon",
      "label": "Policy 5 Icon",
      "default": "🔒"
    },
    {
      "type": "text",
      "id": "policy_5_text",
      "label": "Policy 5 Text",
      "default": "100% Secure Checkout"
    }
  ],
  "blocks": [
    {
      "type": "support_item",
      "name": "Support Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Customer Support"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "24/7 Dedicated Help"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon Image (Upload)"
        },
        {
          "type": "text",
          "id": "icon_url",
          "label": "Or Icon Image URL (Fallback)",
          "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/Track-order.png?v=1745498991"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooves Support & Policies",
      "blocks": [
        {
          "type": "support_item",
          "settings": {
            "title": "Customer Support",
            "subtitle": "24/7 Dedicated Help",
