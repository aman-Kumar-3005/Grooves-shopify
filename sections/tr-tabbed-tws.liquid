<section class="tr-tabbed-tws-section" id="tr-tabbed-{{ section.id }}" style="padding-top: {{ section.settings.padding_top | default: 20 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;">
  <div class="tr-container">
    <div class="tr-tabs-header">
      <h2 class="tr-tabs-title">{{ section.settings.section_title | default: 'TWS Earbuds built for seamless sound' }}</h2>
      <div class="tr-tabs-nav">
        {% assign tabs = section.settings.tabs_list | default: "All,ANC / ENC,Translucent,Wireless Charging,Dual Mic,Display Earbuds,Gaming" | split: "," %}
        {% for tab in tabs %}
          <button class="tr-tab-btn {% if forloop.first %}active{% endif %}">{{ tab | strip }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- Earbuds Banner with Open Sound -->
    {%- liquid
      if section.settings.earbuds_image != blank
        assign eb_img = section.settings.earbuds_image | image_url: width: 1600
      else
        assign eb_img = section.settings.earbuds_banner | default: 'https://cdn.shopify.com/s/files/1/0666/4870/3294/files/shopby-life-MUZE.webp?v=1770725159'
      endif
    -%}
    <div class="tr-showcase-banner" style="margin-bottom: 24px;">
      <img 
        src="{{ eb_img }}" 
        alt="{{ section.settings.earbuds_title | default: 'Open Sound Earbuds' }}" 
        class="tr-showcase-img"
        loading="lazy"
        width="1600"
        height="auto"
      >
      <div class="tr-showcase-overlay" style="align-items: flex-start; padding: 40px 60px;">
        <h3 style="color: #000000; font-size: clamp(22px, 3.5vw, 42px); font-weight: 900; margin: 0 0 12px; text-shadow: 0 0 2px #fff;">
          {{ section.settings.earbuds_title | default: 'Open sound that feels<br>Light . Natural . & Easy' }}
        </h3>
        <a href="{{ section.settings.earbuds_link | default: '/collections/all' }}" class="tr-btn tr-btn-accent" style="padding: 10px 28px;">
          {{ section.settings.earbuds_btn | default: 'Shop Now' }}
        </a>
      </div>
    </div>

    <!-- Soundbar / Home Theatre Banner -->
    {%- liquid
      if section.settings.soundbar_image != blank
        assign sb_img = section.settings.soundbar_image | image_url: width: 1600
      else
        assign sb_img = section.settings.soundbar_banner | default: 'https://cdn.shopify.com/s/files/1/0666/4870/3294/files/CARNIwAL_Sphorika_Banner__Desk.webp?v=1781075171'
      endif
    -%}
    <div class="tr-showcase-banner">
      <img 
        src="{{ sb_img }}" 
        alt="{{ section.settings.soundbar_title | default: 'Sphorika Cinematic Sound' }}" 
        class="tr-showcase-img"
        loading="lazy"
        width="1600"
        height="auto"
      >
      <div class="tr-showcase-overlay" style="align-items: flex-end; padding: 40px 60px;">
        {% if section.settings.soundbar_badge != blank %}
          <span style="color: var(--tr-accent); font-weight: 800; font-size: 13px; text-transform: uppercase;">
            {{ section.settings.soundbar_badge }}
          </span>
        {% endif %}
        <h3 style="color: #ffffff; font-size: clamp(20px, 3vw, 36px); font-weight: 900; margin: 6px 0 16px;">
          {{ section.settings.soundbar_title | default: 'Crafted for Cinematic Precision' }}
        </h3>
        <a href="{{ section.settings.soundbar_link | default: '/collections/all' }}" class="tr-btn tr-btn-accent" style="padding: 10px 28px;">
          {{ section.settings.soundbar_btn | default: 'BUY NOW' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TR Tabbed TWS & Soundbar",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Heading",
      "default": "TWS Earbuds built for seamless sound"
    },
    {
      "type": "text",
      "id": "tabs_list",
      "label": "Tabs (Comma-Separated)",
      "default": "All,ANC / ENC,Translucent,Wireless Charging,Dual Mic,Display Earbuds,Gaming"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Earbuds Banner 1"
    },
    {
      "type": "image_picker",
      "id": "earbuds_image",
      "label": "Earbuds Banner Image (Upload)"
    },
    {
      "type": "text",
      "id": "earbuds_banner",
      "label": "Or Earbuds Banner URL (Fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/shopby-life-MUZE.webp?v=1770725159"
    },
    {
      "type": "text",
      "id": "earbuds_title",
      "label": "Banner Title",
      "default": "Open sound that feels Light . Natural . & Easy"
    },
    {
      "type": "text",
      "id": "earbuds_btn",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "earbuds_link",
      "label": "Banner Link"
    },
    {
      "type": "header",
      "content": "Soundbar Banner 2"
    },
    {
      "type": "image_picker",
      "id": "soundbar_image",
      "label": "Soundbar Banner Image (Upload)"
    },
    {
      "type": "text",
      "id": "soundbar_banner",
      "label": "Or Soundbar Banner URL (Fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/CARNIwAL_Sphorika_Banner__Desk.webp?v=1781075171"
    },
    {
      "type": "text",
      "id": "soundbar_badge",
      "label": "Banner Badge Tagline",
      "default": "CINEMATIC SOUND AT HOME"
    },
    {
      "type": "text",
      "id": "soundbar_title",
      "label": "Banner Title",
      "default": "Crafted for Cinematic Precision"
    },
    {
      "type": "text",
      "id": "soundbar_btn",
      "label": "Button Label",
      "default": "BUY NOW"
    },
    {
      "type": "url",
      "id": "soundbar_link",
      "label": "Banner Link"
    }
  ],
  "presets": [
    {
      "name": "TR Tabbed TWS & Soundbar"
    }
  ]
}
{% endschema %}
