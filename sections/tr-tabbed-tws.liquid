<section class="tr-tabbed-tws-section upgrade-audio" id="tr-tabbed-{{ section.id }}"><div class="tr-container"><div class="upgrade-section-head"><div><span class="upgrade-eyebrow">THE AUDIO EDIT</span><h2>{{ section.settings.section_title | escape }}</h2><p>Find the format that fits your everyday listening.</p></div><a class="upgrade-text-link" href="/collections/all">Explore all products ↗</a></div><div class="upgrade-format-tabs" role="tablist" aria-label="Audio formats">{% assign formats = 'earbuds,headphones,neck-band' | split: ',' %}{% for handle in formats %}{% assign col = collections[handle] %}<button type="button" role="tab" id="format-tab-{{ section.id }}-{{ forloop.index }}" aria-controls="format-panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ col.title | escape }}</button>{% endfor %}</div>{% for handle in formats %}{% assign col = collections[handle] %}<div class="upgrade-format-panel" role="tabpanel" id="format-panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="format-tab-{{ section.id }}-{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %}><div class="upgrade-format-intro"><span class="upgrade-eyebrow">EXPLORE {{ col.title | upcase | escape }}</span><h3>Your sound.<br>Your choice.</h3><p>Compare models, available colours and prices in the {{ col.title | downcase | escape }} collection.</p><a class="upgrade-button" href="{{ col.url }}">Shop {{ col.title | escape }} ↗</a></div><div class="upgrade-format-products">{% for product in col.products limit: 3 %}<a class="upgrade-format-product" href="{{ product.url }}">{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '240,360,500', sizes: '(max-width:749px) 42vw, 22vw', alt: product.title }}<span>{{ product.title | escape }}</span><strong>{{ product.price | money }}</strong></a>{% endfor %}</div></div>{% endfor %}</div></section>
{% schema %}
{
  "name": "Grooves Audio & Soundbars",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Heading",
      "default": "Studio Acoustics & Portable Audio"
    },
    {
      "type": "text",
      "id": "tabs_list",
      "label": "Tabs (Comma-Separated)",
      "default": "All,ANC Earbuds,Studio Headphones,Fast Charging,Heavy Bass,Wireless Cases"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Earbuds Banner 1"
    },
    {
      "type": "image_picker",
      "id": "earbuds_image",
      "label": "Earbuds Banner Image (Upload)"
    },
    {
      "type": "text",
      "id": "earbuds_banner",
      "label": "Or Earbuds Banner URL (Fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/shopby-life-MUZE.webp?v=1770725159"
    },
    {
      "type": "text",
      "id": "earbuds_title",
      "label": "Banner Title",
      "default": "Grooves Signature Sound<br>Precision . Power . & Comfort"
    },
    {
      "type": "text",
      "id": "earbuds_btn",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "earbuds_link",
      "label": "Banner Link"
    },
    {
      "type": "header",
      "content": "Soundbar Banner 2"
    },
    {
      "type": "image_picker",
      "id": "soundbar_image",
      "label": "Soundbar Banner Image (Upload)"
    },
    {
      "type": "text",
      "id": "soundbar_banner",
      "label": "Or Soundbar Banner URL (Fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0666/4870/3294/files/CARNIwAL_Sphorika_Banner__Desk.webp?v=1781075171"
    },
    {
      "type": "text",
      "id": "soundbar_badge",
      "label": "Banner Badge Tagline",
      "default": "IMMERSIVE AUDIO EXPERIENCE"
    },
    {
      "type": "text",
      "id": "soundbar_title",
      "label": "Banner Title",
      "default": "Grooves Home Audio & Party Speakers"
    },
    {
      "type": "text",
      "id": "soundbar_btn",
      "label": "Button Label",
      "default": "BUY NOW"
    },
    {
      "type": "url",
      "id": "soundbar_link",
      "label": "Banner Link"
    }
  ],
  "presets": [
    {
      "name": "Grooves Audio & Soundbars"
    }
  ]
}
{% endschema %}
