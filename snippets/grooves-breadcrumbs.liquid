{%- liquid
  assign breadcrumb_title = product.title | default: article.title | default: collection.title | default: page.title | default: blog.title | default: page_title
  assign parent_title = blank
  assign parent_url = blank
  if product != blank
    assign parent_collection = product.metafields.custom.primary_collection.value
    if parent_collection == blank and collection != blank
      assign parent_collection = collection
    endif
    assign parent_title = parent_collection.title | default: 'All products'
    assign parent_url = parent_collection.url | default: routes.all_products_collection_url
  elsif article != blank and blog != blank
    assign parent_title = blog.title
    assign parent_url = blog.url
  endif
-%}
{% if breadcrumb_title != blank %}
<nav class="grooves-breadcrumbs" aria-label="Breadcrumb">
<ol><li><a href="{{ routes.root_url }}">Home</a></li>{% if parent_url != blank %}<li aria-hidden="true">/</li><li><a href="{{ parent_url }}">{{ parent_title | escape }}</a></li>{% endif %}<li aria-hidden="true">/</li><li aria-current="page">{{ breadcrumb_title | escape }}</li></ol>
</nav>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","@id":{{ canonical_url | append: '#breadcrumb' | json }},"itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}},{% if parent_url != blank %}{"@type":"ListItem","position":2,"name":{{ parent_title | json }},"item":{{ request.origin | append: parent_url | json }}},{% endif %}{"@type":"ListItem","position":{% if parent_url != blank %}3{% else %}2{% endif %},"name":{{ breadcrumb_title | json }},"item":{{ canonical_url | json }}}]}</script>
{% endif %}
{% stylesheet %}
.grooves-breadcrumbs{max-width:var(--page-width,1280px);margin:0 auto;padding:12px 24px;font-size:14px;line-height:1.4;overflow:hidden}
.grooves-breadcrumbs ol{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;overflow-wrap:anywhere;margin:0;padding:0;list-style:none}
.grooves-breadcrumbs a{text-decoration:underline;text-underline-offset:2px}
@media screen and (max-width:749px){.grooves-breadcrumbs{padding:10px 16px;font-size:12px}.grooves-breadcrumbs ol{gap:5px}}
{% endstylesheet %}
