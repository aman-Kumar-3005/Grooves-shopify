{%- liquid
  assign breadcrumb_title = product.title | default: collection.title
  assign parent_collection = blank
  if product != blank
    assign parent_collection = product.metafields.custom.primary_collection.value
    if parent_collection == blank and collection != blank
      assign parent_collection = collection
    endif
  endif
-%}
{% if breadcrumb_title != blank %}
<nav class="grooves-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {% if product != blank %}
      <li aria-hidden="true">/</li>
      {% if parent_collection != blank %}<li><a href="{{ parent_collection.url }}">{{ parent_collection.title | escape }}</a></li>{% else %}<li><a href="{{ routes.all_products_collection_url }}">All products</a></li>{% endif %}
    {% endif %}
    <li aria-hidden="true">/</li><li aria-current="page">{{ breadcrumb_title | escape }}</li>
  </ol>
</nav>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","@id":{{ canonical_url | append: '#breadcrumb' | json }},"itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}},
{% if product != blank %}
{"@type":"ListItem","position":2,"name":{% if parent_collection != blank %}{{ parent_collection.title | json }}{% else %}"All products"{% endif %},"item":{% if parent_collection != blank %}{{ request.origin | append: parent_collection.url | json }}{% else %}{{ request.origin | append: routes.all_products_collection_url | json }}{% endif %}},
{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ request.origin | append: product.url | json }}}
{% else %}
{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ request.origin | append: collection.url | json }}}
{% endif %}
]}
</script>
{% endif %}
{% stylesheet %}
.grooves-breadcrumbs{max-width:var(--page-width,1280px);margin:0 auto;padding:12px 24px;font-size:14px;line-height:1.4;overflow:hidden}
.grooves-breadcrumbs ol{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;overflow-wrap:anywhere;margin:0;padding:0;list-style:none}
.grooves-breadcrumbs a{text-decoration:underline;text-underline-offset:2px}
@media screen and (max-width:749px){.grooves-breadcrumbs{padding:10px 16px;font-size:12px}.grooves-breadcrumbs ol{gap:5px}}
{% endstylesheet %}
