{%- liquid
  assign breadcrumb_title = product.title | default: collection.title
  assign breadcrumb_url = product.url | default: collection.url
  assign breadcrumb_home = 'Home'
  assign parent_collection = blank

  if product != blank
    assign parent_collection = product.metafields.custom.primary_collection.value
  endif

  assign parent_title = parent_collection.title | default: collection.title
  assign parent_url = parent_collection.url | default: collection.url
-%}

<nav class="grooves-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ breadcrumb_home }}</a></li>
    {%- if parent_collection != blank -%}
      <li aria-hidden="true">/</li>
      <li><a href="{{ parent_collection.url }}">{{ parent_collection.title | escape }}</a></li>
    {%- elsif collection != blank and collection.handle != blank -%}
      <li aria-hidden="true">/</li>
      <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
    {%- endif -%}
    {%- if breadcrumb_title != blank -%}
      <li aria-hidden="true">/</li>
      <li aria-current="page">{{ breadcrumb_title | escape }}</li>
    {%- endif -%}
  </ol>
</nav>

{%- if breadcrumb_title != blank -%}
  {%- capture breadcrumb_json -%}
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ breadcrumb_home | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        }{% if parent_collection != blank or collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ parent_title | json }},
          "item": {{ request.origin | append: parent_url | json }}
        }{% endif %}{% if product != blank %}{% unless parent_collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ breadcrumb_title | json }},
          "item": {{ request.origin | append: breadcrumb_url | json }}
        }{% endunless %}{% if parent_collection != blank %},
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ breadcrumb_title | json }},
          "item": {{ request.origin | append: breadcrumb_url | json }}
        }{% endif %}{% endif %}
      ]
    }
  {%- endcapture -%}
  <script type="application/ld+json">{{ breadcrumb_json | strip }}</script>
{%- endif -%}

{% stylesheet %}
  .grooves-breadcrumbs {
    max-width: var(--page-width, 1280px);
    margin: 0 auto;
    padding: 12px 24px;
    font-size: 14px;
    line-height: 1.4;
    overflow: hidden;
  }

  .grooves-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    overflow-wrap: anywhere;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grooves-breadcrumbs a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .grooves-breadcrumbs {
      padding: 10px 16px;
      font-size: 12px;
    }

    .grooves-breadcrumbs ol {
      gap: 5px;
    }
  }
{% endstylesheet %}
