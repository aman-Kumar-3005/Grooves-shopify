n:hover{background:#eaf5ff}.gr-share-links :focus-visible{outline:3px solid #1685ce;outline-offset:3px}.gr-share-status{font-size:14px;min-height:22px;margin:12px 0 0}.gr-share-fallback{box-sizing:border-box;max-width:100%;width:100%;padding:12px;border:1px solid #cbd6e3;border-radius:8px}@media(max-width:599px){.gr-share-links>a,.gr-share-links>button{flex:1 1 130px}.gr-blog-tools{margin-bottom:32px}}</style><script>(()=>{const root=document.getElementById('blog-tools-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='1';const stamp=root.querySelector('time');const seconds=Number(stamp.dataset.unix);if(seconds){stamp.textContent=new Intl.DateTimeFormat('en-IN',{timeZone:'Asia/Kolkata',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:true}).format(new Date(seconds*1000))+' IST';}root.querySelector('[data-copy]').addEventListener('click',async()=>{const fallback=root.querySelector('input');const status=root.querySelector('[role=status]');try{await navigator.clipboard.writeText(fallback.value);status.textContent='Link copied';}catch(e){fallback.hidden=false;fallback.focus();fallback.select();status.textContent='Select and copy the link below.'}});})();</script>{% endif %}\n{% if article != blank and blog.articles_count > 1 %}\n<section class=\"gr-read-next\" aria-labelledby=\"gr-read-next-title-{{ section.id }}\">\n<div class=\"gr-read-next__head\"><div><p class=\"gr-read-next__eyebrow\">THE GROOVES JOURNAL</p><h2 id=\"gr-read-next-title-{{ section.id }}\">Keep exploring</h2><p>More buying guides, everyday tips and product help.</p></div><a class=\"gr-read-next__all\" href=\"{{ blog.url }}\">View all guides <span aria-hidden=\"true\">↗</span></a></div>\n<div class=\"gr-read-next__grid\">\n{% for next_post in blog.articles limit: 50 %}{% unless next_post.id == article.id %}\n<article class=\"gr-read-next__card\">\n<a class=\"gr-read-next__image\" href=\"{{ next_post.url }}\" tabindex=\"-1\" aria-hidden=\"true\">{% if next_post.image %}{{ next_post.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(max-width: 599px) calc(100vw - 40px), (max-width: 899px) 45vw, 350px', alt: next_post.image.alt }}{% else %}<span class=\"gr-read-next__placeholder\">Grooves Journal</span>{% endif %}</a>\n<div class=\"gr-read-next__body\"><time datetime=\"{{ next_post.published_at | date: '%Y-%m-%d' }}\">{{ next_post.published_at | date: '%d %b %Y' }}</time><h3><a href=\"{{ next_post.url }}\">{{ next_post.title | escape }}</a></h3><p>{{ next_post.excerpt_or_content | strip_html | truncatewords: 22 }}</p><a class=\"gr-read-next__read\" href=\"{{ next_post.url }}\" aria-label=\"Read {{ next_post.title | escape }}\">Read guide <span aria-hidden=\"true\">↗</span></a></div>\n</article>{% endunless %}{% endfor %}\n</div></section>\n<style>\n.gr-read-next{box-sizing:border-box;max-width:1120px;width:calc(100% - 40px);margin:0 auto 64px;color:#17243d;clear:both}.gr-read-next *{box-sizing:border-box}.gr-read-next__head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:24px}.gr-read-next__eyebrow{font-size:12px!important;font-weight:700;letter-spacing:.16em;color:#51758c;margin:0 0 10px!important}.gr-read-next h2{font-size:clamp(28px,3vw,40px);line-height:1.15;margin:0 0 12px}.gr-read-next__head p{font-size:16px;line-height:1.6;margin:0;color:#52627b}.gr-read-next__all{flex-shrink:0;color:#17243d;font-weight:700;text-underline-offset:5px;padding:12px 0}.gr-read-next__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.gr-read-next__card{min-width:0;background:#fff;border:1px solid #dce4ed;border-radius:18px;overflow:hidden;display:flex;flex-direction:column}.gr-read-next__image{display:block;aspect-ratio:3/2;overflow:hidden;background:#eaf1f7}.gr-read-next__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .2s ease}.gr-read-next__image:hover img{transform:scale(1.025)}.gr-read-next__placeholder{display:flex;height:100%;align-items:center;justify-content:center;font-size:24px;color:#17243d}.gr-read-next__body{padding:22px;display:flex;flex-direction:column;flex:1}.gr-read-next time{font-size:13px;line-height:1.5;color:#61718a}.gr-read-next h3{font-size:21px;line-height:1.35;margin:12px 0;text-transform:none;letter-spacing:-.02em}.gr-read-next h3 a{color:#17243d;text-decoration:none}.gr-read-next__body>p{font-size:15px;line-height:1.7;color:#52627b;margin:0 0 20px}.gr-read-next__read{margin-top:auto;display:inline-flex;align-items:center;gap:8px;min-height:44px;color:#17243d;font-size:15px;font-weight:700;text-decoration:none}.gr-read-next a:focus-visible{outline:3px solid #1685ce;outline-offset:3px}.gr-read-next h3 a:hover,.gr-read-next__read:hover{text-decoration:underline;text-underline-offset:4px}@media(max-width:899px){.gr-read-next__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}@media(max-width:599px){.gr-read-next{margin-bottom:40px}.gr-read-next__head{display:block}.gr-read-next__all{display:inline-block;margin-top:12px}.gr-read-next__grid{grid-template-columns:1fr;gap:20px}.gr-read-next__body{padding:20px}.gr-read-next h3{font-size:20px}}@media(prefers-reduced-motion:reduce){.gr-read-next__image img{transition:none}}\n</style>{% endif %}",
