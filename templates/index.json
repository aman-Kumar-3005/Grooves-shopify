    "custom_liquid_a7hyWx": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"gm\" id=\"grooves-near-you\" aria-labelledby=\"gm-title\"><div class=\"gm-wrap\"><header class=\"gm-head\"><div><p class=\"gm-kicker\">GROOVES, YOUR WAY</p><h2 id=\"gm-title\">Need it sooner?<br><span>Find your Grooves nearby.</span></h2><p>Explore selected Grooves products on Blinkit and Flipkart. Open a listing and set your delivery location to check what is available near you.</p></div><a class=\"gm-direct\" href=\"/collections/all\">Shop directly with Grooves ↗</a></header><div class=\"gm-steps\"><span><b>01</b> Choose your product</span><span><b>02</b> Open your preferred platform</span><span><b>03</b> Check your location & delivery</span></div><div class=\"gm-grid\"><article class=\"gm-card\"><div class=\"gm-photo\"><span class=\"gm-badge gm-blink\">Blinkit</span><img src=\"https://cdn.grofers.com/cdn-cgi/image/f=auto,fit=scale-down,q=85,metadata=none,w=480,h=480/da/cms-assets/cms/product/rc-upload-1784323342663-71.jpg\" width=\"440\" height=\"440\" loading=\"lazy\" alt=\"Grooves 65W SuperVOOC\"></div><div class=\"gm-copy\"><h3>Grooves 65W SuperVOOC</h3><p>Adapter with cable</p><a class=\"gm-buy gm-blink\" href=\"https://blinkit.com/prn/x/prid/646836\" target=\"_blank\" rel=\"noopener noreferrer\" data-gm-platform=\"Blinkit\" data-gm-product=\"Grooves 65W SuperVOOC\" aria-label=\"Check Grooves 65W SuperVOOC on Blinkit (opens in a new tab)\">Check on Blinkit <span aria-hidden=\"true\">↗</span></a></div></article><article class=\"gm-card\"><div class=\"gm-photo\"><span class=\"gm-badge gm-blink\">Blinkit</span><img src=\"https://cdn.grofers.com/cdn-cgi/image/f=auto,fit=scale-down,q=85,metadata=none,w=480,h=480/da/cms-assets/cms/product/7a1af972e96146f8b019374394a0c17a.jpg\" width=\"440\" height=\"440\" loading=\"lazy\" alt=\"Grooves Nirvana\"></div><div class=\"gm-copy\"><h3>Grooves Nirvana</h3><p>Black TWS earbuds</p><a class=\"gm-buy gm-blink\" href=\"https://blinkit.com/prn/x/prid/1371076\" target=\"_blank\" rel=\"noopener noreferrer\" data-gm-platform=\"Blinkit\" data-gm-product=\"Grooves Nirvana\" aria-label=\"Check Grooves Nirvana on Blinkit (opens in a new tab)\">Check on Blinkit <span aria-hidden=\"true\">↗</span></a></div></article><article class=\"gm-card\"><div class=\"gm-photo\"><span class=\"gm-badge gm-flip\">Flipkart</span>{% assign gm_product = all_products['grooves-ultra-earbuds'] %}{% if gm_product.featured_image %}<img src=\"{{ gm_product.featured_image | image_url: width: 440 }}\" width=\"440\" height=\"440\" loading=\"lazy\" alt=\"Grooves Ultra\">{% endif %}</div><div class=\"gm-copy\"><h3><a class=\"gm-model\" href=\"/products/grooves-ultra-earbuds\">Grooves Ultra</a></h3><p>TWS earbuds with charging case</p><a class=\"gm-buy gm-flip\" href=\"https://www.flipkart.com/grooves-ultra-tws-true-wireless-bluetooth-earbuds-mic-charging-case/p/itm8608e6d532ff3?pid=ACCHSG8HUTMCHFMM\" target=\"_blank\" rel=\"noopener noreferrer\" data-gm-platform=\"Flipkart\" data-gm-product=\"Grooves Ultra\" aria-label=\"Check Grooves Ultra on Flipkart (opens in a new tab)\">Check on Flipkart <span aria-hidden=\"true\">↗</span></a></div></article><article class=\"gm-card\"><div class=\"gm-photo\"><span class=\"gm-badge gm-flip\">Flipkart</span>{% assign gm_product = all_products['grooves-fire-earuds'] %}{% if gm_product.featured_image %}<img src=\"{{ gm_product.featured_image | image_url: width: 440 }}\" width=\"440\" height=\"440\" loading=\"lazy\" alt=\"Grooves Fire\">{% endif %}</div><div class=\"gm-copy\"><h3><a class=\"gm-model\" href=\"/products/grooves-fire-earuds\">Grooves Fire</a></h3><p>TWS earbuds with charging case</p><a class=\"gm-buy gm-flip\" href=\"https://www.flipkart.com/grooves-fire-tws-true-wireless-bluetooth-earbuds-mic-charging-case/p/itm1e47bf60e8c56?pid=ACCHSG88SM9BARVR\" target=\"_blank\" rel=\"noopener noreferrer\" data-gm-platform=\"Flipkart\" data-gm-product=\"Grooves Fire\" aria-label=\"Check Grooves Fire on Flipkart (opens in a new tab)\">Check on Flipkart <span aria-hidden=\"true\">↗</span></a></div></article><article class=\"gm-card\"><div class=\"gm-photo\"><span class=\"gm-badge gm-flip\">Flipkart</span>{% assign gm_product = all_products['grooves-vibe-2-0'] %}{% if gm_product.featured_image %}<img src=\"{{ gm_product.featured_image | image_url: width: 440 }}\" width=\"440\" height=\"440\" loading=\"lazy\" alt=\"Grooves Vibe 2.0\">{% endif %}</div><div class=\"gm-copy\"><h3><a class=\"gm-model\" href=\"/products/grooves-vibe-2-0\">Grooves Vibe 2.0</a></h3><p>Truly wireless earbuds</p><a class=\"gm-buy gm-flip\" href=\"https://www.flipkart.com/grooves-vibe2-0-truly-wireless-earbuds-13mm-drivers-30-hour-playtime-bluetooth/p/itm0457e72989848?pid=ACCHPCRHAB3ZFZZH\" target=\"_blank\" rel=\"noopener noreferrer\" data-gm-platform=\"Flipkart\" data-gm-product=\"Grooves Vibe 2.0\" aria-label=\"Check Grooves Vibe 2.0 on Flipkart (opens in a new tab)\">Check on Flipkart <span aria-hidden=\"true\">↗</span></a></div></article><article class=\"gm-card\"><div class=\"gm-photo\"><span class=\"gm-badge gm-flip\">Flipkart</span><img src=\"https://rukminim2.flixcart.com/image/1600/2140/xif0q/headphone/6/i/0/crystal-truly-wireless-earbuds-with-13mm-drivers-30-hour-original-imahpbqnygwasumg.jpeg?q=60\" width=\"440\" height=\"440\" loading=\"lazy\" alt=\"Grooves Crystal\"></div><div class=\"gm-copy\"><h3>Grooves Crystal</h3><p>Truly wireless earbuds</p><a class=\"gm-buy gm-flip\" href=\"https://www.flipkart.com/grooves-crystal-truly-wireless-earbuds-13mm-drivers-30-hour-playtime-bluetooth/p/itm12f5ae6186a2a?pid=ACCHPBQNHR9G7BZJ\" target=\"_blank\" rel=\"noopener noreferrer\" data-gm-platform=\"Flipkart\" data-gm-product=\"Grooves Crystal\" aria-label=\"Check Grooves Crystal on Flipkart (opens in a new tab)\">Check on Flipkart <span aria-hidden=\"true\">↗</span></a></div></article></div><p class=\"gm-note\">Availability, price, delivery time, seller and purchase terms are shown by the selected platform for your location. Listings open in a new tab. Grooves does not guarantee local stock or a delivery time.</p><aside class=\"gm-refs\" aria-labelledby=\"gm-reference-title\"><p class=\"gm-kicker\">COMPARE BEFORE YOU CHOOSE</p><h3 id=\"gm-reference-title\">Product information & buying guides</h3><div class=\"gm-ref-grid\"><p>Choosing wireless audio? Browse <a href=\"/collections/earbuds\">Grooves TWS earbuds</a> and read our <a href=\"/blogs/news/anc-vs-enc-earbuds-music-calls\">ANC vs ENC guide for music and calls</a> to understand which model details to compare.</p><p>Shopping for a charger? Compare <a href=\"/collections/adaptor\">Grooves charging adapters</a> and use our <a href=\"/blogs/news/usb-c-pd-vs-supervooc-charger-cable-compatibility\">USB-C PD and SuperVOOC compatibility guide</a> before choosing an adapter and cable.</p></div><p class=\"gm-reference-note\">The Blinkit and Flipkart product links above are external listing references. Check the exact model, colour, package contents, seller, local availability and platform purchase terms before ordering. For a purchase on this website, read <a href=\"/policies/shipping-policy\">Grooves shipping information</a> and <a href=\"/policies/refund-policy\">Grooves refund policy</a>. Need help? <a href=\"/pages/contact\">Ask the Grooves support team</a>.</p></aside><div class=\"gm-help\"><div><p class=\"gm-kicker\">LET’S FIND YOUR FIT</p><h3>Not sure which one to choose?</h3><p>Tell us your device, preferred product and delivery PIN code. Our team can help with product selection and shopping options.</p><a href=\"/pages/contact\">Contact Grooves →</a></div><details class=\"gm-enquiry\"><summary>Ask Grooves for buying help <span>+</span></summary>{% form 'contact', id: 'GroovesMarketplaceHelp' %}{% if form.posted_successfully? %}<p role=\"status\">Thank you. Your enquiry has been sent to Grooves.</p>{% else %}{{ form.errors | default_errors }}<input type=\"hidden\" name=\"contact[Source]\" value=\"Homepage marketplace buying help\"><label for=\"gm-name\">Name</label><input id=\"gm-name\" name=\"contact[name]\" autocomplete=\"name\" required maxlength=\"100\"><label for=\"gm-email\">Email</label><input id=\"gm-email\" type=\"email\" name=\"contact[email]\" autocomplete=\"email\" required><label for=\"gm-pin\">Delivery PIN code</label><input id=\"gm-pin\" name=\"contact[Delivery PIN code]\" inputmode=\"numeric\" pattern=\"[1-9][0-9]{5}\" maxlength=\"6\" autocomplete=\"postal-code\" required><label for=\"gm-message\">Product / device and your question</label><textarea id=\"gm-message\" name=\"contact[body]\" rows=\"3\" maxlength=\"2000\" required placeholder=\"For example: earbuds for my phone, or help choosing a compatible charger\"></textarea><label class=\"gm-consent\"><input type=\"checkbox\" required> I agree to be contacted about this enquiry. <a href=\"/policies/privacy-policy\">Privacy policy</a></label><button type=\"submit\">Send enquiry to Grooves →</button><small>This sends an enquiry, not an order. It does not subscribe you to marketing.</small>{% endif %}{% endform %}</details></div></div></section><style>.gm{background:#f4f7fb;color:#17243c;padding:64px 24px}.gm *{box-sizing:border-box}.gm-wrap{max-width:1320px;margin:auto}.gm-head{display:flex;align-items:center;justify-content:space-between;gap:32px}.gm-kicker{font-size:12px!important;font-weight:800;letter-spacing:.15em;color:#34648a;margin:0 0 14px}.gm h2{font-size:clamp(30px,3.5vw,48px);line-height:1.12;letter-spacing:-.035em;margin:0 0 18px}.gm h2 span{color:#428ac4}.gm-head p:not(.gm-kicker){max-width:680px;line-height:1.65;font-size:15px}.gm-direct{flex-shrink:0;background:#17243c;color:#fff;padding:15px 20px;border-radius:30px;font-size:14px;font-weight:700;text-decoration:none}.gm-steps{display:flex;justify-content:space-between;gap:18px;margin:28px 0;font-size:13px;border-top:1px solid #dce4ec;border-bottom:1px solid #dce4ec;padding:17px 0}.gm-steps b{color:#428ac4;margin-right:8px}.gm-grid{display:grid;grid-template-columns:repeat(3,m